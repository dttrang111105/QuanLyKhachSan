@model IEnumerable<QuanLyKhachSan.Models.RoomType>
@using QuanLyKhachSan.Models
@{
    bool isAdmin = User.IsInRole("Admin");
    bool isReceptionist = User.IsInRole("Receptionist");
    Layout = isAdmin
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";
    ViewData["Title"] = isAdmin ? "Quản lý loại phòng" : "Danh sách loại phòng";

    var roomTypes = Model?.ToList() ?? new List<RoomType>();
    int totalRoomTypes = roomTypes.Count;
    int totalRooms = roomTypes.Sum(rt => rt.Rooms?.Count(r => !r.IsDeleted) ?? 0);
    decimal averagePrice = roomTypes.Any() ? roomTypes.Average(rt => rt.BasePrice) : 0;
    double averageOccupancy = roomTypes.Any() ? roomTypes.Average(rt => Convert.ToDouble(rt.MaxOccupancy)) : 0;
    var bedTypes = roomTypes.Where(rt => !string.IsNullOrWhiteSpace(rt.BedType)).Select(rt => rt.BedType!).Distinct().OrderBy(b => b).ToList();

    int ActiveRoomCount(RoomType rt) => rt.Rooms?.Count(r => !r.IsDeleted) ?? 0;
}

<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-2 text-xs font-bold text-secondary uppercase tracking-wider mb-1">
            <span>Quản Lý Hệ Thống</span>
            <span class="text-slate-400">/</span>
            <span class="text-on-surface">Cấu Hình Hạng Phòng</span>
        </div>
        <h1 class="text-2xl lg:text-3xl font-bold text-on-surface font-serif tracking-tight">@(isAdmin ? "Quản Lý Hạng Phòng" : "Danh Sách Hạng Phòng")</h1>
        <p class="text-xs text-slate-500 mt-1">Cấu hình biểu giá cơ bản, tiêu chuẩn giường ngủ, diện tích và sức chứa buồng phòng.</p>
    </div>
    <div class="flex items-center gap-2">
        <a asp-controller="Rooms" asp-action="Index"
           class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold shadow-sm transition-all">
            <span class="material-symbols-outlined text-[18px]">meeting_room</span>
            <span>Danh Sách Phòng</span>
        </a>
        @if (isAdmin)
        {
            <a asp-controller="RoomTypes" asp-action="Create"
               class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-primary-container text-white text-xs font-bold shadow-sm hover:opacity-90 transition-all">
                <span class="material-symbols-outlined text-[18px] text-secondary-fixed">add_circle</span>
                <span>+ Thêm Hạng Phòng</span>
            </a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="p-3.5 mb-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs flex items-center gap-2">
        <span class="material-symbols-outlined text-[18px]">check_circle</span>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="p-3.5 mb-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center gap-2">
        <span class="material-symbols-outlined text-[18px]">error</span>
        <span>@TempData["Error"]</span>
    </div>
}

<!-- 4 Thẻ Thống Kê Nhanh -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-[11px] font-bold text-slate-500 uppercase">Tổng Hạng Phòng</span>
            <div class="text-2xl font-bold text-on-surface mt-1">@totalRoomTypes</div>
            <span class="text-[10px] text-slate-400">Danh mục cấu hình</span>
        </div>
        <span class="material-symbols-outlined text-2xl text-blue-500">king_bed</span>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-[11px] font-bold text-slate-500 uppercase">Tổng Số Phòng</span>
            <div class="text-2xl font-bold text-emerald-600 mt-1">@totalRooms</div>
            <span class="text-[10px] text-slate-400">Phòng thuộc các hạng</span>
        </div>
        <span class="material-symbols-outlined text-2xl text-emerald-500">hotel</span>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-[11px] font-bold text-slate-500 uppercase">Giá Bình Quân</span>
            <div class="text-xl font-bold text-secondary mt-1">@averagePrice.ToString("N0") <small class="text-xs text-slate-400">đ</small></div>
            <span class="text-[10px] text-slate-400">Biểu giá cơ sở</span>
        </div>
        <span class="material-symbols-outlined text-2xl text-amber-500">payments</span>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-[11px] font-bold text-slate-500 uppercase">Sức Chứa TB</span>
            <div class="text-2xl font-bold text-purple-600 mt-1">@averageOccupancy.ToString("0.0")</div>
            <span class="text-[10px] text-slate-400">Khách / mỗi phòng</span>
        </div>
        <span class="material-symbols-outlined text-2xl text-purple-500">group</span>
    </div>
</div>

<!-- Bảng Danh Sách Hạng Phòng -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div>
            <span class="text-xs font-bold text-secondary uppercase tracking-wider">Danh mục hạng phòng</span>
            <h2 class="text-base font-bold text-on-surface">Tất Cả Loại Phòng (@totalRoomTypes)</h2>
        </div>
        <div class="flex items-center gap-2">
            <div class="relative">
                <input type="text" id="roomTypeSearch" placeholder="Tìm tên hạng phòng..."
                       class="h-9 pl-8 pr-3 bg-slate-50 border border-slate-200 text-xs rounded-xl focus:outline-none focus:bg-white focus:border-secondary w-52 transition-all" />
                <span class="material-symbols-outlined text-[16px] text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2">search</span>
            </div>
            <select id="bedTypeFilter"
                    class="h-9 px-3 bg-slate-50 border border-slate-200 text-xs rounded-xl focus:outline-none focus:bg-white focus:border-secondary transition-all">
                <option value="">Tất cả loại giường</option>
                @foreach (var bt in bedTypes)
                {
                    <option value="@bt">@bt</option>
                }
            </select>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 font-semibold uppercase text-[10px] tracking-wider border-b border-slate-200/60">
                <tr>
                    <th class="py-3 px-4">Loại Phòng</th>
                    <th class="py-3 px-4">Giá Cơ Bản</th>
                    <th class="py-3 px-4">Sức Chứa</th>
                    <th class="py-3 px-4">Loại Giường</th>
                    <th class="py-3 px-4">Diện Tích</th>
                    <th class="py-3 px-4">Số Buồng</th>
                    <th class="py-3 px-4">Mô Tả</th>
                    <th class="py-3 px-4 text-right">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                @if (roomTypes.Any())
                {
                    foreach (var rt in roomTypes)
                    {
                        int count = ActiveRoomCount(rt);
                        string searchText = $"{rt.Name} {rt.BedType} {rt.Description}".ToLower();

                        <tr class="hover:bg-slate-50/80 transition-colors room-type-row"
                            data-bed-type="@rt.BedType" data-search="@searchText">
                            <td class="py-3 px-4 font-bold text-on-surface">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-xl bg-amber-50 text-secondary flex items-center justify-center font-bold">
                                        <span class="material-symbols-outlined text-[18px]">bed</span>
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-900">@rt.Name</div>
                                        <div class="text-[10px] text-slate-400">#RT-@rt.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 px-4 font-bold text-secondary">
                                @rt.BasePrice.ToString("N0") <small class="text-slate-400 font-normal">đ/đêm</small>
                            </td>
                            <td class="py-3 px-4">@rt.MaxOccupancy khách</td>
                            <td class="py-3 px-4 text-slate-600">@(string.IsNullOrWhiteSpace(rt.BedType) ? "—" : rt.BedType)</td>
                            <td class="py-3 px-4">@rt.Area m²</td>
                            <td class="py-3 px-4">
                                <span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-[10px] font-bold">
                                    @count phòng
                                </span>
                            </td>
                            <td class="py-3 px-4 text-slate-500 max-w-xs truncate" title="@rt.Description">
                                @(string.IsNullOrWhiteSpace(rt.Description) ? "Chưa có mô tả" : rt.Description)
                            </td>
                            <td class="py-3 px-4 text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    <a asp-controller="RoomTypes" asp-action="Details" asp-route-id="@rt.Id"
                                       class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 transition-colors" title="Xem chi tiết">
                                        <span class="material-symbols-outlined text-[16px]">visibility</span>
                                    </a>
                                    @if (isAdmin)
                                    {
                                        <a asp-controller="RoomTypes" asp-action="Edit" asp-route-id="@rt.Id"
                                           class="p-1.5 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 transition-colors" title="Chỉnh sửa">
                                            <span class="material-symbols-outlined text-[16px]">edit</span>
                                        </a>
                                        <a asp-controller="RoomTypes" asp-action="Delete" asp-route-id="@rt.Id"
                                           class="p-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 transition-colors" title="Xóa">
                                            <span class="material-symbols-outlined text-[16px]">delete</span>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-10 text-slate-400">
                            <span class="material-symbols-outlined text-4xl mb-1 text-slate-300">king_bed</span>
                            <div>Chưa có loại phòng nào trong hệ thống</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("roomTypeSearch");
        const bedTypeFilter = document.getElementById("bedTypeFilter");
        const rows = document.querySelectorAll(".room-type-row");

        function filterRows() {
            const query = (searchInput?.value || "").trim().toLowerCase();
            const bed = (bedTypeFilter?.value || "").trim();

            rows.forEach(row => {
                const searchData = row.getAttribute("data-search") || "";
                const bedData = row.getAttribute("data-bed-type") || "";
                const matchesSearch = !query || searchData.includes(query);
                const matchesBed = !bed || bedData === bed;

                row.style.display = (matchesSearch && matchesBed) ? "" : "none";
            });
        }

        searchInput?.addEventListener("input", filterRows);
        bedTypeFilter?.addEventListener("change", filterRows);
    });
</script>