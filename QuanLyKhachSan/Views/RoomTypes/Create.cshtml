@model QuanLyKhachSan.Models.RoomType
@{
    Layout = User.IsInRole("Admin")
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";
    ViewData["Title"] = "Thêm loại phòng";
}

<div class="max-w-4xl mx-auto py-4">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold text-secondary uppercase tracking-wider mb-1">
                <span>Quản Lý Hệ Thống</span>
                <span class="text-slate-400">/</span>
                <a asp-action="Index" class="text-slate-600 hover:text-secondary">Hạng Phòng</a>
                <span class="text-slate-400">/</span>
                <span class="text-on-surface">Thêm mới</span>
            </div>
            <h1 class="text-2xl font-bold font-serif text-on-surface">Thêm Hạng Phòng Mới</h1>
            <p class="text-xs text-slate-500 mt-0.5">Tạo danh mục phân loại buồng phòng, tiện nghi và biểu giá cơ sở</p>
        </div>
        <a asp-action="Index"
           class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold shadow-sm transition-all">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>Quay lại</span>
        </a>
    </div>

    <!-- Form Container -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center gap-3 bg-slate-50/50">
            <div class="w-10 h-10 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-[20px]">king_bed</span>
            </div>
            <div>
                <h2 class="text-sm font-bold text-on-surface">Thông Số Tiêu Chuẩn Hạng Phòng</h2>
                <p class="text-xs text-slate-500">Các trường có dấu (*) là thông tin bắt buộc</p>
            </div>
        </div>

        <form asp-controller="RoomTypes" asp-action="Create" method="post" class="p-6 sm:p-8 space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-rose-600 text-xs font-semibold"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="Name" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Tên hạng phòng <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="Name" placeholder="Ví dụ: Deluxe Ocean View"
                           class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all font-semibold" />
                    <span asp-validation-for="Name" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="BasePrice" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Giá cơ bản (VNĐ/đêm) <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="BasePrice" type="number" min="0" step="10000" placeholder="Ví dụ: 1500000"
                           class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all font-semibold" />
                    <span asp-validation-for="BasePrice" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="MaxOccupancy" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Sức chứa tối đa (người) <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="MaxOccupancy" type="number" min="1" max="20" placeholder="Ví dụ: 2"
                           class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                    <span asp-validation-for="MaxOccupancy" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="BedType" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Loại giường <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="BedType" placeholder="Ví dụ: 1 King Bed / 2 Twin Beds"
                           class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                    <span asp-validation-for="BedType" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Area" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Diện tích phòng (m²) <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="Area" type="number" min="1" step="0.1" placeholder="Ví dụ: 45.0"
                           class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                    <span asp-validation-for="Area" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Description" class="block text-xs font-bold text-slate-700 mb-1.5">Mô tả loại phòng</label>
                    <textarea asp-for="Description" rows="4" placeholder="Mô tả không gian, tầm nhìn, tiện nghi cao cấp..."
                              class="w-full p-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all"></textarea>
                    <span asp-validation-for="Description" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
                <a asp-action="Index"
                   class="px-5 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all">
                    Hủy bỏ
                </a>
                <button type="submit"
                        class="px-6 py-2.5 rounded-xl bg-primary-container hover:bg-slate-800 text-white text-xs font-bold shadow-md transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px] text-secondary-fixed">add_circle</span>
                    <span>Thêm Hạng Phòng</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}