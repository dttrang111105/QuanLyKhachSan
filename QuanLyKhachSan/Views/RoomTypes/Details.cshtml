@model QuanLyKhachSan.Models.RoomType
@{
    Layout = User.IsInRole("Admin")
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";
    ViewData["Title"] = "Chi tiết loại phòng";
    var activeRooms = Model.Rooms?
        .Where(room => !room.IsDeleted)
        .OrderBy(room => room.RoomNumber)
        .ToList()
        ?? new List<QuanLyKhachSan.Models.Room>();
}

<div class="max-w-4xl mx-auto py-4">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold text-secondary uppercase tracking-wider mb-1">
                <span>Quản Lý Hệ Thống</span>
                <span class="text-slate-400">/</span>
                <a asp-action="Index" class="text-slate-600 hover:text-secondary">Hạng Phòng</a>
                <span class="text-slate-400">/</span>
                <span class="text-on-surface">Chi tiết</span>
            </div>
            <h1 class="text-2xl font-bold font-serif text-on-surface">Hạng Phòng: @Model.Name</h1>
            <p class="text-xs text-slate-500 mt-0.5">Thông tin chi tiết thông số, biểu phí và các phòng trực thuộc</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Index"
               class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold shadow-sm transition-all">
                <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                <span>Quay lại</span>
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-secondary text-white hover:bg-secondary/90 text-xs font-bold shadow-sm transition-all">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    <span>Chỉnh sửa</span>
                </a>
            }
        </div>
    </div>

    <!-- Main Card -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden mb-6">
        <!-- 3 Cột Thống Kê Chính -->
        <div class="p-6 sm:p-8 bg-slate-50/50 border-b border-slate-100 grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-xs">
                <div class="flex items-center gap-2 text-xs font-bold text-secondary uppercase mb-1">
                    <span class="material-symbols-outlined text-[18px]">payments</span>
                    <span>Giá Cơ Bản</span>
                </div>
                <div class="text-xl font-bold text-secondary">@Model.BasePrice.ToString("N0") <small class="text-xs text-slate-400">VNĐ/đêm</small></div>
            </div>

            <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-xs">
                <div class="flex items-center gap-2 text-xs font-bold text-purple-700 uppercase mb-1">
                    <span class="material-symbols-outlined text-[18px]">group</span>
                    <span>Sức Chứa Tối Đa</span>
                </div>
                <div class="text-xl font-bold text-on-surface">@Model.MaxOccupancy người</div>
            </div>

            <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-xs">
                <div class="flex items-center gap-2 text-xs font-bold text-emerald-700 uppercase mb-1">
                    <span class="material-symbols-outlined text-[18px]">aspect_ratio</span>
                    <span>Diện Tích Chuẩn</span>
                </div>
                <div class="text-xl font-bold text-on-surface">@Model.Area m²</div>
            </div>
        </div>

        <div class="p-6 sm:p-8 space-y-6">
            <!-- Thông số kỹ thuật -->
            <div>
                <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Thông Số Kỹ Thuật</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                    <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                        <span class="text-slate-500 font-medium">Loại giường:</span>
                        <span class="font-bold text-on-surface">@(string.IsNullOrWhiteSpace(Model.BedType) ? "Chưa cập nhật" : Model.BedType)</span>
                    </div>
                    <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                        <span class="text-slate-500 font-medium">Tổng buồng phòng thuộc hạng:</span>
                        <span class="font-bold text-blue-700">@activeRooms.Count phòng</span>
                    </div>
                    <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                        <span class="text-slate-500 font-medium">Ngày khởi tạo:</span>
                        <span class="font-semibold text-slate-700">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                        <span class="text-slate-500 font-medium">Cập nhật lần cuối:</span>
                        <span class="font-semibold text-slate-700">@(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "—")</span>
                    </div>
                </div>
            </div>

            <!-- Mô tả -->
            <div>
                <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Mô Tả Hạng Phòng</h2>
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 text-xs text-slate-600 leading-relaxed">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả chi tiết cho loại phòng này." : Model.Description)
                </div>
            </div>

            <!-- Danh sách phòng thuộc loại -->
            <div>
                <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Danh Sách Buồng Phòng Trực Thuộc (@activeRooms.Count)</h2>
                @if (activeRooms.Any())
                {
                    <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3">
                        @foreach (var room in activeRooms)
                        {
                            <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id"
                               class="p-3 rounded-xl border border-slate-200 hover:border-secondary/40 hover:bg-slate-50 transition-all text-center group">
                                <span class="material-symbols-outlined text-[20px] text-slate-400 group-hover:text-secondary block mb-1">door_front</span>
                                <div class="text-xs font-bold text-on-surface">P.@room.RoomNumber</div>
                                <div class="text-[10px] text-slate-400">Tầng @room.Floor</div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/60 text-center text-slate-400 text-xs">
                        <span class="material-symbols-outlined text-3xl mb-1 text-slate-300">meeting_room</span>
                        <div>Chưa có phòng nào được gán cho loại phòng này</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
