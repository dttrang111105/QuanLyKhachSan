@model QuanLyKhachSan.Models.RoomType
@{
    Layout = User.IsInRole("Admin")
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";
    ViewData["Title"] = "Xóa loại phòng";
}

<div class="max-w-2xl mx-auto py-6">
    <div class="bg-white rounded-3xl border border-rose-200 shadow-lg overflow-hidden">
        <div class="p-6 bg-rose-50/70 border-b border-rose-100 flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-700 flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-[24px]">warning</span>
            </div>
            <div>
                <h1 class="text-lg font-bold font-serif text-rose-900">Xác Nhận Xóa Hạng Phòng</h1>
                <p class="text-xs text-rose-700 mt-0.5">Bạn có chắc chắn muốn xóa hạng phòng này khỏi danh mục quản lý?</p>
            </div>
        </div>

        <div class="p-6 sm:p-8 space-y-4">
            <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 space-y-2 text-xs">
                <div class="flex justify-between py-1 border-b border-slate-200/60">
                    <span class="text-slate-500 font-medium">Tên hạng phòng:</span>
                    <span class="font-bold text-on-surface">@Model.Name</span>
                </div>
                <div class="flex justify-between py-1 border-b border-slate-200/60">
                    <span class="text-slate-500 font-medium">Giá cơ bản:</span>
                    <span class="font-bold text-secondary">@Model.BasePrice.ToString("N0") VNĐ/đêm</span>
                </div>
                <div class="flex justify-between py-1 border-b border-slate-200/60">
                    <span class="text-slate-500 font-medium">Sức chứa / Diện tích:</span>
                    <span class="font-semibold text-slate-800">@Model.MaxOccupancy người • @Model.Area m²</span>
                </div>
                <div class="flex justify-between py-1">
                    <span class="text-slate-500 font-medium">Loại giường:</span>
                    <span class="font-semibold text-slate-800">@(string.IsNullOrWhiteSpace(Model.BedType) ? "Chưa cập nhật" : Model.BedType)</span>
                </div>
            </div>

            <p class="text-xs text-slate-500">
                <strong class="text-rose-600">Lưu ý:</strong> Xóa loại phòng sẽ làm ảnh hưởng đến các phòng đang được phân loại theo hạng này.
            </p>

            <form asp-action="Delete" method="post" class="pt-4 flex items-center justify-end gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index"
                   class="px-5 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all">
                    Hủy bỏ
                </a>
                <button type="submit"
                        class="px-6 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold shadow-md transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">delete_forever</span>
                    <span>Xác Nhận Xóa</span>
                </button>
            </form>
        </div>
    </div>
</div>
