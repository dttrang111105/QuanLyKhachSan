@using System.Globalization
@model QuanLyKhachSan.ViewModels.ReportViewModel

@{
    ViewData["Title"] = "Báo cáo Doanh thu & Công suất";
    Layout = "_AdminLayout";

    decimal maxRevenue = Model.RevenueRows.Any() ? Model.RevenueRows.Max(x => x.Revenue) : 0;
    decimal maxInvoiceCategory = Model.InvoiceCategories.Any() ? Model.InvoiceCategories.Max(x => x.Amount) : 0;
    int maxBookingStatus = Model.BookingStatuses.Any() ? Model.BookingStatuses.Max(x => x.Count) : 0;

    string Percent(decimal value, decimal max)
    {
        if (max <= 0 || value <= 0) return "0";
        decimal percent = value / max * 100m;
        return percent.ToString("0.##", CultureInfo.InvariantCulture);
    }
}

<div class="space-y-6">
    <!-- Header: Title & Actions -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
                <span class="material-symbols-outlined text-[16px]">monitoring</span>
                <span>Tài chính &amp; Vận hành</span>
            </div>
            <div class="flex items-baseline gap-2 mt-1">
                <h1 class="font-serif text-2xl sm:text-3xl font-bold text-on-surface">Báo Cáo Doanh Thu &amp; Công Suất</h1>
                <span class="px-2.5 py-0.5 rounded-full bg-secondary-container text-secondary text-[11px] font-bold uppercase">
                    Kỳ: @Model.PeriodText
                </span>
            </div>
            <p class="text-xs text-on-surface-variant mt-1">
                Phân tích chuyên sâu hiệu suất tài chính RevPAR, ADR, tỷ lệ lấp đầy phòng và cơ cấu dòng tiền đa kênh PMS.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="ExportExcel"
               asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
               asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"
               asp-route-groupBy="@Model.GroupBy"
               class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-primary text-white hover:bg-on-background text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[18px]">download</span>
                <span>Xuất Báo Cáo Excel</span>
            </a>
        </div>
    </header>

    @if (TempData["Error"] != null)
    {
        <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center gap-2">
            <span class="material-symbols-outlined text-rose-600">error</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Filter Toolbar -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 p-4 sm:p-5 shadow-sm space-y-4">
        <!-- Quick Presets -->
        <div class="flex flex-wrap items-center gap-2 pb-3 border-b border-outline-variant/40">
            <span class="text-xs font-bold text-outline uppercase tracking-wider mr-1">Mốc nhanh:</span>
            <a asp-action="Index" asp-route-preset="today" asp-route-groupBy="day" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-outline-variant text-on-surface hover:bg-surface-container-low transition-colors no-underline">
                Hôm nay
            </a>
            <a asp-action="Index" asp-route-preset="7days" asp-route-groupBy="day" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-outline-variant text-on-surface hover:bg-surface-container-low transition-colors no-underline">
                7 ngày qua
            </a>
            <a asp-action="Index" asp-route-preset="month" asp-route-groupBy="day" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-outline-variant text-on-surface hover:bg-surface-container-low transition-colors no-underline">
                Tháng này
            </a>
            <a asp-action="Index" asp-route-preset="year" asp-route-groupBy="month" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-outline-variant text-on-surface hover:bg-surface-container-low transition-colors no-underline">
                Năm nay
            </a>
        </div>

        <!-- Custom Date Range Form -->
        <form method="get" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 items-end">
            <div>
                <label for="fromDate" class="block text-xs font-bold text-outline uppercase tracking-wider mb-1.5">Từ ngày</label>
                <input id="fromDate" name="fromDate" type="date" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="w-full h-10 px-3 bg-surface-container-low border border-outline-variant rounded-xl text-xs font-medium text-on-surface focus:outline-none focus:border-secondary" />
            </div>

            <div>
                <label for="toDate" class="block text-xs font-bold text-outline uppercase tracking-wider mb-1.5">Đến ngày</label>
                <input id="toDate" name="toDate" type="date" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="w-full h-10 px-3 bg-surface-container-low border border-outline-variant rounded-xl text-xs font-medium text-on-surface focus:outline-none focus:border-secondary" />
            </div>

            <div>
                <label for="groupBy" class="block text-xs font-bold text-outline uppercase tracking-wider mb-1.5">Nhóm dữ liệu</label>
                <select id="groupBy" name="groupBy" class="w-full h-10 px-3 bg-surface-container-low border border-outline-variant rounded-xl text-xs font-medium text-on-surface focus:outline-none focus:border-secondary">
                    <option value="day" selected="@(Model.GroupBy == "day")">Theo ngày</option>
                    <option value="month" selected="@(Model.GroupBy == "month")">Theo tháng</option>
                    <option value="year" selected="@(Model.GroupBy == "year")">Theo năm</option>
                </select>
            </div>

            <div class="flex gap-2">
                <button type="submit" class="flex-1 h-10 inline-flex items-center justify-center gap-1.5 bg-secondary text-white rounded-xl text-xs font-bold shadow-sm hover:bg-secondary/90 transition">
                    <span class="material-symbols-outlined text-[16px]">filter_alt</span>
                    <span>Lọc dữ liệu</span>
                </button>
                <a asp-action="Index" class="h-10 px-3 inline-flex items-center justify-center bg-surface-container-low text-on-surface-variant hover:bg-surface-container rounded-xl text-xs font-bold transition no-underline">
                    Đặt lại
                </a>
            </div>
        </form>
    </div>

    <!-- 8 KPI Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Doanh thu đã thu -->
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Doanh thu thực thu</span>
                <div class="text-xl font-bold text-emerald-600 mt-1">@Model.TotalRevenue.ToString("N0") <small class="text-xs text-on-surface-variant font-normal">đ</small></div>
                <span class="text-[11px] text-emerald-700 font-semibold">@Model.PaidTransactionCount giao dịch thành công</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">payments</span>
            </div>
        </div>

        <!-- Giá trị hóa đơn -->
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Giá trị hóa đơn</span>
                <div class="text-xl font-bold text-secondary mt-1">@Model.InvoiceValue.ToString("N0") <small class="text-xs text-on-surface-variant font-normal">đ</small></div>
                <span class="text-[11px] text-on-surface-variant font-medium">@Model.InvoiceCount hóa đơn phát hành</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-secondary-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">receipt_long</span>
            </div>
        </div>

        <!-- Đặt phòng trong kỳ -->
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Booking trong kỳ</span>
                <div class="text-2xl font-bold text-on-surface mt-1">@Model.BookingCount</div>
                <span class="text-[11px] text-on-surface-variant font-medium">@Model.CheckedOutBookingCount hoàn tất • @Model.CancelledBookingCount hủy</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">book_online</span>
            </div>
        </div>

        <!-- Tiền cọc ghi nhận -->
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tiền cọc ghi nhận</span>
                <div class="text-xl font-bold text-secondary mt-1">@Model.TotalDeposit.ToString("N0") <small class="text-xs text-on-surface-variant font-normal">đ</small></div>
                <span class="text-[11px] text-on-surface-variant font-medium">Ghi nhận từ các booking</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-surface-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">savings</span>
            </div>
        </div>

        <!-- Phòng đang sử dụng -->
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Phòng đang ở</span>
                <div class="text-2xl font-bold text-on-surface mt-1">@Model.OccupiedRooms <small class="text-xs text-outline font-normal">/ @Model.TotalRooms</small></div>
                <span class="text-[11px] text-on-surface-variant font-medium">@Model.AvailableRooms trống • @Model.MaintenanceRooms bảo trì</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-surface-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">meeting_room</span>
            </div>
        </div>

        <!-- Đêm phòng -->
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Đêm phòng lưu trú</span>
                <div class="text-2xl font-bold text-on-surface mt-1">@Model.OccupiedRoomNights</div>
                <span class="text-[11px] text-on-surface-variant font-medium">Lượt khách lưu trú thực tế</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-surface-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">bedtime</span>
            </div>
        </div>

        <!-- Tỷ lệ sử dụng phòng -->
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Công suất phòng</span>
                <div class="text-2xl font-bold text-secondary mt-1">@Model.OccupancyRate.ToString("0.##")%</div>
                <span class="text-[11px] text-on-surface-variant font-medium">Tỷ lệ lấp đầy trong kỳ</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-secondary-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">pie_chart</span>
            </div>
        </div>

        <!-- Tình trạng thanh toán -->
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Hóa đơn phát sinh</span>
                <div class="text-2xl font-bold text-on-surface mt-1">@Model.InvoiceCount</div>
                <span class="text-[11px] text-emerald-700 font-semibold">@Model.PaidTransactionCount đã thanh toán</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">task_alt</span>
            </div>
        </div>
    </div>

    <!-- Revenue Timeline Chart & Distribution -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Revenue Trend Bar Chart -->
        <div class="lg:col-span-8 bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm p-5 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-outline-variant/40">
                <div>
                    <span class="text-xs font-bold text-secondary uppercase tracking-wider">Biểu đồ tăng trưởng</span>
                    <h2 class="text-base font-bold text-on-surface">Doanh Thu Theo Thời Gian</h2>
                </div>
            </div>

            @if (Model.RevenueRows.Any())
            {
                <div class="space-y-3">
                    @foreach (var row in Model.RevenueRows)
                    {
                        var pct = Percent(row.Revenue, maxRevenue);
                        <div>
                            <div class="flex justify-between text-xs font-semibold mb-1">
                                <span class="text-on-surface">@row.Label</span>
                                <span class="text-secondary font-bold">@row.Revenue.ToString("N0") đ (@row.TransactionCount GD)</span>
                            </div>
                            <div class="w-full h-3 bg-surface-container-low rounded-full overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-secondary to-primary-container rounded-full transition-all duration-500" style="width: @pct%;"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="py-12 text-center text-on-surface-variant text-xs">
                    Chưa có dữ liệu doanh thu trong khoảng thời gian này
                </div>
            }
        </div>

        <!-- Category Breakdown -->
        <div class="lg:col-span-4 bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm p-5 space-y-4">
            <div class="pb-3 border-b border-outline-variant/40">
                <span class="text-xs font-bold text-secondary uppercase tracking-wider">Cơ cấu doanh thu</span>
                <h2 class="text-base font-bold text-on-surface">Hạng Mục Dịch Vụ</h2>
            </div>

            @if (Model.InvoiceCategories.Any())
            {
                <div class="space-y-4">
                    @foreach (var cat in Model.InvoiceCategories)
                    {
                        var pct = Percent(cat.Amount, maxInvoiceCategory);
                        <div>
                            <div class="flex justify-between text-xs font-semibold mb-1">
                                <span class="text-on-surface">@cat.Label</span>
                                <span class="text-secondary font-bold">@cat.Amount.ToString("N0") đ</span>
                            </div>
                            <div class="w-full h-2.5 bg-surface-container-low rounded-full overflow-hidden">
                                <div class="h-full bg-secondary rounded-full" style="width: @pct%;"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="py-12 text-center text-on-surface-variant text-xs">
                    Chưa có dữ liệu danh mục
                </div>
            }
        </div>
    </div>

    <!-- Booking Status Distribution -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm p-5 space-y-4">
        <div class="pb-3 border-b border-outline-variant/40">
            <span class="text-xs font-bold text-secondary uppercase tracking-wider">Phân bổ trạng thái</span>
            <h2 class="text-base font-bold text-on-surface">Cơ Cấu Booking Trong Kỳ</h2>
        </div>

        @if (Model.BookingStatuses.Any())
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
                @foreach (var st in Model.BookingStatuses)
                {
                    <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant/40">
                        <span class="text-[11px] font-bold text-outline uppercase block">@st.Label</span>
                        <div class="text-2xl font-bold text-on-surface mt-1">@st.Count</div>
                        <span class="text-[11px] text-on-surface-variant">Lượt đặt phòng</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="py-8 text-center text-on-surface-variant text-xs">
                Không có dữ liệu booking trong kỳ
            </div>
        }
    </div>
</div>
