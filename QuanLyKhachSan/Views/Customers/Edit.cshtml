@model QuanLyKhachSan.Models.Customer
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa khách hàng";
}

<div class="max-w-5xl mx-auto space-y-6">
    <!-- Top Action / Breadcrumb -->
    <div class="flex items-center justify-between">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-[#0b1c30] transition-colors">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            Quay lại danh sách khách hàng
        </a>
        <a asp-action="Details" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-semibold transition-colors">
            <span class="material-symbols-outlined text-base">visibility</span>
            Xem hồ sơ
        </a>
    </div>

    <!-- Main Card -->
    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden">
        <!-- Header -->
        <div class="bg-gradient-to-r from-[#0b1c30] to-[#1e293b] p-8 text-white relative overflow-hidden">
            <div class="absolute -right-8 -bottom-8 opacity-10">
                <span class="material-symbols-outlined text-[160px]">edit_note</span>
            </div>
            <div class="relative z-10">
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-[#c5a880]/20 text-[#c5a880] border border-[#c5a880]/30 uppercase tracking-widest inline-block mb-3">
                    Hồ sơ #@Model.Id
                </span>
                <h1 class="font-serif text-2xl lg:text-3xl font-bold tracking-tight">Chỉnh Sửa Hồ Sơ Khách Hàng</h1>
                <p class="text-slate-300 text-sm mt-1">@Model.FullName</p>
            </div>
        </div>

        <!-- Form Body -->
        <div class="p-8 lg:p-10">
            <form asp-controller="Customers" asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-8">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Avatar" />
                <input type="hidden" asp-for="CreatedAt" />
                <input type="hidden" asp-for="IsDeleted" />

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                    <!-- Left: Avatar Upload -->
                    <div class="lg:col-span-4 flex flex-col items-center text-center p-6 bg-slate-50/70 rounded-2xl border border-slate-100">
                        <div class="relative group mb-4">
                            @if (!string.IsNullOrWhiteSpace(Model.Avatar))
                            {
                                <img id="avatarPreview" src="@Model.Avatar" class="w-32 h-32 rounded-full object-cover border-4 border-white shadow-lg" alt="Avatar" />
                            }
                            else
                            {
                                <div id="avatarPlaceholder" class="w-32 h-32 rounded-full bg-gradient-to-br from-[#c5a880] to-[#725b38] text-white flex items-center justify-center text-4xl font-serif font-bold shadow-lg border-4 border-white">
                                    <span class="material-symbols-outlined text-5xl">person</span>
                                </div>
                            }
                        </div>
                        <label for="avatarFile" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Đổi ảnh đại diện</label>
                        <input id="avatarFile" name="avatarFile" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-[#c5a880]/20 file:text-[#725b38] hover:file:bg-[#c5a880]/30 cursor-pointer" />
                        <p class="text-[11px] text-slate-400 mt-2">Định dạng JPG, PNG, WEBP. Tối đa 5MB.</p>
                    </div>

                    <!-- Right: Info Fields -->
                    <div class="lg:col-span-8 space-y-6">
                        <!-- Linked Account -->
                        <div>
                            <label asp-for="AccountId" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Tài khoản liên kết</label>
                            <div class="relative">
                                <select asp-for="AccountId" asp-items="ViewBag.AccountId" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium appearance-none">
                                    <option value="">-- Chưa liên kết tài khoản --</option>
                                </select>
                                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">expand_more</span>
                            </div>
                            <span asp-validation-for="AccountId" class="text-xs text-rose-500 mt-1 block"></span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <!-- FullName -->
                            <div class="sm:col-span-2">
                                <label asp-for="FullName" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Họ và tên <span class="text-rose-500">*</span></label>
                                <input asp-for="FullName" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                                <span asp-validation-for="FullName" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>

                            <!-- Gender -->
                            <div>
                                <label asp-for="Gender" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Giới tính</label>
                                <div class="relative">
                                    <select asp-for="Gender" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium appearance-none">
                                        <option value="">-- Chọn giới tính --</option>
                                        <option value="Nam">Nam</option>
                                        <option value="Nữ">Nữ</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                    <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">expand_more</span>
                                </div>
                                <span asp-validation-for="Gender" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>

                            <!-- Date of Birth -->
                            <div>
                                <label asp-for="DateOfBirth" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Ngày sinh</label>
                                <input asp-for="DateOfBirth" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                                <span asp-validation-for="DateOfBirth" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>

                            <!-- Citizen ID -->
                            <div>
                                <label asp-for="CitizenId" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Căn cước công dân (CCCD)</label>
                                <input asp-for="CitizenId" inputmode="numeric" maxlength="12" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-mono" />
                                <span asp-validation-for="CitizenId" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>

                            <!-- Phone -->
                            <div>
                                <label asp-for="Phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Số điện thoại <span class="text-rose-500">*</span></label>
                                <input asp-for="Phone" type="tel" maxlength="15" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                                <span asp-validation-for="Phone" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>

                            <!-- Email -->
                            <div class="sm:col-span-2">
                                <label asp-for="Email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Địa chỉ Email <span class="text-rose-500">*</span></label>
                                <input asp-for="Email" type="email" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                                <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>

                            <!-- Address -->
                            <div class="sm:col-span-2">
                                <label asp-for="Address" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Địa chỉ thường trú</label>
                                <textarea asp-for="Address" rows="3" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all"></textarea>
                                <span asp-validation-for="Address" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action buttons -->
                <div class="pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
                    <a asp-action="Index" class="px-6 py-3 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                        Hủy
                    </a>
                    <button type="submit" class="px-7 py-3 rounded-xl bg-gradient-to-r from-[#c5a880] to-[#725b38] hover:from-[#b9986b] hover:to-[#634e2f] text-white text-sm font-semibold shadow-lg shadow-[#c5a880]/20 transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg">save</span>
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const avatarInput = document.getElementById("avatarFile");
            const avatarPreview = document.getElementById("avatarPreview");
            const avatarPlaceholder = document.getElementById("avatarPlaceholder");

            avatarInput?.addEventListener("change", function () {
                const file = this.files && this.files.length > 0 ? this.files[0] : null;
                if (!file) return;
                const reader = new FileReader();
                reader.onload = function (e) {
                    if (avatarPreview) {
                        avatarPreview.src = e.target.result;
                        avatarPreview.classList.remove("hidden");
                    }
                    if (avatarPlaceholder) {
                        avatarPlaceholder.classList.add("hidden");
                    }
                };
                reader.readAsDataURL(file);
            });
        });
    </script>
}
