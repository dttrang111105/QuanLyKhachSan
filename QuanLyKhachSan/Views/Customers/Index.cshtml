@model IEnumerable<QuanLyKhachSan.Models.Customer>
@using QuanLyKhachSan.Models
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Khách hàng & Hội viên VIP";

    List<Customer> customers = Model?.ToList() ?? new List<Customer>();
    int totalCustomers = customers.Count;
    int linkedAccounts = customers.Count(c => c.Account != null);
    int totalBookings = customers.Sum(c => c.Bookings?.Count(b => !b.IsDeleted) ?? 0);
    int totalReviews = customers.Sum(c => c.Reviews?.Count(r => !r.IsDeleted) ?? 0);
    DateTime monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    int newCustomersThisMonth = customers.Count(c => c.CreatedAt >= monthStart);

    string CustomerInitial(string? fullName) => string.IsNullOrWhiteSpace(fullName) ? "K" : fullName.Trim().Substring(0, 1).ToUpper();

    string GenderText(object? gender)
    {
        string value = Convert.ToString(gender)?.Trim() ?? string.Empty;
        return value.ToLower() switch
        {
            "male" or "nam" => "Nam",
            "female" or "nữ" or "nu" => "Nữ",
            "other" or "khác" => "Khác",
            "" => "Chưa cập nhật",
            _ => value
        };
    }
}

<div class="space-y-6">
    <!-- Header / Breadcrumb / Actions Section -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
                <span class="material-symbols-outlined text-[16px]">group</span>
                <span>Khách hàng &amp; CRM 360°</span>
            </div>
            <div class="flex items-baseline gap-2 mt-1">
                <h1 class="font-serif text-2xl sm:text-3xl font-bold text-on-surface">Hồ Sơ Khách Hàng &amp; VIP</h1>
                <span class="px-2.5 py-0.5 rounded-full bg-secondary-container text-secondary text-[11px] font-bold uppercase">
                    Loyalty PMS
                </span>
            </div>
            <p class="text-xs text-on-surface-variant mt-1">
                Quản trị cơ sở dữ liệu khách hàng, theo dõi lịch sử đặt phòng và mức độ tương tác trải nghiệm tại resort.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-controller="Bookings" asp-action="Index"
               class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface hover:bg-surface-container-low text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[18px] text-secondary">calendar_month</span>
                <span>Xem Booking</span>
            </a>
            <a asp-action="Create"
               class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-primary text-white hover:bg-on-background text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                <span>+ Thêm Khách Hàng</span>
            </a>
        </div>
    </header>

    <!-- 4 KPI Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tổng khách hàng</span>
                <div class="text-2xl font-bold text-on-surface mt-1">@totalCustomers</div>
                <span class="text-[11px] text-emerald-700 font-semibold">+@newCustomersThisMonth trong tháng</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">contacts</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tài khoản liên kết</span>
                <div class="text-2xl font-bold text-secondary mt-1">@linkedAccounts</div>
                <span class="text-[11px] text-on-surface-variant font-medium">Đã đăng ký tài khoản portal</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-secondary-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">vpn_key</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Lượt đặt phòng</span>
                <div class="text-2xl font-bold text-emerald-600 mt-1">@totalBookings</div>
                <span class="text-[11px] text-on-surface-variant font-medium">Toàn bộ hồ sơ lưu trú</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">hotel</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Đánh giá gửi về</span>
                <div class="text-2xl font-bold text-amber-600 mt-1">@totalReviews</div>
                <span class="text-[11px] text-on-surface-variant font-medium">Phản hồi trải nghiệm phòng</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">rate_review</span>
            </div>
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm overflow-hidden">
        <!-- Table Toolbar -->
        <div class="p-4 sm:p-5 border-b border-outline-variant/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <span class="text-xs font-bold text-secondary uppercase tracking-wider">Hồ sơ định danh</span>
                <h2 class="text-base font-bold text-on-surface">Danh Sách Khách Hàng (@totalCustomers)</h2>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <div class="relative">
                    <input type="text" id="customerSearch" placeholder="Tìm tên, SĐT, Email, CCCD..."
                           class="h-9 pl-8 pr-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary w-56 sm:w-64 transition-all" />
                    <span class="material-symbols-outlined text-[16px] text-outline absolute left-2.5 top-1/2 -translate-y-1/2">search</span>
                </div>
                <select id="accountFilter"
                        class="h-9 px-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary transition-all">
                    <option value="">Tất cả tài khoản</option>
                    <option value="linked">Đã liên kết tài khoản</option>
                    <option value="guest">Khách vãng lai (Chưa tạo nick)</option>
                </select>
            </div>
        </div>

        @if (customers.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-surface-container-low text-on-surface-variant font-semibold uppercase text-[10px] tracking-wider border-b border-outline-variant/40">
                        <tr>
                            <th class="py-3 px-4">Họ &amp; Tên</th>
                            <th class="py-3 px-4">Liên Hệ</th>
                            <th class="py-3 px-4">CCCD / Định Danh</th>
                            <th class="py-3 px-4">Giới Tính</th>
                            <th class="py-3 px-4 text-center">Tài Khoản</th>
                            <th class="py-3 px-4 text-center">Booking</th>
                            <th class="py-3 px-4 text-center">Đánh Giá</th>
                            <th class="py-3 px-4 text-right">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/30 text-on-surface font-medium">
                        @foreach (var c in customers)
                        {
                            int bCount = c.Bookings?.Count(b => !b.IsDeleted) ?? 0;
                            int rCount = c.Reviews?.Count(r => !r.IsDeleted) ?? 0;
                            bool hasAcc = c.Account != null;
                            string searchStr = $"{c.FullName} {c.Phone} {c.Email} {c.CitizenId}".ToLower();

                            <tr class="hover:bg-surface-container-low/60 transition-colors customer-row"
                                data-account="@(hasAcc ? "linked" : "guest")" data-search="@searchStr">
                                <td class="py-3.5 px-4 font-bold text-on-surface">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-surface-container text-secondary flex items-center justify-center font-bold text-xs shrink-0">
                                            @CustomerInitial(c.FullName)
                                        </div>
                                        <div>
                                            <div class="font-bold text-on-surface text-sm">@c.FullName</div>
                                            <div class="text-[10px] text-outline font-normal">Mã #@c.Id • Gia nhập: @c.CreatedAt.ToString("dd/MM/yyyy")</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="py-3.5 px-4">
                                    <div class="text-on-surface font-semibold">@(string.IsNullOrWhiteSpace(c.Phone) ? "—" : c.Phone)</div>
                                    <div class="text-[10px] text-on-surface-variant font-normal">@(string.IsNullOrWhiteSpace(c.Email) ? "Chưa có email" : c.Email)</div>
                                </td>

                                <td class="py-3.5 px-4 text-on-surface-variant font-mono">
                                    @(string.IsNullOrWhiteSpace(c.CitizenId) ? "—" : c.CitizenId)
                                </td>

                                <td class="py-3.5 px-4">
                                    <span class="px-2 py-0.5 rounded text-[11px] bg-surface-container text-on-surface font-semibold">
                                        @GenderText(c.Gender)
                                    </span>
                                </td>

                                <td class="py-3.5 px-4 text-center">
                                    @if (hasAcc)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> @c.Account!.Username
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[11px] text-outline">Khách lẻ</span>
                                    }
                                </td>

                                <td class="py-3.5 px-4 text-center">
                                    <span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 font-bold text-[11px]">
                                        @bCount đơn
                                    </span>
                                </td>

                                <td class="py-3.5 px-4 text-center">
                                    <span class="px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 font-bold text-[11px]">
                                        @rCount bài
                                    </span>
                                </td>

                                <td class="py-3.5 px-4 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@c.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-secondary hover:bg-surface-container transition-colors"
                                           title="Xem chi tiết">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@c.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-amber-600 hover:bg-amber-50 transition-colors"
                                           title="Chỉnh sửa">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@c.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-rose-600 hover:bg-rose-50 transition-colors"
                                           title="Xóa hồ sơ">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-12 text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-4xl text-outline mb-2">group</span>
                <p class="text-sm font-semibold">Chưa có hồ sơ khách hàng nào trong hệ thống</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('customerSearch');
            const accFilter = document.getElementById('accountFilter');
            const rows = document.querySelectorAll('.customer-row');

            function filterTable() {
                const query = (searchInput?.value || '').toLowerCase().trim();
                const selectedAcc = (accFilter?.value || '').toLowerCase().trim();

                rows.forEach(row => {
                    const rowSearch = (row.getAttribute('data-search') || '').toLowerCase();
                    const rowAcc = (row.getAttribute('data-account') || '').toLowerCase();

                    const matchesQuery = !query || rowSearch.includes(query);
                    const matchesAcc = !selectedAcc || rowAcc === selectedAcc;

                    row.style.display = (matchesQuery && matchesAcc) ? '' : 'none';
                });
            }

            if (searchInput) searchInput.addEventListener('input', filterTable);
            if (accFilter) accFilter.addEventListener('change', filterTable);
        });
    </script>
}