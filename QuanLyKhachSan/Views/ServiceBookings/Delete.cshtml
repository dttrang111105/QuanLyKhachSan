@model QuanLyKhachSan.Models.ServiceBooking
@{
    Layout = User.IsInRole("Admin")
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";
    ViewData["Title"] = "Xác nhận xóa dịch vụ đã đặt";
}

<div class="max-w-2xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-rose-600 uppercase">
                <span class="material-symbols-outlined text-sm">delete</span>
                <span>Hủy bỏ &amp; Xóa bản ghi</span>
            </div>
            <h1 class="font-serif text-2xl md:text-3xl font-bold text-[#0b1c30] mt-1">
                Xác nhận xóa dịch vụ đã đặt
            </h1>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 text-xs font-bold hover:bg-slate-50 transition shadow-sm">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            <span>Quay lại</span>
        </a>
    </div>

    <!-- Warning Card -->
    <div class="bg-white rounded-2xl border border-rose-100 shadow-sm overflow-hidden">
        <div class="p-6 bg-rose-50 border-b border-rose-100 flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-rose-600 text-white flex items-center justify-center flex-shrink-0 shadow-sm">
                <span class="material-symbols-outlined text-2xl">warning</span>
            </div>
            <div>
                <h3 class="font-bold text-rose-950 text-base">Hành động không thể khôi phục</h3>
                <p class="text-xs text-rose-700 mt-1">
                    Bạn có chắc chắn muốn xóa dịch vụ <strong>@(Model.Service?.ServiceName ?? "Dịch vụ")</strong> khỏi Booking <strong>@(Model.Booking?.BookingCode ?? $"#{Model.BookingId}")</strong>?
                </p>
            </div>
        </div>

        <div class="p-6 space-y-4 text-sm">
            <div class="grid grid-cols-2 gap-4 py-2 border-b border-slate-100">
                <span class="text-xs font-bold text-slate-400 uppercase">Mã Booking</span>
                <span class="text-right font-bold text-slate-800">@(Model.Booking?.BookingCode ?? $"#{Model.BookingId}")</span>
            </div>
            <div class="grid grid-cols-2 gap-4 py-2 border-b border-slate-100">
                <span class="text-xs font-bold text-slate-400 uppercase">Tên dịch vụ</span>
                <span class="text-right font-bold text-slate-800">@(Model.Service?.ServiceName ?? "N/A")</span>
            </div>
            <div class="grid grid-cols-2 gap-4 py-2 border-b border-slate-100">
                <span class="text-xs font-bold text-slate-400 uppercase">Số lượng</span>
                <span class="text-right text-slate-700">@Model.Quantity</span>
            </div>
            <div class="grid grid-cols-2 gap-4 py-2">
                <span class="text-xs font-bold text-slate-400 uppercase">Tổng thành tiền</span>
                <span class="text-right font-bold font-serif text-[#0b1c30]">@Model.TotalPrice.ToString("N0") VNĐ</span>
            </div>
        </div>

        <form asp-action="Delete" class="p-6 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-xs font-bold hover:bg-white transition">
                Hủy bỏ
            </a>
            <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold shadow-md transition">
                <span class="material-symbols-outlined text-sm">delete_forever</span>
                <span>Xác nhận xóa</span>
            </button>
        </form>
    </div>
</div>
