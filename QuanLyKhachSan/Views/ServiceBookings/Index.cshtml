@model IEnumerable<QuanLyKhachSan.Models.ServiceBooking>
@{
    Layout = User.IsInRole("Admin")
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";
    ViewData["Title"] = "Lịch sử đặt dịch vụ";
    var serviceBookings = Model?.ToList() ?? new List<QuanLyKhachSan.Models.ServiceBooking>();
    var totalAmount = serviceBookings.Sum(item => item.TotalPrice);
}

<div class="space-y-6">
    <!-- Header -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
                <span class="material-symbols-outlined text-[16px]">room_service</span>
                <span>Vận hành dịch vụ</span>
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-on-surface mt-1">Lịch Đặt &amp; Sử Dụng Dịch Vụ</h1>
            <p class="text-xs text-on-surface-variant mt-1">
                Theo dõi chi tiết các lượt order dịch vụ từ khách hàng lưu trú tại các phòng.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="Services" asp-action="StaffBookService"
               class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-primary text-white hover:bg-on-background text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span>+ Đặt Dịch Vụ Mới</span>
            </a>
        </div>
    </header>

    <!-- KPI Summary -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tổng lượt sử dụng</span>
                <div class="text-2xl font-bold text-on-surface mt-1">@serviceBookings.Count</div>
                <span class="text-[11px] text-on-surface-variant">Lượt order trên toàn hệ thống</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-surface-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">list_alt</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tổng doanh thu dịch vụ</span>
                <div class="text-2xl font-bold text-secondary mt-1">@totalAmount.ToString("N0") <small class="text-xs text-on-surface-variant font-normal">đ</small></div>
                <span class="text-[11px] text-emerald-700 font-semibold">Tích lũy theo danh sách order</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-secondary-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">payments</span>
            </div>
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-outline-variant/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <span class="text-xs font-bold text-secondary uppercase tracking-wider">Nhật ký order</span>
                <h2 class="text-base font-bold text-on-surface">Danh Sách Dịch Vụ Đã Sử Dụng (@serviceBookings.Count)</h2>
            </div>
            <div class="relative">
                <input type="text" id="sbSearch" placeholder="Tìm kiếm booking, dịch vụ..."
                       class="h-9 pl-8 pr-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary w-56 sm:w-64 transition-all" />
                <span class="material-symbols-outlined text-[16px] text-outline absolute left-2.5 top-1/2 -translate-y-1/2">search</span>
            </div>
        </div>

        @if (serviceBookings.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-surface-container-low text-on-surface-variant font-semibold uppercase text-[10px] tracking-wider border-b border-outline-variant/40">
                        <tr>
                            <th class="py-3 px-4">STT</th>
                            <th class="py-3 px-4">Mã Đặt Phòng</th>
                            <th class="py-3 px-4">Dịch Vụ</th>
                            <th class="py-3 px-4 text-center">Số Lượng</th>
                            <th class="py-3 px-4 text-right">Đơn Giá</th>
                            <th class="py-3 px-4 text-right">Thành Tiền</th>
                            <th class="py-3 px-4 text-right">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/30 text-on-surface font-medium">
                        @{ var index = 1; }
                        @foreach (var item in serviceBookings)
                        {
                            string searchStr = $"{item.Booking?.BookingCode} {item.Service?.ServiceName}".ToLower();
                            <tr class="hover:bg-surface-container-low/60 transition-colors sb-row" data-search="@searchStr">
                                <td class="py-3 px-4 text-outline font-semibold">@index</td>
                                <td class="py-3 px-4 font-bold text-on-surface">
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-[18px] text-secondary">hotel</span>
                                        <span>@(item.Booking?.BookingCode ?? "—")</span>
                                    </div>
                                </td>
                                <td class="py-3 px-4 font-semibold text-on-surface">
                                    @(item.Service?.ServiceName ?? "Dịch vụ đã xóa")
                                </td>
                                <td class="py-3 px-4 text-center">
                                    <span class="px-2.5 py-1 rounded-full bg-surface-container text-on-surface font-bold text-[11px]">
                                        @item.Quantity
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-right text-on-surface-variant">
                                    @((item.UnitPrice).ToString("N0")) đ
                                </td>
                                <td class="py-3 px-4 text-right font-bold text-secondary">
                                    @item.TotalPrice.ToString("N0") đ
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-secondary hover:bg-surface-container transition-colors"
                                           title="Xem chi tiết">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-amber-600 hover:bg-amber-50 transition-colors"
                                           title="Chỉnh sửa">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-rose-600 hover:bg-rose-50 transition-colors"
                                           title="Hủy">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-12 text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-4xl text-outline mb-2">room_service</span>
                <p class="text-sm font-semibold">Chưa có bản ghi sử dụng dịch vụ nào</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('sbSearch');
            const rows = document.querySelectorAll('.sb-row');

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const q = (this.value || '').toLowerCase().trim();
                    rows.forEach(r => {
                        const s = (r.getAttribute('data-search') || '').toLowerCase();
                        r.style.display = (!q || s.includes(q)) ? '' : 'none';
                    });
                });
            }
        });
    </script>
}