@model QuanLyKhachSan.ViewModels.Profile.ProfileViewModel
@{
    if (User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (User.IsInRole("Receptionist"))
    {
        Layout = "~/Views/Shared/_ReceptionistLayout.cshtml";
    }
    else if (User.IsInRole("Customer"))
    {
        Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="space-y-6">
    <!-- Top Action / Breadcrumb -->
    <div class="flex items-center justify-between">
        @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
        {
            <a asp-controller="Home" asp-action="Dashboard" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-[#0b1c30] transition-colors">
                <span class="material-symbols-outlined text-base">arrow_back</span>
                Quay về bảng điều khiển
            </a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-[#0b1c30] transition-colors">
                <span class="material-symbols-outlined text-base">arrow_back</span>
                Quay về trang chủ
            </a>
        }

        <div class="flex items-center gap-3">
            <a asp-controller="Profile" asp-action="Edit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#c5a880] to-[#725b38] hover:from-[#b9986b] hover:to-[#634e2f] text-white text-sm font-semibold shadow-md shadow-[#c5a880]/20 transition-all">
                <span class="material-symbols-outlined text-lg">edit</span>
                Chỉnh sửa hồ sơ
            </a>
            <a asp-controller="Profile" asp-action="ChangePassword" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50 text-sm font-semibold transition-colors">
                <span class="material-symbols-outlined text-lg">lock_reset</span>
                Đổi mật khẩu
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-3">
            <span class="material-symbols-outlined text-emerald-600">check_circle</span>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3">
            <span class="material-symbols-outlined text-rose-600">error</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Main Card -->
    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden">
        <!-- Banner Header -->
        <div class="bg-gradient-to-r from-[#0b1c30] via-[#131b2e] to-[#20293a] p-8 lg:p-10 text-white relative overflow-hidden">
            <div class="absolute -right-10 -bottom-10 opacity-10">
                <span class="material-symbols-outlined text-[200px]">badge</span>
            </div>
            <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="flex items-center gap-6">
                    <div class="relative">
                        @if (!string.IsNullOrWhiteSpace(Model.Avatar))
                        {
                            <img src="@Model.Avatar" class="w-24 h-24 rounded-2xl object-cover border-2 border-[#c5a880] shadow-lg shadow-black/20" alt="Avatar" />
                        }
                        else
                        {
                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.FullName ?? Model.Username)&size=160&background=c5a880&color=0b1c30&bold=true" class="w-24 h-24 rounded-2xl object-cover border-2 border-[#c5a880] shadow-lg shadow-black/20" alt="Avatar" />
                        }
                        <span class="absolute -bottom-2 -right-2 w-6 h-6 rounded-full bg-emerald-500 border-2 border-[#0b1c30] flex items-center justify-center">
                            <span class="material-symbols-outlined text-white text-[12px] font-bold">check</span>
                        </span>
                    </div>
                    <div>
                        <div class="flex items-center gap-3">
                            <h1 class="font-serif text-2xl lg:text-3xl font-bold tracking-tight text-white">@Model.FullName</h1>
                            <span class="px-3 py-1 rounded-full text-xs font-bold bg-[#c5a880]/20 text-[#c5a880] border border-[#c5a880]/30 uppercase tracking-wider">
                                @Model.Role
                            </span>
                        </div>
                        <p class="text-slate-400 text-sm mt-1">@@@Model.Username • Thành viên từ @Model.CreatedAt.ToString("MM/yyyy")</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Information Detail Grid -->
        <div class="p-8 lg:p-10">
            <h2 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-6 flex items-center gap-2">
                <span class="material-symbols-outlined text-base">person</span>
                Thông tin tài khoản & cá nhân
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Username -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-slate-200/70 text-slate-700 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">account_circle</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Tên đăng nhập</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@Model.Username</span>
                    </div>
                </div>

                <!-- FullName -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">badge</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Họ và tên</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@Model.FullName</span>
                    </div>
                </div>

                <!-- Email -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">mail</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Email liên hệ</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block truncate max-w-[200px]" title="@Model.Email">@Model.Email</span>
                    </div>
                </div>

                <!-- Phone -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">call</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Số điện thoại</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</span>
                    </div>
                </div>

                <!-- Date of birth -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">cake</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Ngày sinh</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</span>
                    </div>
                </div>

                <!-- Created At -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-slate-200/70 text-slate-700 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">history</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Ngày tham gia</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>

                <!-- Address (Full Width in row) -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4 md:col-span-2 lg:col-span-3">
                    <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">location_on</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Địa chỉ thường trú</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@(string.IsNullOrWhiteSpace(Model.Address) ? "Chưa cập nhật địa chỉ" : Model.Address)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
