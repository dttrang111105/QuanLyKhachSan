@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra sự cố";
}

<div class="min-h-[60vh] flex items-center justify-center p-6">
    <div class="max-w-lg w-full bg-white rounded-3xl p-8 lg:p-10 shadow-xl shadow-slate-200/50 border border-slate-100 text-center space-y-6">
        <div class="w-16 h-16 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto shadow-inner">
            <span class="material-symbols-outlined text-3xl">error_outline</span>
        </div>

        <div>
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-600 border border-rose-200 uppercase tracking-widest inline-block mb-3">
                Lỗi hệ thống
            </span>
            <h1 class="font-serif text-2xl font-bold text-slate-900">Đã xảy ra sự cố xử lý</h1>
            <p class="text-sm text-slate-500 mt-2">
                Hệ thống gặp gián đoạn trong khi thực hiện yêu cầu của bạn. Vui lòng thử lại hoặc liên hệ quản trị viên khách sạn.
            </p>
        </div>

        @if (Model.ShowRequestId)
        {
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 text-xs text-slate-600 font-mono text-left space-y-1">
                <span class="text-slate-400 font-sans block text-[11px] font-bold uppercase">Mã tham chiếu yêu cầu:</span>
                <span class="text-rose-600 font-bold break-all">@Model.RequestId</span>
            </div>
        }

        <div class="pt-4 flex items-center justify-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="px-6 py-3 rounded-xl bg-gradient-to-r from-[#c5a880] to-[#725b38] hover:from-[#b9986b] hover:to-[#634e2f] text-white text-sm font-semibold shadow-lg shadow-[#c5a880]/20 transition-all inline-flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">home</span>
                Về trang chủ
            </a>
            <button onclick="window.history.back()" class="px-6 py-3 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                Quay lại
            </button>
        </div>
    </div>
</div>
