@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject QuanLyKhachSan.Data.ApplicationDbContext DbContext
@{
    string currentPath = Context.Request.Path.Value?
        .TrimEnd('/')
        .ToLowerInvariant() ?? string.Empty;
    bool isHome = string.IsNullOrWhiteSpace(currentPath)
        || currentPath == "/home"
        || currentPath == "/home/index";
    string homeUrl = Url.Action("Index", "Home") ?? "/";
    string displayName = User.Identity?.Name ?? "Tài khoản";
    if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
    {
        string? accountIdText = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(accountIdText, out int accountId))
        {
            string? customerName = await DbContext.Customers
                .AsNoTracking()
                .Where(x => x.AccountId == accountId && !x.IsDeleted)
                .Select(x => x.FullName)
                .FirstOrDefaultAsync();
            if (!string.IsNullOrWhiteSpace(customerName))
            {
                displayName = customerName;
            }
        }
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Aura Grand Resort & Spa - Tuyệt tác nghỉ dưỡng 5 sao tiêu chuẩn quốc tế." />
    <title>@ViewData["Title"] - Aura Grand Resort & Spa</title>
    
    <!-- Google Fonts & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cinzel:wght@500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <!-- Bootstrap 5 & Tailwind -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface": "#f8f9ff",
                        "surface-dim": "#cbdbf5",
                        "surface-bright": "#f8f9ff",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#eff4ff",
                        "surface-container": "#e5eeff",
                        "surface-container-high": "#dce9ff",
                        "surface-container-highest": "#d3e4fe",
                        "on-surface": "#0b1c30",
                        "on-surface-variant": "#45464d",
                        "primary": "#0f172a",
                        "on-primary": "#ffffff",
                        "primary-container": "#131b2e",
                        "on-primary-container": "#7c839b",
                        "secondary": "#725b38",
                        "on-secondary": "#ffffff",
                        "secondary-container": "#fedeb2",
                        "on-secondary-container": "#78603e",
                        "secondary-fixed": "#fedeb2",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "outline": "#76777d",
                        "outline-variant": "#e2e8f0"
                    },
                    fontFamily: {
                        sans: ["Plus Jakarta Sans", "sans-serif"],
                        serif: ["Cinzel", "serif"]
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8f9ff; color: #0b1c30; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-surface text-on-surface antialiased flex flex-col min-h-screen">
    <!-- STITCH LUXURY HEADER -->
    <header class="fixed top-0 w-full z-50 bg-surface-container-lowest/95 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] border-b border-outline-variant/60 transition-all duration-300">
        <div class="h-20 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
            <!-- Brand Logo -->
            <div class="flex items-center gap-6">
                <a asp-controller="Home" asp-action="Index" class="flex flex-col no-underline group">
                    <span class="font-bold text-lg tracking-[0.2em] uppercase text-on-surface group-hover:text-secondary transition-colors">AURA GRAND</span>
                    <span class="text-[10px] tracking-[0.3em] uppercase text-secondary font-semibold">Resort &amp; Spa • Luxury Hotel</span>
                </a>
                
                <!-- Desktop Navigation Links -->
                <nav class="hidden lg:flex items-center gap-1">
                    <a asp-controller="Home" asp-action="Index" class="px-3 py-2 text-sm rounded-lg transition-colors no-underline @(isHome ? "bg-surface-container text-on-surface font-semibold" : "text-on-surface-variant hover:bg-surface-container hover:text-on-surface")">
                        Trang chủ
                    </a>
                    <a asp-controller="Rooms" asp-action="Search" class="px-3 py-2 text-sm rounded-lg transition-colors no-underline text-on-surface-variant hover:bg-surface-container hover:text-on-surface">
                        Tìm &amp; Đặt phòng
                    </a>
                    <a href="@(homeUrl + "#rooms")" class="px-3 py-2 text-sm rounded-lg transition-colors no-underline text-on-surface-variant hover:bg-surface-container hover:text-on-surface">
                        Hạng phòng
                    </a>
                    <a href="@(homeUrl + "#services")" class="px-3 py-2 text-sm rounded-lg transition-colors no-underline text-on-surface-variant hover:bg-surface-container hover:text-on-surface">
                        Ẩm thực &amp; Spa
                    </a>
                    <a href="@(homeUrl + "#promotion")" class="px-3 py-2 text-sm rounded-lg transition-colors no-underline text-on-surface-variant hover:bg-surface-container hover:text-on-surface">
                        Ưu đãi đặc quyền
                    </a>
                    <a href="@(homeUrl + "#contact")" class="px-3 py-2 text-sm rounded-lg transition-colors no-underline text-on-surface-variant hover:bg-surface-container hover:text-on-surface">
                        Liên hệ
                    </a>
                </nav>
            </div>

            <!-- Header Action Controls -->
            <div class="flex items-center gap-3">
                <a asp-controller="Rooms" asp-action="Search" class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-secondary text-white text-sm font-semibold hover:bg-secondary/90 shadow-sm transition-all no-underline">
                    <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                    <span>Đặt phòng ngay</span>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container border border-outline-variant transition-all dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="w-8 h-8 rounded-full bg-primary-container text-white flex items-center justify-center font-bold text-xs shadow-inner">
                                @displayName.Substring(0, 1).ToUpper()
                            </div>
                            <div class="hidden sm:flex flex-col text-left">
                                <span class="text-xs font-bold text-on-surface leading-none">@displayName</span>
                                <span class="text-[10px] text-secondary font-medium mt-0.5">@(User.IsInRole("Admin") ? "Quản trị viên" : User.IsInRole("Receptionist") ? "Lễ tân" : "Hội viên VIP")</span>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-xl rounded-xl border border-outline-variant p-2 min-w-[220px]">
                            <li class="px-3 py-2 border-b border-outline-variant/60 mb-1">
                                <p class="text-xs font-bold text-on-surface m-0">@displayName</p>
                                <p class="text-[11px] text-on-surface-variant m-0">@User.Identity.Name</p>
                            </li>
                            @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                            {
                                <li>
                                    <a class="dropdown-item rounded-lg text-xs font-semibold py-2 flex items-center gap-2" asp-controller="Home" asp-action="Dashboard">
                                        <span class="material-symbols-outlined text-secondary text-[18px]">dashboard</span>
                                        Bảng điều khiển PMS
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Customer"))
                            {
                                <li>
                                    <a class="dropdown-item rounded-lg text-xs font-semibold py-2 flex items-center gap-2" asp-controller="Bookings" asp-action="MyBookings">
                                        <span class="material-symbols-outlined text-secondary text-[18px]">calendar_month</span>
                                        Booking của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-lg text-xs font-semibold py-2 flex items-center gap-2" asp-controller="Invoices" asp-action="MyInvoices">
                                        <span class="material-symbols-outlined text-secondary text-[18px]">receipt_long</span>
                                        Hóa đơn của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-lg text-xs font-semibold py-2 flex items-center gap-2" asp-controller="Reviews" asp-action="Index">
                                        <span class="material-symbols-outlined text-secondary text-[18px]">hotel_class</span>
                                        Đánh giá của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-lg text-xs font-semibold py-2 flex items-center gap-2" asp-controller="Services" asp-action="CustomerServices">
                                        <span class="material-symbols-outlined text-secondary text-[18px]">spa</span>
                                        Dịch vụ &amp; Tiện ích
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item rounded-lg text-xs font-semibold py-2 flex items-center gap-2" asp-controller="Profile" asp-action="Index">
                                    <span class="material-symbols-outlined text-secondary text-[18px]">person</span>
                                    Hồ sơ cá nhân
                                </a>
                            </li>
                            <li class="border-t border-outline-variant/60 my-1"></li>
                            <li>
                                <a class="dropdown-item rounded-lg text-xs font-semibold py-2 text-error flex items-center gap-2" asp-controller="Auth" asp-action="Logout">
                                    <span class="material-symbols-outlined text-error text-[18px]">logout</span>
                                    Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="px-3.5 py-2 text-xs sm:text-sm font-semibold text-on-surface hover:bg-surface-container rounded-lg transition-colors no-underline">
                        Đăng nhập
                    </a>
                    <a asp-controller="Auth" asp-action="Register" class="px-3.5 py-2 text-xs sm:text-sm font-semibold text-white bg-primary hover:bg-on-background rounded-lg shadow-sm transition-all no-underline">
                        Đăng ký
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- FLASH NOTIFICATIONS -->
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-2">
        @if (TempData["Success"] != null || TempData["AuthSuccess"] != null)
        {
            <div class="flex items-center justify-between p-4 mb-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 shadow-sm" role="alert">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-emerald-600 text-[22px]">check_circle</span>
                    <span class="text-sm font-medium">@(TempData["Success"] ?? TempData["AuthSuccess"])</span>
                </div>
                <button type="button" class="text-emerald-500 hover:text-emerald-700 p-1" onclick="this.parentElement.remove()">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
        }
        @if (TempData["Error"] != null || TempData["AuthError"] != null)
        {
            <div class="flex items-center justify-between p-4 mb-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 shadow-sm" role="alert">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-rose-600 text-[22px]">error</span>
                    <span class="text-sm font-medium">@(TempData["Error"] ?? TempData["AuthError"])</span>
                </div>
                <button type="button" class="text-rose-500 hover:text-rose-700 p-1" onclick="this.parentElement.remove()">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="flex items-center justify-between p-4 mb-4 rounded-xl bg-blue-50 border border-blue-200 text-blue-800 shadow-sm" role="alert">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-blue-600 text-[22px]">info</span>
                    <span class="text-sm font-medium">@TempData["Info"]</span>
                </div>
                <button type="button" class="text-blue-500 hover:text-blue-700 p-1" onclick="this.parentElement.remove()">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
        }
    </div>

    <!-- MAIN BODY CONTENT -->
    <main class="flex-grow w-full">
        @RenderBody()
    </main>

    <!-- STITCH EDITORIAL FOOTER -->
    <footer class="w-full bg-primary-container text-white pt-16 pb-8 mt-16 border-t border-surface-container-highest/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 pb-12 border-b border-surface-container-highest/10">
                <!-- Brand Bio -->
                <div class="lg:col-span-4 space-y-4">
                    <div class="flex flex-col">
                        <span class="font-bold text-xl tracking-[0.2em] uppercase text-white">AURA GRAND</span>
                        <span class="text-[11px] tracking-[0.3em] uppercase text-secondary-fixed font-semibold">Resort &amp; Spa • Sơn Trà, Đà Nẵng</span>
                    </div>
                    <p class="text-sm text-surface-variant/80 font-light leading-relaxed">
                        Tọa lạc tại vị trí biệt lập trên bán đảo Sơn Trà, Aura Grand Resort &amp; Spa hòa quyện tuyệt tác thiên nhiên rừng biển cùng chuẩn mực nghỉ dưỡng thượng lưu quốc tế.
                    </p>
                    <div class="flex items-center gap-3 pt-2">
                        <span class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-secondary transition-colors cursor-pointer"><i class="bi bi-facebook"></i></span>
                        <span class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-secondary transition-colors cursor-pointer"><i class="bi bi-instagram"></i></span>
                        <span class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-secondary transition-colors cursor-pointer"><i class="bi bi-youtube"></i></span>
                    </div>
                </div>

                <!-- Fast Links -->
                <div class="lg:col-span-2 space-y-3">
                    <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-secondary-fixed">Khám Phá</h4>
                    <ul class="space-y-2 text-sm text-surface-variant/80 list-none p-0">
                        <li><a asp-controller="Home" asp-action="Index" class="hover:text-white transition-colors no-underline">Trang chủ</a></li>
                        <li><a asp-controller="Rooms" asp-action="Search" class="hover:text-white transition-colors no-underline">Đặt phòng trực tuyến</a></li>
                        <li><a href="@(homeUrl + "#rooms")" class="hover:text-white transition-colors no-underline">Danh mục phòng</a></li>
                        <li><a href="@(homeUrl + "#services")" class="hover:text-white transition-colors no-underline">Ẩm thực &amp; Spa</a></li>
                    </ul>
                </div>

                <!-- Services -->
                <div class="lg:col-span-3 space-y-3">
                    <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-secondary-fixed">Dịch Vụ Nổi Bật</h4>
                    <ul class="space-y-2 text-sm text-surface-variant/80 list-none p-0">
                        <li><span class="flex items-center gap-2"><span class="material-symbols-outlined text-[16px] text-secondary-fixed">spa</span>Liệu trình Spa &amp; Trị liệu</span></li>
                        <li><span class="flex items-center gap-2"><span class="material-symbols-outlined text-[16px] text-secondary-fixed">restaurant</span>Ẩm thực chuẩn Michelin</span></li>
                        <li><span class="flex items-center gap-2"><span class="material-symbols-outlined text-[16px] text-secondary-fixed">directions_car</span>Đưa đón sân bay hạng sang</span></li>
                        <li><span class="flex items-center gap-2"><span class="material-symbols-outlined text-[16px] text-secondary-fixed">pool</span>Hồ bơi vô cực ngắm biển</span></li>
                    </ul>
                </div>

                <!-- Contact & Location -->
                <div class="lg:col-span-3 space-y-3">
                    <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-secondary-fixed">Liên Hệ &amp; Đặt Phòng</h4>
                    <div class="space-y-2 text-sm text-surface-variant/80">
                        <p class="flex items-start gap-2 m-0">
                            <span class="material-symbols-outlined text-[18px] text-secondary-fixed shrink-0">location_on</span>
                            <span>Bán đảo Sơn Trà, TP. Đà Nẵng, Việt Nam</span>
                        </p>
                        <p class="flex items-center gap-2 m-0">
                            <span class="material-symbols-outlined text-[18px] text-secondary-fixed shrink-0">call</span>
                            <a href="tel:0123456789" class="hover:text-white no-underline text-inherit">0123 456 789 (Hotline 24/7)</a>
                        </p>
                        <p class="flex items-center gap-2 m-0">
                            <span class="material-symbols-outlined text-[18px] text-secondary-fixed shrink-0">mail</span>
                            <a href="mailto:concierge@auragrand.vn" class="hover:text-white no-underline text-inherit">concierge@auragrand.vn</a>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Footer Bottom -->
            <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-surface-variant/60 gap-4">
                <p class="m-0">&copy; 2026 Aura Grand Resort &amp; Spa. Toàn bộ quyền sở hữu được bảo lưu.</p>
                <div class="flex items-center gap-4">
                    <span class="hover:text-white transition-colors cursor-pointer">Chính sách bảo mật</span>
                    <span>•</span>
                    <span class="hover:text-white transition-colors cursor-pointer">Điều khoản dịch vụ</span>
                    <span>•</span>
                    <a href="#top" class="hover:text-secondary-fixed transition-colors no-underline text-inherit flex items-center gap-1">
                        <span>Về đầu trang</span>
                        <span class="material-symbols-outlined text-[14px]">arrow_upward</span>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
