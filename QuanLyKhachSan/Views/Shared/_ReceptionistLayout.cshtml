@using System.Globalization
@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    string Active(string controller, string? action = null)
    {
        bool controllerMatched = string.Equals(
            currentController,
            controller,
            StringComparison.OrdinalIgnoreCase);
        bool actionMatched =
            string.IsNullOrWhiteSpace(action) ||
            string.Equals(
                currentAction,
                action,
                StringComparison.OrdinalIgnoreCase);
        return controllerMatched && actionMatched ? "bg-secondary text-white font-semibold shadow-sm" : "text-on-primary-container hover:bg-surface-container-highest/10 hover:text-white";
    }
    string receptionistName = User.FindFirst("FullName")?.Value
        ?? User.Identity?.Name ?? "Lễ tân";
    string receptionistInitial = string.IsNullOrWhiteSpace(receptionistName)
            ? "L" : receptionistName.Trim().Substring(0, 1).ToUpper();
    string pageTitle = ViewData["Title"]?.ToString() ?? "Bảng điều khiển lễ tân";
    string currentDate = DateTime.Now.ToString("dddd, dd/MM/yyyy", new CultureInfo("vi-VN"));
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Aura Grand PMS - Hệ thống nghiệp vụ lễ tân khách sạn" />
    <title>@pageTitle - Aura Grand Reception</title>
    
    <!-- Google Fonts & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cinzel:wght@500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <!-- Bootstrap 5 & Tailwind -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface": "#f8f9ff",
                        "surface-dim": "#cbdbf5",
                        "surface-bright": "#f8f9ff",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#eff4ff",
                        "surface-container": "#e5eeff",
                        "surface-container-high": "#dce9ff",
                        "surface-container-highest": "#d3e4fe",
                        "on-surface": "#0b1c30",
                        "on-surface-variant": "#45464d",
                        "primary": "#0f172a",
                        "on-primary": "#ffffff",
                        "primary-container": "#131b2e",
                        "on-primary-container": "#7c839b",
                        "secondary": "#725b38",
                        "on-secondary": "#ffffff",
                        "secondary-container": "#fedeb2",
                        "on-secondary-container": "#78603e",
                        "secondary-fixed": "#fedeb2",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "outline": "#76777d",
                        "outline-variant": "#e2e8f0"
                    },
                    fontFamily: {
                        sans: ["Plus Jakarta Sans", "sans-serif"]
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8f9ff; color: #0b1c30; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-surface text-on-surface antialiased flex">
    <!-- STITCH RECEPTIONIST SIDEBAR -->
    <aside id="sidebar" class="fixed left-0 top-0 h-screen w-72 bg-primary-container text-white shadow-xl z-50 flex flex-col justify-between overflow-y-auto transition-transform duration-300 -translate-x-full lg:translate-x-0">
        <div class="flex flex-col">
            <!-- Brand Header -->
            <div class="h-20 px-6 flex items-center justify-between border-b border-white/10">
                <a asp-controller="Home" asp-action="Dashboard" class="flex items-center gap-3 no-underline text-white">
                    <div class="w-10 h-10 rounded-xl bg-secondary flex items-center justify-center font-bold text-white shadow-sm">
                        <span class="material-symbols-outlined text-[22px]">desk</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-bold text-base tracking-tight leading-none text-white">AURA RECEPTION</span>
                        <span class="text-[10px] text-secondary-fixed tracking-wider uppercase mt-1">Front Desk Operations</span>
                    </div>
                </a>
                <button type="button" class="lg:hidden text-white/70 hover:text-white p-1" onclick="document.getElementById('sidebar').classList.add('-translate-x-full')">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>

            <!-- Profile Info Badge -->
            <div class="px-5 py-3">
                <div class="bg-white/5 border border-white/10 rounded-xl p-3 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span class="text-xs text-white font-semibold">Ca trực Lễ tân</span>
                    </div>
                    <span class="text-[10px] text-secondary-fixed px-2 py-0.5 rounded bg-white/10 font-bold">Live FrontDesk</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="px-3 space-y-4 py-2 text-sm">
                <!-- Group 1: Tổng quan -->
                <div class="space-y-1">
                    <div class="px-3 py-1 text-[11px] font-bold text-on-primary-container tracking-wider uppercase">Tổng quan</div>
                    <a asp-controller="Home" asp-action="Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all no-underline @Active("Home", "Dashboard")">
                        <span class="material-symbols-outlined text-[20px]">dashboard</span>
                        <span>Bảng điều khiển</span>
                    </a>
                </div>

                <!-- Group 2: Nghiệp vụ lưu trú -->
                <div class="space-y-1">
                    <div class="px-3 py-1 text-[11px] font-bold text-on-primary-container tracking-wider uppercase">Nghiệp vụ lưu trú</div>
                    <a asp-controller="Bookings" asp-action="Index" class="flex items-center justify-between px-3 py-2.5 rounded-xl transition-all no-underline @Active("Bookings")">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-[20px]">calendar_month</span>
                            <span>Quản lý Booking</span>
                        </div>
                        @if (ViewBag.PendingBookingCount is int pendingCount && pendingCount > 0)
                        {
                            <span class="px-2 py-0.5 rounded-full bg-secondary text-white text-[11px] font-bold">@pendingCount</span>
                        }
                    </a>
                    <a asp-controller="Rooms" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all no-underline @Active("Rooms")">
                        <span class="material-symbols-outlined text-[20px]">meeting_room</span>
                        <span>Tình trạng phòng</span>
                    </a>
                    <a asp-controller="RoomMiniBars" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all no-underline @Active("RoomMiniBars")">
                        <span class="material-symbols-outlined text-[20px]">liquor</span>
                        <span>Kiểm kê Minibar</span>
                    </a>
                </div>

                <!-- Group 3: Dịch vụ khách hàng -->
                <div class="space-y-1">
                    <div class="px-3 py-1 text-[11px] font-bold text-on-primary-container tracking-wider uppercase">Dịch vụ khách sạn</div>
                    <a asp-controller="Services" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all no-underline @Active("Services")">
                        <span class="material-symbols-outlined text-[20px]">spa</span>
                        <span>Danh mục dịch vụ</span>
                    </a>
                    <a asp-controller="ServiceBookings" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all no-underline @Active("ServiceBookings")">
                        <span class="material-symbols-outlined text-[20px]">room_service</span>
                        <span>Dịch vụ đã đặt</span>
                    </a>
                </div>

                <!-- Group 4: Tài chính & Thu ngân -->
                <div class="space-y-1">
                    <div class="px-3 py-1 text-[11px] font-bold text-on-primary-container tracking-wider uppercase">Tài chính &amp; Hóa đơn</div>
                    <a asp-controller="Invoices" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all no-underline @Active("Invoices")">
                        <span class="material-symbols-outlined text-[20px]">receipt_long</span>
                        <span>Quản lý Hóa đơn</span>
                    </a>
                    <a asp-controller="Payments" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all no-underline @Active("Payments")">
                        <span class="material-symbols-outlined text-[20px]">point_of_sale</span>
                        <span>Phiếu thu thanh toán</span>
                    </a>
                </div>
            </nav>
        </div>

        <!-- Sidebar Footer -->
        <div class="p-4 m-3 rounded-xl bg-white/5 border border-white/10 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-secondary text-white font-bold flex items-center justify-center text-sm shadow-sm">
                    @receptionistInitial
                </div>
                <div class="flex flex-col">
                    <span class="text-xs font-bold text-white truncate max-w-[120px]">@receptionistName</span>
                    <span class="text-[10px] text-secondary-fixed">Nhân viên lễ tân</span>
                </div>
            </div>
            <a asp-controller="Auth" asp-action="Logout" class="text-white/60 hover:text-error p-1.5 rounded-lg hover:bg-white/10 transition-colors" title="Đăng xuất">
                <span class="material-symbols-outlined text-[20px]">logout</span>
            </a>
        </div>
    </aside>

    <!-- MAIN WRAPPER -->
    <div class="flex-1 lg:pl-72 flex flex-col min-h-screen">
        <!-- TOPBAR -->
        <header class="h-20 bg-surface-container-lowest/90 backdrop-blur-xl border-b border-outline-variant sticky top-0 z-40 px-4 sm:px-8 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <button type="button" class="lg:hidden p-2 rounded-xl text-on-surface-variant hover:bg-surface-container-low transition-colors" onclick="document.getElementById('sidebar').classList.remove('-translate-x-full')">
                    <span class="material-symbols-outlined text-[24px]">menu</span>
                </button>
                <div class="hidden sm:flex flex-col">
                    <span class="text-[11px] font-bold text-secondary uppercase tracking-widest">Aura Grand Reception</span>
                    <h1 class="text-base font-bold text-on-surface m-0">@pageTitle</h1>
                </div>
            </div>

            <!-- Topbar Right Actions -->
            <div class="flex items-center gap-3">
                <div class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-low border border-outline-variant text-xs text-on-surface-variant">
                    <span class="material-symbols-outlined text-secondary text-[16px]">calendar_today</span>
                    <span class="capitalize">@currentDate</span>
                </div>

                <a asp-controller="Home" asp-action="Index" target="_blank" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-outline-variant text-xs font-semibold text-on-surface hover:bg-surface-container-low transition-colors no-underline">
                    <span class="material-symbols-outlined text-[16px]">public</span>
                    <span>Website</span>
                </a>

                <!-- Profile Dropdown -->
                <div class="dropdown">
                    <button class="flex items-center gap-2.5 p-1.5 rounded-xl bg-surface-container-low border border-outline-variant hover:bg-surface-container transition-all dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="w-8 h-8 rounded-lg bg-secondary text-white font-bold flex items-center justify-center text-xs shadow-sm">
                            @receptionistInitial
                        </div>
                        <span class="hidden sm:inline text-xs font-bold text-on-surface pr-1">@receptionistName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-xl rounded-xl border border-outline-variant p-2 min-w-[200px]">
                        <li class="px-3 py-2 border-b border-outline-variant/60 mb-1">
                            <p class="text-xs font-bold text-on-surface m-0">@receptionistName</p>
                            <p class="text-[11px] text-on-surface-variant m-0">@User.Identity?.Name</p>
                        </li>
                        <li>
                            <a class="dropdown-item rounded-lg text-xs font-semibold py-2 flex items-center gap-2" asp-controller="Profile" asp-action="Index">
                                <span class="material-symbols-outlined text-secondary text-[18px]">person</span>
                                Hồ sơ cá nhân
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item rounded-lg text-xs font-semibold py-2 text-error flex items-center gap-2" asp-controller="Auth" asp-action="Logout">
                                <span class="material-symbols-outlined text-error text-[18px]">logout</span>
                                Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- CONTENT BODY -->
        <main class="flex-1 p-4 sm:p-6 lg:p-8">
            <div class="max-w-7xl mx-auto w-full space-y-6">
                <!-- FLASH NOTIFICATIONS -->
                @if (TempData["Success"] != null)
                {
                    <div class="flex items-center justify-between p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 shadow-sm" role="alert">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-emerald-600 text-[22px]">check_circle</span>
                            <span class="text-sm font-medium">@TempData["Success"]</span>
                        </div>
                        <button type="button" class="text-emerald-500 hover:text-emerald-700 p-1" onclick="this.parentElement.remove()">
                            <span class="material-symbols-outlined text-[18px]">close</span>
                        </button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="flex items-center justify-between p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 shadow-sm" role="alert">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-rose-600 text-[22px]">error</span>
                            <span class="text-sm font-medium">@TempData["Error"]</span>
                        </div>
                        <button type="button" class="text-rose-500 hover:text-rose-700 p-1" onclick="this.parentElement.remove()">
                            <span class="material-symbols-outlined text-[18px]">close</span>
                        </button>
                    </div>
                }

                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>