@model QuanLyKhachSan.Models.Review
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Xóa đánh giá";
}

<div class="max-w-xl mx-auto">
    <div class="mb-6 flex items-center justify-between">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-[#0b1c30] transition-colors">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            Quay lại danh sách
        </a>
    </div>

    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-rose-100 overflow-hidden">
        <!-- Danger Header -->
        <div class="bg-rose-50 border-b border-rose-100 p-8 flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl">delete_forever</span>
            </div>
            <div>
                <h1 class="font-serif text-xl font-bold text-slate-900">Xác nhận xóa đánh giá</h1>
                <p class="text-sm text-slate-500 mt-1">Phòng @Model.Room?.RoomNumber - @Model.Room?.RoomType?.Name</p>
            </div>
        </div>

        <!-- Warning content -->
        <div class="p-8 space-y-6">
            <p class="text-sm text-slate-600 leading-relaxed">
                Quý khách có chắc chắn muốn xóa đánh giá này không? Hành động này sẽ không thể hoàn tác.
            </p>

            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 space-y-3">
                <div class="flex items-center gap-1">
                    @for (int star = 1; star <= 5; star++)
                    {
                        <span class="material-symbols-outlined text-xl @(star <= Model.Rating ? "text-amber-400 fill-current" : "text-slate-200")" style="font-variation-settings: 'FILL' @(star <= Model.Rating ? 1 : 0);">star</span>
                    }
                    <span class="text-xs font-bold text-slate-500 ml-2">(@Model.Rating/5)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Comment))
                {
                    <p class="text-xs text-slate-700 italic border-t border-slate-200/60 pt-2" style="white-space: pre-line;">"@Model.Comment"</p>
                }
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                @Html.AntiForgeryToken()
                <a asp-action="Index" class="px-6 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                    Không xóa
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold shadow-lg shadow-rose-600/20 transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg">delete</span>
                    Xác nhận xóa
                </button>
            </form>
        </div>
    </div>
</div>
