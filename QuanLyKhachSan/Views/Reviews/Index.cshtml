@model IEnumerable<QuanLyKhachSan.Models.Review>
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Đánh giá của tôi - Aura Grand Resort";
    var reviews = Model?.ToList() ?? new List<QuanLyKhachSan.Models.Review>();
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
                <span class="material-symbols-outlined text-[16px]">rate_review</span>
                <span>Trải nghiệm dịch vụ</span>
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-on-surface mt-1">
                Đánh Giá Của Tôi
            </h1>
            <p class="text-xs text-on-surface-variant mt-1">
                Chia sẻ ý kiến và đánh giá chất lượng phòng sau mỗi chuyến lưu trú tại Aura Grand Resort.
            </p>
        </div>
        <a asp-controller="Bookings" asp-action="MyBookings" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface hover:bg-surface-container-low text-xs font-bold shadow-sm transition-all no-underline">
            <span class="material-symbols-outlined text-[18px] text-secondary">calendar_month</span>
            <span>Booking của tôi</span>
        </a>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px]">check_circle</span>
                <span>@TempData["Success"]</span>
            </div>
            <button type="button" class="text-emerald-600 hover:text-emerald-800" onclick="this.parentElement.remove()">
                <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-rose-600 text-[18px]">error</span>
                <span>@TempData["Error"]</span>
            </div>
            <button type="button" class="text-rose-600 hover:text-rose-800" onclick="this.parentElement.remove()">
                <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
        </div>
    }

    <!-- Reviews Grid -->
    @if (reviews.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            @foreach (var item in reviews)
            {
                <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm p-5 flex flex-col justify-between hover:shadow-md transition-all">
                    <div class="space-y-3">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <span class="text-[11px] font-bold text-secondary uppercase tracking-wider block">Phòng @item.Room?.RoomNumber</span>
                                <h3 class="font-bold text-on-surface text-sm mt-0.5">@(item.Room?.RoomType?.Name ?? "Suite Cao Cấp")</h3>
                            </div>
                            <div class="flex items-center text-amber-500">
                                @for (int star = 1; star <= 5; star++)
                                {
                                    <span class="material-symbols-outlined text-[16px] @(star <= item.Rating ? "font-bold" : "text-slate-300")">star</span>
                                }
                            </div>
                        </div>

                        <p class="text-xs text-on-surface-variant bg-surface-container-low p-3.5 rounded-xl border border-outline-variant/40 italic leading-relaxed">
                            "@(string.IsNullOrWhiteSpace(item.Comment) ? "Đã gửi đánh giá sao." : item.Comment)"
                        </p>
                    </div>

                    <div class="mt-4 pt-3 border-t border-outline-variant/40 flex items-center justify-between text-[11px] text-outline">
                        <span>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        <div class="flex items-center gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="px-2.5 py-1 rounded-lg border border-outline-variant text-on-surface hover:bg-surface-container-low font-bold transition no-underline text-xs">
                                Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="px-2.5 py-1 rounded-lg border border-rose-200 text-rose-600 hover:bg-rose-50 font-bold transition no-underline text-xs">
                                Xóa
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 p-10 text-center shadow-sm max-w-md mx-auto">
            <div class="w-14 h-14 rounded-full bg-surface-container text-secondary flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-2xl">rate_review</span>
            </div>
            <h3 class="font-serif font-bold text-base text-on-surface">Chưa Có Đánh Giá Nào</h3>
            <p class="text-xs text-on-surface-variant mt-1 mb-5">Sau khi hoàn tất lưu trú và trả phòng, quý khách có thể gửi phản hồi trải nghiệm tại đây.</p>
            <a asp-controller="Bookings" asp-action="MyBookings" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-primary text-white text-xs font-bold shadow-md hover:bg-on-background transition no-underline">
                <span class="material-symbols-outlined text-[16px]">hotel</span>
                <span>Xem Booking Của Tôi</span>
            </a>
        </div>
    }
</div>
