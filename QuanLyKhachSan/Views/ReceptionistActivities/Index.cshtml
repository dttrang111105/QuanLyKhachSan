@model QuanLyKhachSan.ViewModels.ReceptionistActivityViewModel

@{
    ViewData["Title"] = "Theo dõi hoạt động lễ tân";
    Layout = "_AdminLayout";

    string ActionBadge(string actionType)
    {
        return actionType switch
        {
            "CreateBooking" => "bg-blue-50 text-blue-700 border-blue-200",
            "CheckIn" => "bg-emerald-50 text-emerald-700 border-emerald-200",
            "CheckOut" => "bg-slate-100 text-slate-800 border-slate-200",
            "Payment" => "bg-amber-50 text-amber-800 border-amber-200",
            "CancelBooking" => "bg-rose-50 text-rose-700 border-rose-200",
            _ => "bg-surface-container text-on-surface border-outline-variant"
        };
    }
}

<div class="space-y-6">
    <!-- Header -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
                <span class="material-symbols-outlined text-[16px]">history_edu</span>
                <span>Giám sát &amp; Kiểm toán</span>
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-on-surface mt-1">Nhật Ký Ca Trực Lễ Tân</h1>
            <p class="text-xs text-on-surface-variant mt-1">
                Thống kê thao tác nghiệp vụ, kiểm soát doanh thu từng nhân viên theo ca trực và đối soát minh bạch.
            </p>
        </div>
        <div>
            <a asp-action="ExportExcel"
               asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
               asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
               asp-route-employeeId="@Model.EmployeeId"
               asp-route-actionType="@Model.ActionType"
               class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-primary text-white hover:bg-on-background text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[18px]">download</span>
                <span>Xuất Báo Cáo Excel</span>
            </a>
        </div>
    </header>

    @if (TempData["Error"] != null)
    {
        <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center gap-2">
            <span class="material-symbols-outlined text-rose-600">error</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Filter Form -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 p-4 sm:p-5 shadow-sm">
        <form method="get" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-end">
            <div>
                <label for="fromDate" class="block text-xs font-bold text-outline uppercase tracking-wider mb-1.5">Từ ngày</label>
                <input id="fromDate" name="fromDate" type="date" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="w-full h-10 px-3 bg-surface-container-low border border-outline-variant rounded-xl text-xs font-medium text-on-surface focus:outline-none focus:border-secondary" />
            </div>

            <div>
                <label for="toDate" class="block text-xs font-bold text-outline uppercase tracking-wider mb-1.5">Đến ngày</label>
                <input id="toDate" name="toDate" type="date" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="w-full h-10 px-3 bg-surface-container-low border border-outline-variant rounded-xl text-xs font-medium text-on-surface focus:outline-none focus:border-secondary" />
            </div>

            <div>
                <label for="employeeId" class="block text-xs font-bold text-outline uppercase tracking-wider mb-1.5">Nhân viên lễ tân</label>
                <select id="employeeId" name="employeeId" class="w-full h-10 px-3 bg-surface-container-low border border-outline-variant rounded-xl text-xs font-medium text-on-surface focus:outline-none focus:border-secondary">
                    <option value="">Tất cả nhân viên</option>
                    @foreach (var employee in Model.Employees)
                    {
                        <option value="@employee.EmployeeId" selected="@(Model.EmployeeId == employee.EmployeeId)">@employee.EmployeeName</option>
                    }
                </select>
            </div>

            <div>
                <label for="actionType" class="block text-xs font-bold text-outline uppercase tracking-wider mb-1.5">Loại nghiệp vụ</label>
                <select id="actionType" name="actionType" class="w-full h-10 px-3 bg-surface-container-low border border-outline-variant rounded-xl text-xs font-medium text-on-surface focus:outline-none focus:border-secondary">
                    <option value="">Tất cả hoạt động</option>
                    <option value="CreateBooking" selected="@(Model.ActionType == "CreateBooking")">Tạo Booking</option>
                    <option value="CheckIn" selected="@(Model.ActionType == "CheckIn")">Check In</option>
                    <option value="CheckOut" selected="@(Model.ActionType == "CheckOut")">Check Out</option>
                    <option value="Payment" selected="@(Model.ActionType == "Payment")">Thu tiền</option>
                    <option value="CancelBooking" selected="@(Model.ActionType == "CancelBooking")">Hủy Booking</option>
                </select>
            </div>

            <div class="flex gap-2">
                <button type="submit" class="flex-1 h-10 inline-flex items-center justify-center gap-1.5 bg-secondary text-white rounded-xl text-xs font-bold shadow-sm hover:bg-secondary/90 transition">
                    <span class="material-symbols-outlined text-[16px]">filter_alt</span>
                    <span>Lọc</span>
                </button>
                <a asp-action="Index" class="h-10 px-3 inline-flex items-center justify-center bg-surface-container-low text-on-surface-variant hover:bg-surface-container rounded-xl text-xs font-bold transition no-underline">
                    Đặt lại
                </a>
            </div>
        </form>
    </div>

    <!-- 4 KPI Metrics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tổng thao tác</span>
                <div class="text-2xl font-bold text-on-surface mt-1">@Model.TotalActivities</div>
                <span class="text-[11px] text-on-surface-variant font-medium">Bản ghi trong giai đoạn</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">history</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Lượt Check-in/out</span>
                <div class="text-2xl font-bold text-emerald-600 mt-1">@(Model.CheckInCount + Model.CheckOutCount)</div>
                <span class="text-[11px] text-emerald-700 font-semibold">@Model.CheckInCount vào • @Model.CheckOutCount ra</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">key</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Giao dịch thu tiền</span>
                <div class="text-2xl font-bold text-amber-600 mt-1">@Model.PaymentCount</div>
                <span class="text-[11px] text-amber-700 font-semibold">Phiếu thu hoàn tất</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">payments</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tổng tiền thu được</span>
                <div class="text-xl font-bold text-secondary mt-1">@Model.TotalRevenue.ToString("N0") <small class="text-xs text-on-surface-variant font-normal">đ</small></div>
                <span class="text-[11px] text-on-surface-variant font-medium">Doanh số ca trực</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-secondary-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">account_balance_wallet</span>
            </div>
        </div>
    </div>

    <!-- Staff Summary Breakdown -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-outline-variant/40">
            <span class="text-xs font-bold text-secondary uppercase tracking-wider">Hiệu suất nhân sự</span>
            <h2 class="text-base font-bold text-on-surface">Tổng Hợp Theo Nhân Viên Lễ Tân</h2>
        </div>
        @if (Model.Summaries.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-surface-container-low text-on-surface-variant font-semibold uppercase text-[10px] tracking-wider border-b border-outline-variant/40">
                        <tr>
                            <th class="py-3 px-4">Nhân Viên</th>
                            <th class="py-3 px-4 text-center">Tạo Booking</th>
                            <th class="py-3 px-4 text-center">Check-in</th>
                            <th class="py-3 px-4 text-center">Check-out</th>
                            <th class="py-3 px-4 text-center">Lượt Thu</th>
                            <th class="py-3 px-4 text-right">Tổng Tiền Thu</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/30 text-on-surface font-medium">
                        @foreach (var emp in Model.Summaries)
                        {
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3.5 px-4 font-bold text-on-surface">
                                    <div class="flex items-center gap-2">
                                        <div class="w-7 h-7 rounded-lg bg-surface-container text-secondary flex items-center justify-center font-bold text-xs">
                                            @(string.IsNullOrWhiteSpace(emp.EmployeeName) ? "L" : emp.EmployeeName.Substring(0, 1).ToUpper())
                                        </div>
                                        <span>@emp.EmployeeName</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-center font-semibold">@emp.CreateBookingCount</td>
                                <td class="py-3.5 px-4 text-center font-semibold text-emerald-600">@emp.CheckInCount</td>
                                <td class="py-3.5 px-4 text-center font-semibold text-slate-700">@emp.CheckOutCount</td>
                                <td class="py-3.5 px-4 text-center font-semibold text-amber-700">@emp.PaymentCount</td>
                                <td class="py-3.5 px-4 text-right font-bold text-secondary">
                                    @emp.RevenueAmount.ToString("N0") <span class="text-[10px] text-outline font-normal">đ</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-8 text-center text-on-surface-variant text-xs">
                Không có dữ liệu nhân viên trong khoảng thời gian này
            </div>
        }
    </div>

    <!-- Detailed Activity Logs Table -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-outline-variant/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <span class="text-xs font-bold text-secondary uppercase tracking-wider">Lịch sử sự kiện</span>
                <h2 class="text-base font-bold text-on-surface">Chi Tiết Nhật Ký Thao Tác (@Model.Activities.Count)</h2>
            </div>
        </div>

        @if (Model.Activities.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-surface-container-low text-on-surface-variant font-semibold uppercase text-[10px] tracking-wider border-b border-outline-variant/40">
                        <tr>
                            <th class="py-3 px-4">Thời Gian</th>
                            <th class="py-3 px-4">Nhân Viên</th>
                            <th class="py-3 px-4">Hành Động</th>
                            <th class="py-3 px-4">Mô Tả Chi Tiết</th>
                            <th class="py-3 px-4 text-right">Số Tiền</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/30 text-on-surface font-medium">
                        @foreach (var act in Model.Activities)
                        {
                            decimal? amt = act.PaymentAmount ?? act.InvoiceTotalAmount;
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3.5 px-4 text-on-surface-variant">
                                    @act.ActionTime.ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                                <td class="py-3.5 px-4 font-bold text-on-surface">
                                    @act.EmployeeName
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold border @ActionBadge(act.ActionType)">
                                        @act.ActionLabel
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-on-surface">
                                    @act.Description
                                </td>
                                <td class="py-3.5 px-4 text-right font-bold text-secondary">
                                    @(amt.HasValue && amt.Value > 0 ? amt.Value.ToString("N0") + " đ" : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-10 text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-4xl text-outline mb-2">history_toggle_off</span>
                <p class="text-sm font-semibold">Không có hoạt động nào được ghi nhận theo bộ lọc</p>
            </div>
        }
    </div>
</div>
