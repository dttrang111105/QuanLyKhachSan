@model QuanLyKhachSan.ViewModels.StaffBookServiceViewModel
@{
    bool isAdmin = User.IsInRole("Admin");
    bool hasBookings = Model.ActiveBookings != null && Model.ActiveBookings.Any();
    bool hasServices = Model.AvailableServices != null && Model.AvailableServices.Any();
    Layout = isAdmin
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";
    ViewData["Title"] = "Đặt dịch vụ cho khách";
}

<div class="max-w-3xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
                <a asp-action="Index" class="hover:underline text-secondary no-underline">Quản lý dịch vụ</a>
                <span class="text-outline">/</span>
                <span class="text-on-surface">Order dịch vụ</span>
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-on-surface mt-1">Ghi Nhận Dịch Vụ Cho Khách</h1>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface hover:bg-surface-container-low text-xs font-bold shadow-sm transition-all no-underline">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>Danh sách dịch vụ</span>
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center gap-2">
            <span class="material-symbols-outlined text-rose-600">error</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Main Card Form -->
    <div class="bg-surface-container-lowest p-6 sm:p-8 rounded-2xl border border-outline-variant/60 shadow-sm space-y-6">
        <div class="flex items-center gap-3 pb-4 border-b border-outline-variant/40">
            <div class="w-10 h-10 rounded-xl bg-surface-container text-secondary flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-[22px]">room_service</span>
            </div>
            <div>
                <h2 class="text-base font-bold text-on-surface">Thông Tin Đặt Dịch Vụ</h2>
                <p class="text-xs text-on-surface-variant">Chi phí dịch vụ sẽ được hạch toán trực tiếp vào hóa đơn của phòng tương ứng.</p>
            </div>
        </div>

        @if (!hasBookings)
        {
            <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs flex items-center gap-2">
                <span class="material-symbols-outlined text-amber-600 text-[20px]">warning</span>
                <span>Hiện không có khách nào đang nhận phòng (Checked-in) trong hệ thống.</span>
            </div>
        }
        @if (!hasServices)
        {
            <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs flex items-center gap-2">
                <span class="material-symbols-outlined text-amber-600 text-[20px]">warning</span>
                <span>Hiện không có dịch vụ nào đang ở trạng thái hoạt động.</span>
            </div>
        }

        <form asp-controller="Services" asp-action="StaffBookService" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs"></div>
            }

            <div>
                <label asp-for="BookingId" class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-2">
                    Booking / Khách đang lưu trú <span class="text-rose-600">*</span>
                </label>
                <select asp-for="BookingId" asp-items="Model.ActiveBookings"
                        class="w-full h-11 px-3.5 bg-surface-container-low border border-outline-variant rounded-xl text-xs font-medium text-on-surface focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-all">
                    <option value="">-- Chọn booking &amp; số phòng của khách --</option>
                </select>
                <span asp-validation-for="BookingId" class="text-rose-600 text-[11px] mt-1 block"></span>
                <p class="text-[11px] text-outline mt-1">Lọc danh sách các booking có trạng thái Đang lưu trú.</p>
            </div>

            <div>
                <label asp-for="ServiceId" class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-2">
                    Dịch vụ yêu cầu <span class="text-rose-600">*</span>
                </label>
                <select asp-for="ServiceId" asp-items="Model.AvailableServices"
                        class="w-full h-11 px-3.5 bg-surface-container-low border border-outline-variant rounded-xl text-xs font-medium text-on-surface focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-all">
                    <option value="">-- Chọn dịch vụ trong menu --</option>
                </select>
                <span asp-validation-for="ServiceId" class="text-rose-600 text-[11px] mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Quantity" class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-2">
                    Số lượng <span class="text-rose-600">*</span>
                </label>
                <input asp-for="Quantity" type="number" min="1" max="100"
                       class="w-40 h-11 px-3.5 bg-surface-container-low border border-outline-variant rounded-xl text-xs font-bold text-on-surface focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-all" />
                <span asp-validation-for="Quantity" class="text-rose-600 text-[11px] mt-1 block"></span>
            </div>

            <div class="p-3.5 rounded-xl bg-blue-50 border border-blue-200 text-blue-800 text-xs flex items-center gap-2">
                <span class="material-symbols-outlined text-blue-600 text-[18px]">info</span>
                <span>Nếu dịch vụ đã tồn tại trong booking, hệ thống sẽ tự động tăng số lượng và cập nhật bảng kê.</span>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-outline-variant/40">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-outline-variant text-xs font-bold text-on-surface hover:bg-surface-container-low transition no-underline">
                    Hủy bỏ
                </a>
                @if (hasBookings && hasServices)
                {
                    <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary text-white text-xs font-bold hover:bg-on-background shadow-md transition">
                        Xác Nhận Đặt Dịch Vụ
                    </button>
                }
                else
                {
                    <button type="button" disabled class="px-6 py-2.5 rounded-xl bg-surface-container text-outline text-xs font-bold cursor-not-allowed">
                        Xác Nhận Đặt Dịch Vụ
                    </button>
                }
            </div>
        </form>
    </div>
</div>
