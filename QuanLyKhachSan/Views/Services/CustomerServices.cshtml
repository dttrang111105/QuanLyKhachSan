@model IEnumerable<QuanLyKhachSan.Models.Service>
@{
    ViewData["Title"] = "Dịch vụ & Trải nghiệm - Aura Grand Resort";
    Layout = "_CustomerLayout";
    var services = Model?.ToList() ?? new List<QuanLyKhachSan.Models.Service>();

    string GetServiceIcon(string? category)
    {
        return category?.Trim().ToLower() switch
        {
            "ăn uống" or "f&b" or "ẩm thực" => "restaurant",
            "chăm sóc" or "spa" or "massage" => "spa",
            "giải trí" or "tour" => "sports_gymnastics",
            "tiện ích" or "xe" or "di chuyển" => "airport_shuttle",
            "giặt là" or "laundry" => "local_laundry_service",
            _ => "room_service"
        };
    }
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Header Banner -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-container text-secondary text-xs font-bold uppercase tracking-widest">
            <span class="material-symbols-outlined text-[16px]">spa</span>
            <span>Trải Nghiệm Đẳng Cấp 5 Sao</span>
        </div>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-on-surface tracking-tight">
            Dịch Vụ &amp; Trải Nghiệm Thượng Lưu
        </h1>
        <p class="text-sm text-on-surface-variant leading-relaxed">
            Thưởng thức tinh hoa ẩm thực, tái tạo năng lượng với liệu trình Spa chuyên sâu và tận hưởng chuỗi tiện ích độc quyền được chuẩn hóa chuẩn quốc tế tại Aura Grand Resort.
        </p>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-2xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm">
        <div class="flex flex-wrap items-center gap-2" id="categoryFilterButtons">
            <button type="button" data-category="" class="cat-btn px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white transition-all">
                Tất cả dịch vụ (@services.Count)
            </button>
            <button type="button" data-category="ăn uống" class="cat-btn px-4 py-2 rounded-xl text-xs font-bold bg-surface-container-low text-on-surface-variant hover:bg-surface-container transition-all">
                Ẩm thực &amp; Bar
            </button>
            <button type="button" data-category="chăm sóc" class="cat-btn px-4 py-2 rounded-xl text-xs font-bold bg-surface-container-low text-on-surface-variant hover:bg-surface-container transition-all">
                Spa &amp; Trị liệu
            </button>
            <button type="button" data-category="giải trí" class="cat-btn px-4 py-2 rounded-xl text-xs font-bold bg-surface-container-low text-on-surface-variant hover:bg-surface-container transition-all">
                Tour &amp; Giải trí
            </button>
            <button type="button" data-category="tiện ích" class="cat-btn px-4 py-2 rounded-xl text-xs font-bold bg-surface-container-low text-on-surface-variant hover:bg-surface-container transition-all">
                Tiện ích &amp; Xe
            </button>
        </div>
        <div class="relative w-full sm:w-72">
            <input type="text" id="customerServiceSearch" placeholder="Tìm kiếm dịch vụ..."
                   class="w-full h-10 pl-9 pr-4 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary transition-all" />
            <span class="material-symbols-outlined text-[18px] text-outline absolute left-2.5 top-1/2 -translate-y-1/2">search</span>
        </div>
    </div>

    <!-- Services Grid -->
    @if (services.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="servicesGrid">
            @foreach (var s in services)
            {
                string icon = GetServiceIcon(s.Category);
                string searchContent = $"{s.ServiceName} {s.Category} {s.Description}".ToLower();

                <div class="service-card flex flex-col justify-between bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden group hover:-translate-y-1"
                     data-category="@(s.Category?.ToLower() ?? "")" data-search="@searchContent">
                    <!-- Top Visual Header -->
                    <div class="relative h-44 bg-gradient-to-br from-primary-container to-[#282015] p-6 flex flex-col justify-between overflow-hidden">
                        <div class="absolute -right-8 -bottom-8 w-36 h-36 rounded-full border border-white/10 opacity-30 pointer-events-none"></div>
                        <div class="flex items-center justify-between z-10">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-white/10 text-secondary-fixed backdrop-blur-sm border border-white/10">
                                @(string.IsNullOrWhiteSpace(s.Category) ? "Dịch Vụ Resort" : s.Category)
                            </span>
                            @if (s.IsAvailable)
                            {
                                <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-400">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Sẵn sàng
                                </span>
                            }
                            else
                            {
                                <span class="text-[11px] font-semibold text-rose-400">Tạm dừng</span>
                            }
                        </div>
                        <div class="flex items-end justify-between z-10">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-secondary-container to-secondary text-primary-container flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                                <span class="material-symbols-outlined text-[28px]">@icon</span>
                            </div>
                            <div class="text-right">
                                <span class="text-[10px] text-white/60 block uppercase">Giá trọn gói</span>
                                <span class="text-xl font-bold font-serif text-secondary-fixed">@s.Price.ToString("N0") <small class="text-xs font-normal">đ</small></span>
                            </div>
                        </div>
                    </div>

                    <!-- Body Content -->
                    <div class="p-6 flex flex-col flex-grow justify-between space-y-4">
                        <div class="space-y-2">
                            <h3 class="font-serif text-xl font-bold text-on-surface group-hover:text-secondary transition-colors">
                                @s.ServiceName
                            </h3>
                            <p class="text-xs text-on-surface-variant leading-relaxed line-clamp-3">
                                @(string.IsNullOrWhiteSpace(s.Description) ? "Dịch vụ cao cấp phục vụ bởi đội ngũ chuyên nghiệp tiêu chuẩn 5 sao." : s.Description)
                            </p>
                        </div>

                        <!-- Action Button -->
                        <div class="pt-4 border-t border-outline-variant/40">
                            @if (s.IsAvailable)
                            {
                                <a asp-controller="Services" asp-action="BookService" asp-route-id="@s.Id"
                                   class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-gradient-to-r from-secondary to-primary-container text-white text-xs font-bold shadow-md hover:shadow-lg hover:opacity-95 transition-all no-underline">
                                    <span class="material-symbols-outlined text-[16px]">calendar_add_on</span>
                                    <span>Đặt Dịch Vụ Ngay</span>
                                </a>
                            }
                            else
                            {
                                <button disabled class="w-full py-3 px-4 rounded-xl bg-surface-container text-outline text-xs font-bold cursor-not-allowed">
                                    Tạm Dừng Phục Vụ
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 p-12 text-center text-on-surface-variant shadow-sm">
            <span class="material-symbols-outlined text-5xl text-outline mb-3">spa</span>
            <h3 class="font-serif text-lg font-bold text-on-surface">Chưa Có Dịch Vụ Nào</h3>
            <p class="text-xs text-on-surface-variant max-w-md mx-auto mt-1">
                Các gói dịch vụ và trải nghiệm đang được chuẩn bị và cập nhật.
            </p>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('customerServiceSearch');
            const catButtons = document.querySelectorAll('.cat-btn');
            const cards = document.querySelectorAll('.service-card');
            let activeCategory = '';

            function filterCards() {
                const query = (searchInput?.value || '').toLowerCase().trim();

                cards.forEach(card => {
                    const cardSearch = (card.getAttribute('data-search') || '').toLowerCase();
                    const cardCat = (card.getAttribute('data-category') || '').toLowerCase();

                    const matchesQuery = !query || cardSearch.includes(query);
                    const matchesCategory = !activeCategory || cardCat.includes(activeCategory);

                    card.style.display = (matchesQuery && matchesCategory) ? '' : 'none';
                });
            }

            catButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    catButtons.forEach(b => {
                        b.classList.remove('bg-primary', 'text-white');
                        b.classList.add('bg-surface-container-low', 'text-on-surface-variant');
                    });
                    this.classList.remove('bg-surface-container-low', 'text-on-surface-variant');
                    this.classList.add('bg-primary', 'text-white');

                    activeCategory = (this.getAttribute('data-category') || '').toLowerCase();
                    filterCards();
                });
            });

            if (searchInput) searchInput.addEventListener('input', filterCards);
        });
    </script>
}