@model QuanLyKhachSan.ViewModels.CustomerBookServiceViewModel
@{
    ViewData["Title"] = "Đặt dịch vụ - " + Model.ServiceName;
    Layout = "_CustomerLayout";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 space-y-6">
    <!-- Breadcrumb & Title -->
    <div>
        <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
            <a asp-action="CustomerServices" class="hover:underline text-secondary no-underline">Dịch vụ</a>
            <span class="text-outline">/</span>
            <span class="text-on-surface">Đặt dịch vụ</span>
        </div>
        <h1 class="font-serif text-2xl sm:text-3xl font-bold text-on-surface mt-1">Đăng Ký Sử Dụng Dịch Vụ</h1>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center gap-2">
            <span class="material-symbols-outlined text-rose-600">error</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
        <!-- Service Preview Card -->
        <div class="md:col-span-5 bg-gradient-to-br from-primary-container to-[#282015] text-white p-6 rounded-2xl shadow-xl space-y-6">
            <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-white/10 text-secondary-fixed border border-white/10">
                    Aura Resort Service
                </span>
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-secondary-container to-secondary text-primary-container flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">room_service</span>
                </div>
            </div>

            <div>
                <h2 class="font-serif text-2xl font-bold text-secondary-fixed">@Model.ServiceName</h2>
                <p class="text-xs text-white/70 mt-2 leading-relaxed">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Dịch vụ tiện ích thượng lưu phục vụ theo yêu cầu của quý khách." : Model.Description)
                </p>
            </div>

            <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-1">
                <span class="text-[10px] text-white/60 uppercase block">Đơn giá niêm yết</span>
                <div class="text-2xl font-bold font-serif text-secondary-fixed">@Model.Price.ToString("N0") <small class="text-xs text-white/80 font-normal">VNĐ</small></div>
            </div>

            <div class="space-y-2 text-xs text-white/80">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary-fixed text-[16px]">verified</span>
                    <span>Phục vụ tận phòng / khuôn viên</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary-fixed text-[16px]">receipt</span>
                    <span>Cộng dồn vào hóa đơn quyết toán</span>
                </div>
            </div>
        </div>

        <!-- Booking Form -->
        <div class="md:col-span-7 bg-surface-container-lowest p-6 sm:p-8 rounded-2xl border border-outline-variant/60 shadow-sm space-y-6">
            @if (Model.ActiveBookings == null || !Model.ActiveBookings.Any())
            {
                <div class="p-6 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 space-y-3 text-center">
                    <span class="material-symbols-outlined text-4xl text-amber-600">hotel</span>
                    <h3 class="font-bold text-sm">Chưa Có Phòng Đang Nhận</h3>
                    <p class="text-xs text-amber-700 max-w-sm mx-auto">
                        Quý khách chỉ có thể đặt dịch vụ khi đang lưu trú (Booking có trạng thái <strong>Đang lưu trú - CheckedIn</strong>).
                    </p>
                    <div class="pt-2 flex justify-center gap-2">
                        <a asp-action="CustomerServices" class="px-4 py-2 rounded-xl border border-outline-variant text-xs font-semibold hover:bg-white transition no-underline">
                            Quay lại dịch vụ
                        </a>
                        <a asp-controller="Bookings" asp-action="MyBookings" class="px-4 py-2 rounded-xl bg-secondary text-white text-xs font-bold shadow-sm transition no-underline">
                            Xem Booking của tôi
                        </a>
                    </div>
                </div>
            }
            else
            {
                <form asp-controller="Services" asp-action="BookService" method="post" class="space-y-5">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs"></div>
                    <input asp-for="ServiceId" type="hidden" />

                    <div>
                        <label asp-for="BookingId" class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-2">
                            Phòng đang lưu trú <span class="text-rose-600">*</span>
                        </label>
                        <select asp-for="BookingId" asp-items="Model.ActiveBookings"
                                class="w-full h-11 px-3.5 bg-surface-container-low border border-outline-variant rounded-xl text-xs font-medium text-on-surface focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-all">
                            <option value="">-- Chọn phòng / Booking đang ở --</option>
                        </select>
                        <span asp-validation-for="BookingId" class="text-rose-600 text-[11px] mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Quantity" class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-2">
                            Số lượng dịch vụ <span class="text-rose-600">*</span>
                        </label>
                        <div class="flex items-center w-44 border border-outline-variant rounded-xl overflow-hidden bg-surface-container-low">
                            <button type="button" id="decreaseQuantity" class="w-11 h-11 flex items-center justify-center text-on-surface hover:bg-surface-container transition">
                                <span class="material-symbols-outlined text-[18px]">remove</span>
                            </button>
                            <input asp-for="Quantity" type="number" min="1" max="100" id="serviceQuantity"
                                   class="w-full h-11 text-center bg-transparent border-none text-xs font-bold text-on-surface focus:outline-none" />
                            <button type="button" id="increaseQuantity" class="w-11 h-11 flex items-center justify-center text-on-surface hover:bg-surface-container transition">
                                <span class="material-symbols-outlined text-[18px]">add</span>
                            </button>
                        </div>
                        <span asp-validation-for="Quantity" class="text-rose-600 text-[11px] mt-1 block"></span>
                    </div>

                    <!-- Total Estimator -->
                    <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant/60 space-y-2 text-xs">
                        <div class="flex justify-between text-on-surface-variant">
                            <span>Đơn giá:</span>
                            <span class="font-semibold text-on-surface">@Model.Price.ToString("N0") đ</span>
                        </div>
                        <div class="flex justify-between text-on-surface-variant">
                            <span>Số lượng:</span>
                            <span class="font-semibold text-on-surface" id="qtyPreview">1</span>
                        </div>
                        <div class="pt-2 border-t border-outline-variant/40 flex justify-between font-bold text-sm text-on-surface">
                            <span>Thành tiền dự kiến:</span>
                            <span class="text-secondary font-serif text-base" id="estimatedTotal">@Model.Price.ToString("N0") VNĐ</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-end gap-3 pt-2">
                        <a asp-action="CustomerServices" class="px-5 py-2.5 rounded-xl border border-outline-variant text-xs font-bold text-on-surface hover:bg-surface-container-low transition no-underline">
                            Hủy bỏ
                        </a>
                        <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary text-white text-xs font-bold hover:bg-on-background shadow-md transition">
                            Xác Nhận Đặt Dịch Vụ
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const price = @Model.Price;
            const qtyInput = document.getElementById('serviceQuantity');
            const qtyPreview = document.getElementById('qtyPreview');
            const totalPreview = document.getElementById('estimatedTotal');
            const btnDec = document.getElementById('decreaseQuantity');
            const btnInc = document.getElementById('increaseQuantity');

            function updateTotal() {
                let q = parseInt(qtyInput.value) || 1;
                if (q < 1) q = 1;
                qtyInput.value = q;
                if (qtyPreview) qtyPreview.textContent = q;
                if (totalPreview) {
                    totalPreview.textContent = (q * price).toLocaleString('vi-VN') + ' VNĐ';
                }
            }

            if (btnDec) {
                btnDec.addEventListener('click', function () {
                    let q = parseInt(qtyInput.value) || 1;
                    if (q > 1) {
                        qtyInput.value = q - 1;
                        updateTotal();
                    }
                });
            }

            if (btnInc) {
                btnInc.addEventListener('click', function () {
                    let q = parseInt(qtyInput.value) || 1;
                    qtyInput.value = q + 1;
                    updateTotal();
                });
            }

            if (qtyInput) {
                qtyInput.addEventListener('input', updateTotal);
            }
        });
    </script>
}