@model IEnumerable<QuanLyKhachSan.Models.Service>
@using QuanLyKhachSan.Models
@{
    bool isAdmin = User.IsInRole("Admin");
    bool isReceptionist = User.IsInRole("Receptionist");
    Layout = isAdmin
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";

    ViewData["Title"] = "Quản lý dịch vụ & Spa";
    List<Service> services = Model?.ToList() ?? new List<Service>();
    int totalServices = services.Count;
    int availableServices = services.Count(s => s.IsAvailable);
    int unavailableServices = services.Count(s => !s.IsAvailable);
    decimal averagePrice = services.Any() ? services.Average(s => s.Price) : 0;
    
    var categories = services
        .Where(s => !string.IsNullOrWhiteSpace(s.Category))
        .Select(s => s.Category!)
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    string GetServiceIcon(string? category)
    {
        return category?.Trim().ToLower() switch
        {
            "ăn uống" or "f&b" or "ẩm thực" => "restaurant",
            "chăm sóc" or "spa" or "massage" => "spa",
            "giải trí" or "tour" => "sports_gymnastics",
            "tiện ích" or "xe" or "di chuyển" => "airport_shuttle",
            "giặt là" or "laundry" => "local_laundry_service",
            _ => "room_service"
        };
    }
}

<div class="space-y-6">
    <!-- Header: Title & Actions -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
                <span class="material-symbols-outlined text-[16px]">spa</span>
                <span>Dịch Vụ &amp; Trải Nghiệm</span>
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-on-surface mt-1">Danh Mục Dịch Vụ &amp; Spa</h1>
            <p class="text-xs text-on-surface-variant mt-1">
                Điều phối danh mục F&amp;B, Spa trị liệu, Tour tham quan và dịch vụ tiện ích của resort.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-controller="Services" asp-action="StaffBookService"
               class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface hover:bg-surface-container-low text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[18px] text-secondary">add_shopping_cart</span>
                <span>Đặt Dịch Vụ Cho Khách</span>
            </a>
            <a asp-controller="ServiceBookings" asp-action="Index"
               class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface hover:bg-surface-container-low text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[18px]">list_alt</span>
                <span>Lịch Đặt Dịch Vụ</span>
            </a>
            <a asp-controller="Services" asp-action="Create"
               class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-primary text-white hover:bg-on-background text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span>+ Thêm Dịch Vụ</span>
            </a>
        </div>
    </header>

    <!-- KPI Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tổng dịch vụ</span>
                <div class="text-2xl font-bold text-on-surface mt-1">@totalServices</div>
                <span class="text-[11px] text-on-surface-variant">@categories.Count nhóm dịch vụ</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-surface-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">room_service</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Đang phục vụ</span>
                <div class="text-2xl font-bold text-emerald-600 mt-1">@availableServices</div>
                <span class="text-[11px] text-emerald-700 font-semibold">Sẵn sàng nhận khách</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">check_circle</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tạm dừng</span>
                <div class="text-2xl font-bold text-rose-600 mt-1">@unavailableServices</div>
                <span class="text-[11px] text-rose-700 font-semibold">Tạm ngưng nhận lịch</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">block</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Đơn giá TB</span>
                <div class="text-xl font-bold text-secondary mt-1">@averagePrice.ToString("N0") <small class="text-xs text-on-surface-variant font-normal">đ</small></div>
                <span class="text-[11px] text-on-surface-variant">Trên toàn danh mục</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-secondary-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">payments</span>
            </div>
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm overflow-hidden">
        <!-- Table Toolbar -->
        <div class="p-4 sm:p-5 border-b border-outline-variant/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <span class="text-xs font-bold text-secondary uppercase tracking-wider">Danh mục</span>
                <h2 class="text-base font-bold text-on-surface">Dịch Vụ Niêm Yết (@totalServices)</h2>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <div class="relative">
                    <input type="text" id="serviceSearch" placeholder="Tìm tên dịch vụ, mô tả..."
                           class="h-9 pl-8 pr-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary w-56 sm:w-64 transition-all" />
                    <span class="material-symbols-outlined text-[16px] text-outline absolute left-2.5 top-1/2 -translate-y-1/2">search</span>
                </div>
                <select id="serviceCategoryFilter"
                        class="h-9 px-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary transition-all">
                    <option value="">Tất cả phân loại</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
                <select id="serviceStatusFilter"
                        class="h-9 px-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary transition-all">
                    <option value="">Tất cả trạng thái</option>
                    <option value="available">Đang phục vụ</option>
                    <option value="unavailable">Tạm dừng</option>
                </select>
            </div>
        </div>

        @if (services.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-surface-container-low text-on-surface-variant font-semibold uppercase text-[10px] tracking-wider border-b border-outline-variant/40">
                        <tr>
                            <th class="py-3 px-4">Tên Dịch Vụ</th>
                            <th class="py-3 px-4">Phân Loại</th>
                            <th class="py-3 px-4">Mô Tả</th>
                            <th class="py-3 px-4 text-right">Đơn Giá</th>
                            <th class="py-3 px-4 text-center">Trạng Thái</th>
                            <th class="py-3 px-4 text-right">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/30 text-on-surface font-medium">
                        @foreach (var s in services)
                        {
                            string iconName = GetServiceIcon(s.Category);
                            string searchData = $"{s.ServiceName} {s.Category} {s.Description}".ToLower();
                            string statusKey = s.IsAvailable ? "available" : "unavailable";

                            <tr class="hover:bg-surface-container-low/60 transition-colors service-row"
                                data-category="@(s.Category ?? "")" data-status="@statusKey" data-search="@searchData">
                                <td class="py-3.5 px-4 font-bold text-on-surface">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-surface-container text-secondary flex items-center justify-center font-bold shrink-0">
                                            <span class="material-symbols-outlined text-[20px]">@iconName</span>
                                        </div>
                                        <div>
                                            <div class="font-bold text-on-surface text-sm">@s.ServiceName</div>
                                            <div class="text-[10px] text-outline font-normal">Mã #@s.Id</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="py-3.5 px-4">
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-surface-container text-on-surface border border-outline-variant/40">
                                        @(string.IsNullOrWhiteSpace(s.Category) ? "Khác" : s.Category)
                                    </span>
                                </td>

                                <td class="py-3.5 px-4 max-w-xs text-on-surface-variant text-[11px] truncate">
                                    @(string.IsNullOrWhiteSpace(s.Description) ? "—" : s.Description)
                                </td>

                                <td class="py-3.5 px-4 text-right font-bold text-secondary text-sm">
                                    @s.Price.ToString("N0") <span class="text-[10px] text-on-surface-variant font-normal">đ</span>
                                </td>

                                <td class="py-3.5 px-4 text-center">
                                    @if (s.IsAvailable)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Đang phục vụ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Tạm dừng
                                        </span>
                                    }
                                </td>

                                <td class="py-3.5 px-4 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@s.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-secondary hover:bg-surface-container transition-colors"
                                           title="Xem chi tiết">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@s.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-amber-600 hover:bg-amber-50 transition-colors"
                                           title="Chỉnh sửa">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@s.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-rose-600 hover:bg-rose-50 transition-colors"
                                           title="Xóa dịch vụ">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-12 text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-4xl text-outline mb-2">spa</span>
                <p class="text-sm font-semibold">Chưa có dịch vụ nào trong hệ thống</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('serviceSearch');
            const categoryFilter = document.getElementById('serviceCategoryFilter');
            const statusFilter = document.getElementById('serviceStatusFilter');
            const rows = document.querySelectorAll('.service-row');

            function filterTable() {
                const query = (searchInput?.value || '').toLowerCase().trim();
                const selectedCategory = (categoryFilter?.value || '').toLowerCase().trim();
                const selectedStatus = (statusFilter?.value || '').toLowerCase().trim();

                rows.forEach(row => {
                    const rowSearch = (row.getAttribute('data-search') || '').toLowerCase();
                    const rowCat = (row.getAttribute('data-category') || '').toLowerCase();
                    const rowStat = (row.getAttribute('data-status') || '').toLowerCase();

                    const matchesQuery = !query || rowSearch.includes(query);
                    const matchesCategory = !selectedCategory || rowCat === selectedCategory;
                    const matchesStatus = !selectedStatus || rowStat === selectedStatus;

                    row.style.display = (matchesQuery && matchesCategory && matchesStatus) ? '' : 'none';
                });
            }

            if (searchInput) searchInput.addEventListener('input', filterTable);
            if (categoryFilter) categoryFilter.addEventListener('change', filterTable);
            if (statusFilter) statusFilter.addEventListener('change', filterTable);
        });
    </script>
}