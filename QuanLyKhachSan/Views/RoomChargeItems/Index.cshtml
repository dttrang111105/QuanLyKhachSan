@model IEnumerable<QuanLyKhachSan.Models.RoomChargeItem>
@using QuanLyKhachSan.Models
@{
    bool isAdmin = User.IsInRole("Admin");
    Layout = isAdmin
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";
    ViewData["Title"] = "Bảng giá kiểm tra phòng";
    var items = Model?.ToList() ?? new List<RoomChargeItem>();
    var miniBarItems = items.Where(x => x.Category == "MiniBar").ToList();
    var assetItems = items.Where(x => x.Category == "Asset").ToList();
}

<div class="max-w-5xl mx-auto py-4">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold text-secondary uppercase tracking-wider mb-1">
                <span>Nghiệp Vụ Lễ Tân</span>
                <span class="text-slate-400">/</span>
                <span class="text-on-surface">Bảng Giá Quyết Toán</span>
            </div>
            <h1 class="text-2xl font-bold font-serif text-on-surface">Bảng Giá Kiểm Tra Buồng Phòng</h1>
            <p class="text-xs text-slate-500 mt-0.5">Biểu phí được tự động tính vào hóa đơn khi khách dùng minibar hoặc xảy ra hỏng hóc, mất mát</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="RoomMiniBars" asp-action="Index"
               class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold shadow-sm transition-all">
                <span class="material-symbols-outlined text-[16px]">local_bar</span>
                <span>Quản Lý Minibar</span>
            </a>
            @if (isAdmin)
            {
                <a asp-controller="RoomChargeItems" asp-action="Create"
                   class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary-container text-white text-xs font-bold shadow-sm hover:opacity-90 transition-all">
                    <span class="material-symbols-outlined text-[16px] text-secondary-fixed">add_circle</span>
                    <span>+ Thêm Mặt Hàng</span>
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="p-3.5 mb-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
            <span>@TempData["Success"]</span>
        </div>
    }

    <!-- Bảng Minibar -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden mb-6">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-amber-50 text-secondary flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined text-[18px]">local_bar</span>
                </div>
                <div>
                    <h2 class="text-sm font-bold text-on-surface">Đồ Uống & Snack Minibar</h2>
                    <span class="text-[10px] text-slate-400">@miniBarItems.Count mặt hàng niêm yết</span>
                </div>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-500 font-semibold uppercase text-[10px] tracking-wider border-b border-slate-200/60">
                    <tr>
                        <th class="py-3 px-5">Tên Mặt Hàng</th>
                        <th class="py-3 px-5 text-right">Đơn Giá Sử Dụng</th>
                        @if (isAdmin)
                        {
                            <th class="py-3 px-5 text-right">Thao Tác</th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                    @foreach (var item in miniBarItems)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="py-3 px-5 font-bold text-on-surface">@item.Name</td>
                            <td class="py-3 px-5 text-right font-bold text-secondary">@item.UsedPrice.ToString("N0") <small class="text-slate-400 font-normal">đ</small></td>
                            @if (isAdmin)
                            {
                                <td class="py-3 px-5 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="p-1.5 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 transition-colors" title="Chỉnh sửa giá">
                                            <span class="material-symbols-outlined text-[16px]">edit</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="p-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 transition-colors" title="Xóa">
                                            <span class="material-symbols-outlined text-[16px]">delete</span>
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Bảng Tài Sản & Trang Thiết Bị -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined text-[18px]">inventory_2</span>
                </div>
                <div>
                    <h2 class="text-sm font-bold text-on-surface">Tài Sản & Trang Thiết Bị Phòng</h2>
                    <span class="text-[10px] text-slate-400">@assetItems.Count hạng mục tài sản</span>
                </div>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-500 font-semibold uppercase text-[10px] tracking-wider border-b border-slate-200/60">
                    <tr>
                        <th class="py-3 px-5">Tên Tài Sản</th>
                        <th class="py-3 px-5 text-right">Phí Đền Bù Hỏng</th>
                        <th class="py-3 px-5 text-right">Phí Đền Bù Mất</th>
                        @if (isAdmin)
                        {
                            <th class="py-3 px-5 text-right">Thao Tác</th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                    @foreach (var item in assetItems)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="py-3 px-5 font-bold text-on-surface">@item.Name</td>
                            <td class="py-3 px-5 text-right font-bold text-amber-700">@item.DamagedPrice.ToString("N0") <small class="text-slate-400 font-normal">đ</small></td>
                            <td class="py-3 px-5 text-right font-bold text-rose-700">@item.LostPrice.ToString("N0") <small class="text-slate-400 font-normal">đ</small></td>
                            @if (isAdmin)
                            {
                                <td class="py-3 px-5 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="p-1.5 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 transition-colors" title="Chỉnh sửa giá">
                                            <span class="material-symbols-outlined text-[16px]">edit</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="p-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 transition-colors" title="Xóa">
                                            <span class="material-symbols-outlined text-[16px]">delete</span>
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
