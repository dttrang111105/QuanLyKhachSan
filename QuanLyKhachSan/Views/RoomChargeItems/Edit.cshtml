@model QuanLyKhachSan.Models.RoomChargeItem
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Cập nhật bảng giá";
    bool isMiniBar = Model.Category == "MiniBar";
}

<div class="max-w-3xl mx-auto py-4">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold text-secondary uppercase tracking-wider mb-1">
                <span>Quản Lý Hệ Thống</span>
                <span class="text-slate-400">/</span>
                <a asp-action="Index" class="text-slate-600 hover:text-secondary">Bảng Giá Quyết Toán</a>
                <span class="text-slate-400">/</span>
                <span class="text-on-surface">Chỉnh sửa giá</span>
            </div>
            <h1 class="text-2xl font-bold font-serif text-on-surface">Cập Nhật Giá: @Model.Name</h1>
            <p class="text-xs text-slate-500 mt-0.5">Biểu giá được tự động áp dụng khi quyết toán trả phòng</p>
        </div>
        <a asp-action="Index"
           class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold shadow-sm transition-all">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>Quay lại</span>
        </a>
    </div>

    <!-- Main Card -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-6 bg-slate-50/50 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined text-[20px]">price_change</span>
                </div>
                <div>
                    <h2 class="text-sm font-bold text-on-surface">@Model.Name</h2>
                    <span class="text-xs text-slate-500">Phân loại: @(isMiniBar ? "Đồ uống / Snack Minibar" : "Tài sản & Trang thiết bị buồng phòng")</span>
                </div>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-slate-200 text-slate-700 text-[10px] font-bold uppercase">
                @Model.Category
            </span>
        </div>

        <form asp-controller="RoomChargeItems" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="p-6 sm:p-8 space-y-6">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-rose-600 text-xs font-semibold"></div>

            @if (isMiniBar)
            {
                <div>
                    <label asp-for="UsedPrice" class="block text-xs font-bold text-slate-700 mb-1.5">Giá sử dụng khi khách dùng (VNĐ)</label>
                    <input asp-for="UsedPrice" type="number" min="0" step="1000"
                           class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all font-semibold" />
                    <span asp-validation-for="UsedPrice" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="DamagedPrice" class="block text-xs font-bold text-slate-700 mb-1.5">Phí đền bù khi làm hỏng (VNĐ)</label>
                        <input asp-for="DamagedPrice" type="number" min="0" step="1000"
                               class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all font-semibold" />
                        <span asp-validation-for="DamagedPrice" class="text-rose-600 text-[11px] mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="LostPrice" class="block text-xs font-bold text-slate-700 mb-1.5">Phí đền bù khi làm mất (VNĐ)</label>
                        <input asp-for="LostPrice" type="number" min="0" step="1000"
                               class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all font-semibold" />
                        <span asp-validation-for="LostPrice" class="text-rose-600 text-[11px] mt-1 block"></span>
                    </div>
                </div>
            }

            <div class="pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
                <a asp-action="Index"
                   class="px-5 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all">
                    Hủy bỏ
                </a>
                <button type="submit"
                        class="px-6 py-2.5 rounded-xl bg-secondary hover:bg-secondary/90 text-white text-xs font-bold shadow-md transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    <span>Lưu Biểu Phí</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
