@model QuanLyKhachSan.Models.Employee
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết nhân viên";
    string displayName = string.IsNullOrWhiteSpace(Model.FullName) ? "Nhân viên" : Model.FullName;
    string avatarUrl = string.IsNullOrWhiteSpace(Model.Avatar)
        ? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(displayName)}&size=220&background=c5a880&color=0b1c30&bold=true"
        : Model.Avatar;
}

<div class="space-y-6">
    <!-- Top Action / Breadcrumb -->
    <div class="flex items-center justify-between">
        <a asp-controller="Employees" asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-[#0b1c30] transition-colors">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            Quay lại danh sách nhân viên
        </a>
        <div class="flex items-center gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-amber-50 text-amber-700 hover:bg-amber-100 font-semibold text-sm transition-colors">
                <span class="material-symbols-outlined text-base">edit</span>
                Chỉnh sửa
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-rose-50 text-rose-600 hover:bg-rose-100 font-semibold text-sm transition-colors">
                <span class="material-symbols-outlined text-base">person_remove</span>
                Ngừng hoạt động / Xóa
            </a>
        </div>
    </div>

    <!-- Main Profile Card -->
    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden">
        <!-- Banner Header -->
        <div class="bg-gradient-to-r from-[#0b1c30] via-[#131b2e] to-[#20293a] p-8 lg:p-10 text-white relative overflow-hidden">
            <div class="absolute -right-10 -bottom-10 opacity-10">
                <span class="material-symbols-outlined text-[200px]">badge</span>
            </div>
            <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="flex items-center gap-6">
                    <img src="@avatarUrl" class="w-24 h-24 rounded-2xl object-cover border-2 border-[#c5a880] shadow-lg shadow-black/20" alt="@displayName" />
                    <div>
                        <div class="flex items-center gap-3">
                            <h1 class="font-serif text-2xl lg:text-3xl font-bold tracking-tight text-white">@displayName</h1>
                            @if (Model.Status)
                            {
                                <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 uppercase tracking-wider">
                                    Đang làm việc
                                </span>
                            }
                            else
                            {
                                <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-500/20 text-slate-300 border border-slate-500/30 uppercase tracking-wider">
                                    Ngừng hoạt động
                                </span>
                            }
                        </div>
                        <p class="text-slate-400 text-sm mt-1">
                            Mã nhân viên: #@Model.Id • Chức vụ: @(string.IsNullOrWhiteSpace(Model.Position) ? "Chưa cập nhật" : Model.Position)
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Information Detail Grid -->
        <div class="p-8 lg:p-10">
            <h2 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-6 flex items-center gap-2">
                <span class="material-symbols-outlined text-base">info</span>
                Hồ sơ nhân sự & hợp đồng
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Position -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">work</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Chức vụ</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@(string.IsNullOrWhiteSpace(Model.Position) ? "Chưa cập nhật" : Model.Position)</span>
                    </div>
                </div>

                <!-- Salary -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">payments</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Mức lương</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@Model.Salary.ToString("N0") VNĐ</span>
                    </div>
                </div>

                <!-- Account -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">account_circle</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Tài khoản Web</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@(Model.Account != null ? Model.Account.Username : "Chưa liên kết")</span>
                    </div>
                </div>

                <!-- Phone -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">call</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Số điện thoại</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</span>
                    </div>
                </div>

                <!-- Email -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">mail</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Email</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block truncate max-w-[200px]" title="@Model.Email">@(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa cập nhật" : Model.Email)</span>
                    </div>
                </div>

                <!-- Gender -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-slate-200/70 text-slate-700 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">wc</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Giới tính</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@(string.IsNullOrWhiteSpace(Model.Gender) ? "Chưa cập nhật" : Model.Gender)</span>
                    </div>
                </div>

                <!-- Date of Birth -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">cake</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Ngày sinh</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</span>
                    </div>
                </div>

                <!-- Hire Date -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">event_available</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Ngày vào làm</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@Model.HireDate.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>

                <!-- Created At -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-slate-200/70 text-slate-700 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">history</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Ngày tạo hồ sơ</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>

                <!-- Address -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4 md:col-span-2 lg:col-span-3">
                    <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">location_on</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Địa chỉ thường trú</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@(string.IsNullOrWhiteSpace(Model.Address) ? "Chưa cập nhật địa chỉ" : Model.Address)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
