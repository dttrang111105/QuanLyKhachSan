@model QuanLyKhachSan.Models.Employee
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa nhân viên";
}

<div class="max-w-5xl mx-auto space-y-6">
    <!-- Top Action / Breadcrumb -->
    <div class="flex items-center justify-between">
        <a asp-controller="Employees" asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-[#0b1c30] transition-colors">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            Quay lại danh sách nhân viên
        </a>
        <a asp-action="Details" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-semibold transition-colors">
            <span class="material-symbols-outlined text-base">visibility</span>
            Xem hồ sơ
        </a>
    </div>

    <!-- Main Card -->
    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden">
        <!-- Header -->
        <div class="bg-gradient-to-r from-[#0b1c30] to-[#1e293b] p-8 text-white relative overflow-hidden">
            <div class="absolute -right-8 -bottom-8 opacity-10">
                <span class="material-symbols-outlined text-[160px]">badge</span>
            </div>
            <div class="relative z-10">
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-[#c5a880]/20 text-[#c5a880] border border-[#c5a880]/30 uppercase tracking-widest inline-block mb-3">
                    Nhân sự #@Model.Id
                </span>
                <h1 class="font-serif text-2xl lg:text-3xl font-bold tracking-tight">Chỉnh Sửa Hồ Sơ Nhân Viên</h1>
                <p class="text-slate-300 text-sm mt-1">@Model.FullName • @(string.IsNullOrWhiteSpace(Model.Position) ? "Chưa có chức vụ" : Model.Position)</p>
            </div>
        </div>

        <!-- Form Body -->
        <div class="p-8 lg:p-10">
            <form asp-controller="Employees" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-6">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm"></div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <!-- Linked Account -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Tài khoản đăng nhập</label>
                        <input type="text" value="@ViewBag.AccountUsername" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-100 text-sm text-slate-500 font-medium" readonly />
                    </div>

                    <!-- FullName -->
                    <div>
                        <label asp-for="FullName" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Họ và tên <span class="text-rose-500">*</span></label>
                        <input asp-for="FullName" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                        <span asp-validation-for="FullName" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Position -->
                    <div>
                        <label asp-for="Position" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Chức vụ</label>
                        <input asp-for="Position" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                        <span asp-validation-for="Position" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Salary -->
                    <div>
                        <label asp-for="Salary" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Mức lương (VNĐ)</label>
                        <input asp-for="Salary" type="number" min="0" step="1000" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                        <span asp-validation-for="Salary" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Gender -->
                    <div>
                        <label asp-for="Gender" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Giới tính</label>
                        <div class="relative">
                            <select asp-for="Gender" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium appearance-none">
                                <option value="">-- Chọn giới tính --</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">expand_more</span>
                        </div>
                        <span asp-validation-for="Gender" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Date of Birth -->
                    <div>
                        <label asp-for="DateOfBirth" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Ngày sinh</label>
                        <input asp-for="DateOfBirth" type="date" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                        <span asp-validation-for="DateOfBirth" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Phone -->
                    <div>
                        <label asp-for="Phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Số điện thoại</label>
                        <input asp-for="Phone" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                        <span asp-validation-for="Phone" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Email -->
                    <div>
                        <label asp-for="Email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Email</label>
                        <input asp-for="Email" type="email" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                        <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Hire Date -->
                    <div>
                        <label asp-for="HireDate" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Ngày vào làm</label>
                        <input asp-for="HireDate" type="date" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                        <span asp-validation-for="HireDate" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Status -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Trạng thái công tác</label>
                        <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 bg-slate-50/50 cursor-pointer">
                            <input asp-for="Status" type="checkbox" class="w-4 h-4 rounded text-[#725b38] focus:ring-[#c5a880]" />
                            <span class="text-sm font-semibold text-slate-800">Đang làm việc tại khách sạn</span>
                        </label>
                    </div>

                    <!-- Avatar path -->
                    <div class="sm:col-span-2">
                        <label asp-for="Avatar" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Đường dẫn ảnh đại diện (URL)</label>
                        <input asp-for="Avatar" placeholder="/uploads/avatar/..." class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                        <span asp-validation-for="Avatar" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Address -->
                    <div class="sm:col-span-2">
                        <label asp-for="Address" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Địa chỉ</label>
                        <input asp-for="Address" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                        <span asp-validation-for="Address" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>
                </div>

                <!-- Action buttons -->
                <div class="pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
                    <a asp-action="Index" class="px-6 py-3 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                        Hủy
                    </a>
                    <button type="submit" class="px-7 py-3 rounded-xl bg-gradient-to-r from-[#c5a880] to-[#725b38] hover:from-[#b9986b] hover:to-[#634e2f] text-white text-sm font-semibold shadow-lg shadow-[#c5a880]/20 transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg">save</span>
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
