@model IEnumerable<QuanLyKhachSan.Models.Employee>
@using QuanLyKhachSan.Models
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Nhân viên & Lễ tân";

    List<Employee> employees = Model?.ToList() ?? new List<Employee>();
    int totalEmployees = employees.Count;
    int activeEmployees = employees.Count(e => e.Status);
    int inactiveEmployees = employees.Count(e => !e.Status);
    int linkedAccountCount = employees.Count(e => e.Account != null);
    decimal totalMonthlySalary = employees.Where(e => e.Status).Sum(e => e.Salary);

    List<string> positions = employees
        .Where(e => !string.IsNullOrWhiteSpace(e.Position))
        .Select(e => e.Position!)
        .Distinct()
        .OrderBy(p => p)
        .ToList();

    string EmployeeInitial(string? fullName) => string.IsNullOrWhiteSpace(fullName) ? "N" : fullName.Trim().Substring(0, 1).ToUpper();

    string GenderText(string? gender)
    {
        return gender?.Trim().ToLower() switch
        {
            "male" or "nam" => "Nam",
            "female" or "nữ" or "nu" => "Nữ",
            "other" or "khác" => "Khác",
            _ => string.IsNullOrWhiteSpace(gender) ? "Chưa cập nhật" : gender
        };
    }
}

<div class="space-y-6">
    <!-- Header -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
                <span class="material-symbols-outlined text-[16px]">badge</span>
                <span>Nhân sự &amp; Phân quyền</span>
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-on-surface mt-1">Danh Sách Nhân Viên &amp; Lễ Tân</h1>
            <p class="text-xs text-on-surface-variant mt-1">
                Theo dõi danh sách cán bộ nhân viên, chức vụ, quỹ lương và trạng thái phân công công tác.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-controller="Accounts" asp-action="Index"
               class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface hover:bg-surface-container-low text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[18px] text-secondary">manage_accounts</span>
                <span>Tài Khoản Hệ Thống</span>
            </a>
            <a asp-action="Create"
               class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-primary text-white hover:bg-on-background text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                <span>+ Thêm Nhân Viên</span>
            </a>
        </div>
    </header>

    <!-- 4 KPI Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tổng nhân sự</span>
                <div class="text-2xl font-bold text-on-surface mt-1">@totalEmployees</div>
                <span class="text-[11px] text-on-surface-variant font-medium">Toàn bộ hồ sơ nhân sự</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">badge</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Đang công tác</span>
                <div class="text-2xl font-bold text-emerald-600 mt-1">@activeEmployees</div>
                <span class="text-[11px] text-emerald-700 font-semibold">@inactiveEmployees đã tạm nghỉ</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">check_circle</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tài khoản cấp phát</span>
                <div class="text-2xl font-bold text-secondary mt-1">@linkedAccountCount</div>
                <span class="text-[11px] text-on-surface-variant font-medium">Được cấp quyền đăng nhập</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-secondary-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">vpn_key</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Quỹ lương tháng</span>
                <div class="text-xl font-bold text-secondary mt-1">@totalMonthlySalary.ToString("N0") <small class="text-xs text-on-surface-variant font-normal">đ</small></div>
                <span class="text-[11px] text-on-surface-variant font-medium">Nhân sự đang làm việc</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-surface-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">payments</span>
            </div>
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm overflow-hidden">
        <!-- Table Toolbar -->
        <div class="p-4 sm:p-5 border-b border-outline-variant/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <span class="text-xs font-bold text-secondary uppercase tracking-wider">Hồ sơ nhân sự</span>
                <h2 class="text-base font-bold text-on-surface">Danh Sách Nhân Viên (@totalEmployees)</h2>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <div class="relative">
                    <input type="text" id="employeeSearch" placeholder="Tìm tên, SĐT, Email, CCCD..."
                           class="h-9 pl-8 pr-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary w-56 sm:w-64 transition-all" />
                    <span class="material-symbols-outlined text-[16px] text-outline absolute left-2.5 top-1/2 -translate-y-1/2">search</span>
                </div>
                <select id="posFilter"
                        class="h-9 px-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary transition-all">
                    <option value="">Tất cả chức vụ</option>
                    @foreach (var pos in positions)
                    {
                        <option value="@pos">@pos</option>
                    }
                </select>
                <select id="empStatusFilter"
                        class="h-9 px-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary transition-all">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active">Đang làm việc</option>
                    <option value="inactive">Tạm nghỉ</option>
                </select>
            </div>
        </div>

        @if (employees.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-surface-container-low text-on-surface-variant font-semibold uppercase text-[10px] tracking-wider border-b border-outline-variant/40">
                        <tr>
                            <th class="py-3 px-4">Nhân Viên</th>
                            <th class="py-3 px-4">Chức Vụ</th>
                            <th class="py-3 px-4">Liên Hệ</th>
                            <th class="py-3 px-4">Ngày Vào Làm</th>
                            <th class="py-3 px-4 text-right">Lương Cơ Bản</th>
                            <th class="py-3 px-4 text-center">Tài Khoản</th>
                            <th class="py-3 px-4 text-center">Trạng Thái</th>
                            <th class="py-3 px-4 text-right">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/30 text-on-surface font-medium">
                        @foreach (var e in employees)
                        {
                            string statusKey = e.Status ? "active" : "inactive";
                            string searchStr = $"{e.FullName} {e.Phone} {e.Email} {e.Position}".ToLower();

                            <tr class="hover:bg-surface-container-low/60 transition-colors employee-row"
                                data-position="@(e.Position ?? "")" data-status="@statusKey" data-search="@searchStr">
                                <td class="py-3.5 px-4 font-bold text-on-surface">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-surface-container text-secondary flex items-center justify-center font-bold text-xs shrink-0">
                                            @EmployeeInitial(e.FullName)
                                        </div>
                                        <div>
                                            <div class="font-bold text-on-surface text-sm">@e.FullName</div>
                                            <div class="text-[10px] text-outline font-normal">Mã #@e.Id • Giới tính: @GenderText(e.Gender)</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="py-3.5 px-4">
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-surface-container text-on-surface border border-outline-variant/40">
                                        @(string.IsNullOrWhiteSpace(e.Position) ? "Nhân viên" : e.Position)
                                    </span>
                                </td>

                                <td class="py-3.5 px-4">
                                    <div class="text-on-surface font-semibold">@(string.IsNullOrWhiteSpace(e.Phone) ? "—" : e.Phone)</div>
                                    <div class="text-[10px] text-on-surface-variant font-normal">@(string.IsNullOrWhiteSpace(e.Email) ? "—" : e.Email)</div>
                                </td>

                                <td class="py-3.5 px-4 text-on-surface-variant">
                                    @e.HireDate.ToString("dd/MM/yyyy")
                                </td>

                                <td class="py-3.5 px-4 text-right font-bold text-secondary">
                                    @e.Salary.ToString("N0") <span class="text-[10px] text-on-surface-variant font-normal">đ</span>
                                </td>

                                <td class="py-3.5 px-4 text-center">
                                    @if (e.Account != null)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> @e.Account.Username
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[11px] text-outline">Chưa tạo</span>
                                    }
                                </td>

                                <td class="py-3.5 px-4 text-center">
                                    @if (e.Status)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Đang làm
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Tạm nghỉ
                                        </span>
                                    }
                                </td>

                                <td class="py-3.5 px-4 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@e.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-secondary hover:bg-surface-container transition-colors"
                                           title="Xem chi tiết">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@e.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-amber-600 hover:bg-amber-50 transition-colors"
                                           title="Chỉnh sửa">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@e.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-rose-600 hover:bg-rose-50 transition-colors"
                                           title="Xóa hồ sơ">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-12 text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-4xl text-outline mb-2">badge</span>
                <p class="text-sm font-semibold">Chưa có hồ sơ nhân viên nào trong hệ thống</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('employeeSearch');
            const posFilter = document.getElementById('posFilter');
            const statusFilter = document.getElementById('empStatusFilter');
            const rows = document.querySelectorAll('.employee-row');

            function filterTable() {
                const query = (searchInput?.value || '').toLowerCase().trim();
                const selectedPos = (posFilter?.value || '').toLowerCase().trim();
                const selectedStatus = (statusFilter?.value || '').toLowerCase().trim();

                rows.forEach(row => {
                    const rowSearch = (row.getAttribute('data-search') || '').toLowerCase();
                    const rowPos = (row.getAttribute('data-position') || '').toLowerCase();
                    const rowStatus = (row.getAttribute('data-status') || '').toLowerCase();

                    const matchesQuery = !query || rowSearch.includes(query);
                    const matchesPos = !selectedPos || rowPos === selectedPos;
                    const matchesStatus = !selectedStatus || rowStatus === selectedStatus;

                    row.style.display = (matchesQuery && matchesPos && matchesStatus) ? '' : 'none';
                });
            }

            if (searchInput) searchInput.addEventListener('input', filterTable);
            if (posFilter) posFilter.addEventListener('change', filterTable);
            if (statusFilter) statusFilter.addEventListener('change', filterTable);
        });
    </script>
}