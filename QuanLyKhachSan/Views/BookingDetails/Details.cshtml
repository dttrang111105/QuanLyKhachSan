@model QuanLyKhachSan.Models.BookingDetail
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết đặt phòng";
}

<div class="max-w-3xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-[#0b1c30] transition-colors">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            Quay lại danh sách
        </a>
        <div class="flex items-center gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-amber-50 text-amber-700 hover:bg-amber-100 font-semibold text-sm transition-colors">
                <span class="material-symbols-outlined text-base">edit</span>
                Chỉnh sửa
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-rose-50 text-rose-600 hover:bg-rose-100 font-semibold text-sm transition-colors">
                <span class="material-symbols-outlined text-base">delete</span>
                Xóa
            </a>
        </div>
    </div>

    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden">
        <div class="bg-gradient-to-r from-[#0b1c30] to-[#1e293b] p-8 text-white">
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-[#c5a880]/20 text-[#c5a880] border border-[#c5a880]/30 uppercase tracking-widest inline-block mb-2">
                Booking Detail #@Model.Id
            </span>
            <h1 class="font-serif text-2xl font-bold">Phòng @Model.Room?.RoomNumber</h1>
            <p class="text-slate-300 text-sm mt-1">Mã đặt phòng: @(Model.Booking?.BookingCode ?? $"#{Model.BookingId}")</p>
        </div>

        <div class="p-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                    <span class="text-xs font-semibold text-slate-400 block mb-1">Đơn giá / đêm</span>
                    <span class="text-base font-bold text-slate-900">@Model.PricePerNight.ToString("N0") VNĐ</span>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                    <span class="text-xs font-semibold text-slate-400 block mb-1">Số đêm lưu trú</span>
                    <span class="text-base font-bold text-slate-900">@Model.NumberOfNights đêm</span>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                    <span class="text-xs font-semibold text-slate-400 block mb-1">Chiết khấu</span>
                    <span class="text-base font-bold text-slate-900">@(Model.DiscountPercent > 0 ? $"{Model.DiscountPercent}%" : "0%")</span>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                    <span class="text-xs font-semibold text-slate-400 block mb-1">Tổng tiền phòng</span>
                    <span class="text-base font-bold text-emerald-600">@Model.TotalPrice.ToString("N0") VNĐ</span>
                </div>
            </div>
        </div>
    </div>
</div>
