@model QuanLyKhachSan.ViewModels.Dashboard.DashboardViewModel
@using QuanLyKhachSan.Enums
@using QuanLyKhachSan.Models
@{
    Layout = "~/Views/Shared/_ReceptionistLayout.cshtml";
    ViewData["Title"] = "Tổng quan lễ tân";
    string receptionistName = Model.FullName
        ?? User.FindFirst("FullName")?.Value
        ?? User.Identity?.Name
        ?? "Lễ tân";
    double occupancyRate = Model.TotalRooms > 0
        ? (double)Model.OccupiedRooms / Model.TotalRooms * 100
        : 0;

    string Initial(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "K"
            : value.Trim().Substring(0, 1).ToUpper();
    }

    string StatusText(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending => "Chờ xác nhận",
            BookingStatus.Confirmed => "Đã xác nhận",
            BookingStatus.CheckedIn => "Đang lưu trú",
            BookingStatus.CheckedOut => "Đã trả phòng",
            BookingStatus.Cancelled => "Đã hủy",
            _ => status.ToString()
        };
    }

    string StatusBadge(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending => "bg-amber-100 text-amber-800 border-amber-200",
            BookingStatus.Confirmed => "bg-blue-100 text-blue-800 border-blue-200",
            BookingStatus.CheckedIn => "bg-emerald-100 text-emerald-800 border-emerald-200",
            BookingStatus.CheckedOut => "bg-slate-100 text-slate-700 border-slate-200",
            BookingStatus.Cancelled => "bg-rose-100 text-rose-800 border-rose-200",
            _ => "bg-slate-100 text-slate-800 border-slate-200"
        };
    }

    string RoomNumbers(Booking booking)
    {
        if (booking.BookingDetails == null || !booking.BookingDetails.Any())
        {
            return "Chưa xếp phòng";
        }
        var roomNumbers = booking.BookingDetails
            .Where(detail => !detail.IsDeleted && detail.Room != null)
            .Select(detail => detail.Room!.RoomNumber)
            .Distinct()
            .ToList();
        return roomNumbers.Any() ? string.Join(", ", roomNumbers) : "Chưa xếp phòng";
    }
}

<!-- Top Operational Breadcrumb & Live Stats Bar -->
<div class="flex flex-col xl:flex-row xl:items-end justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-2 text-xs font-semibold text-secondary uppercase tracking-wider mb-1">
            <span>Nghiệp Vụ Lễ Tân</span>
            <span class="text-slate-400">/</span>
            <span class="text-on-surface">Bàn Tiếp Đón FrontDesk</span>
        </div>
        <h1 class="text-2xl lg:text-3xl font-bold text-on-surface font-serif tracking-tight">Chào mừng trở lại, @receptionistName</h1>
        <p class="text-sm text-slate-600 mt-1">Theo dõi đặt phòng, tình trạng buồng phòng, khách nhận và trả phòng thời gian thực.</p>
    </div>
    <!-- Live Shift Metrics Pill -->
    <div class="flex items-center gap-3 p-2 bg-white rounded-2xl border border-slate-200 shadow-sm self-start xl:self-auto">
        <div class="flex items-center gap-2 px-3 py-1.5 bg-slate-50 rounded-xl">
            <span class="material-symbols-outlined text-secondary text-[20px]">room_service</span>
            <div>
                <div class="text-[10px] text-slate-500 uppercase font-semibold">Ca Trực Hiện Tại</div>
                <div class="text-xs font-bold text-on-surface">Ca Hoạt Động (24/7)</div>
            </div>
        </div>
        <div class="flex items-center gap-2 px-3 py-1.5 bg-slate-50 rounded-xl">
            <span class="material-symbols-outlined text-blue-600 text-[20px]">badge</span>
            <div>
                <div class="text-[10px] text-slate-500 uppercase font-semibold">Lễ Tân Chính</div>
                <div class="text-xs font-bold text-on-surface">@receptionistName</div>
            </div>
        </div>
        <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 bg-slate-50 rounded-xl">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-xs font-semibold text-on-surface" id="live-clock">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
    </div>
</div>

<!-- Operational Mode Segmented Tabs & Quick Actions -->
<div class="flex flex-wrap items-center justify-between gap-3 bg-white p-2.5 rounded-2xl border border-slate-200 shadow-sm mb-6">
    <div class="flex flex-wrap items-center gap-2">
        <a asp-controller="Bookings" asp-action="Index" asp-route-filter="checkinToday"
           class="flex items-center gap-2 px-4 py-2 rounded-xl bg-primary-container text-white text-xs font-bold shadow-sm hover:opacity-95 transition-all">
            <span class="material-symbols-outlined text-[16px] text-secondary-fixed">key</span>
            <span>Nhận phòng hôm nay</span>
            <span class="px-2 py-0.5 rounded-full bg-secondary text-white text-[10px] font-bold">@Model.CheckInsToday</span>
        </a>
        <a asp-controller="Bookings" asp-action="Index" asp-route-filter="checkoutToday"
           class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all">
            <span class="material-symbols-outlined text-[16px]">receipt_long</span>
            <span>Trả phòng hôm nay</span>
            <span class="px-2 py-0.5 rounded-full bg-slate-200 text-slate-800 text-[10px] font-bold">@Model.CheckOutsToday</span>
        </a>
        <a asp-controller="Bookings" asp-action="Index" asp-route-filter="pending"
           class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all">
            <span class="material-symbols-outlined text-[16px] text-amber-600">hourglass_top</span>
            <span>Chờ duyệt</span>
            <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[10px] font-bold">@Model.PendingBookings</span>
        </a>
        <a asp-controller="Rooms" asp-action="Index" asp-route-status="Available"
           class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all">
            <span class="material-symbols-outlined text-[16px] text-emerald-600">door_front</span>
            <span>Phòng sẵn sàng</span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">@Model.AvailableRooms</span>
        </a>
    </div>
    <div class="flex items-center gap-2">
        <a asp-controller="Bookings" asp-action="CreateForCustomer"
           class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-secondary text-white hover:bg-secondary/90 text-xs font-bold shadow-sm transition-all">
            <span class="material-symbols-outlined text-[18px]">person_add</span>
            <span>+ Walk-in Đặt Phòng</span>
        </a>
    </div>
</div>

<!-- 4 THẺ KPI THỐNG KÊ -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <!-- Tổng Booking -->
    <a asp-controller="Bookings" asp-action="Index"
       class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between mb-3">
            <span class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">calendar_month</span>
            </span>
            <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700">@Model.PendingBookings chờ duyệt</span>
        </div>
        <div class="text-xs text-slate-500 font-medium">Tổng số Booking</div>
        <div class="text-2xl font-bold text-on-surface mt-1">@Model.TotalBookings</div>
        <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>Đã xác nhận: <b class="text-slate-800">@Model.ConfirmedBookings</b></span>
            <span class="material-symbols-outlined text-[16px] text-slate-400 group-hover:text-primary transition-colors">arrow_forward</span>
        </div>
    </a>

    <!-- Phòng trống -->
    <a asp-controller="Rooms" asp-action="Index" asp-route-status="Available"
       class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between mb-3">
            <span class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">door_open</span>
            </span>
            <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700">Sẵn sàng đón</span>
        </div>
        <div class="text-xs text-slate-500 font-medium">Phòng còn trống</div>
        <div class="text-2xl font-bold text-emerald-600 mt-1">@Model.AvailableRooms</div>
        <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>Tổng số: <b class="text-slate-800">@Model.TotalRooms phòng</b></span>
            <span class="material-symbols-outlined text-[16px] text-slate-400 group-hover:text-primary transition-colors">arrow_forward</span>
        </div>
    </a>

    <!-- Đang có khách -->
    <a asp-controller="Rooms" asp-action="Index" asp-route-status="Occupied"
       class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between mb-3">
            <span class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">group</span>
            </span>
            <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-purple-50 text-purple-700">@occupancyRate.ToString("0.0")% công suất</span>
        </div>
        <div class="text-xs text-slate-500 font-medium">Phòng đang có khách</div>
        <div class="text-2xl font-bold text-on-surface mt-1">@Model.OccupiedRooms</div>
        <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>Đang lưu trú tại khách sạn</span>
            <span class="material-symbols-outlined text-[16px] text-slate-400 group-hover:text-primary transition-colors">arrow_forward</span>
        </div>
    </a>

    <!-- Phòng bảo trì -->
    <a asp-controller="Rooms" asp-action="Index" asp-route-status="Maintenance"
       class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between mb-3">
            <span class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">build</span>
            </span>
            <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-rose-50 text-rose-700">Bảo trì/Dọn</span>
        </div>
        <div class="text-xs text-slate-500 font-medium">Phòng đang bảo trì</div>
        <div class="text-2xl font-bold text-rose-600 mt-1">@Model.MaintenanceRooms</div>
        <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>Tạm thời ngừng đón khách</span>
            <span class="material-symbols-outlined text-[16px] text-slate-400 group-hover:text-primary transition-colors">arrow_forward</span>
        </div>
    </a>
</div>

<!-- PHÒNG TRỐNG SẴN SÀNG ĐÓN KHÁCH -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-6">
    <div class="flex items-center justify-between mb-5">
        <div>
            <span class="text-xs font-bold text-secondary uppercase tracking-wider">Tình trạng buồng phòng</span>
            <h2 class="text-lg font-bold text-on-surface">Phòng Sẵn Sàng Đón Khách</h2>
        </div>
        <a asp-controller="Rooms" asp-action="Index" asp-route-status="Available"
           class="text-xs font-semibold text-secondary hover:text-secondary/80 flex items-center gap-1">
            <span>Xem tất cả</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
    </div>

    @if (Model.AvailableRoomList != null && Model.AvailableRoomList.Any())
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            @foreach (var room in Model.AvailableRoomList.Take(8))
            {
                <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id"
                   class="p-4 rounded-xl border border-slate-200 hover:border-secondary/40 hover:shadow-md transition-all bg-slate-50/50 flex flex-col justify-between group">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-base font-bold text-on-surface">Phòng @room.RoomNumber</span>
                            <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">Trống</span>
                        </div>
                        <div class="text-xs text-slate-600 font-medium mb-2">@(room.RoomType?.Name ?? "Tiêu chuẩn")</div>
                        <div class="flex items-center gap-3 text-xs text-slate-500 mb-3">
                            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">apartment</span> Tầng @room.Floor</span>
                            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">person</span> @room.MaxOccupancy người</span>
                        </div>
                    </div>
                    <div class="pt-2 border-t border-slate-200/60 flex items-center justify-between">
                        <span class="text-xs font-bold text-secondary">@room.PriceDay.ToString("N0") <small class="text-[10px] text-slate-500 font-normal">đ/đêm</small></span>
                        <span class="material-symbols-outlined text-[16px] text-slate-400 group-hover:text-secondary transition-colors">arrow_forward</span>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="text-center py-8 text-slate-500">
            <span class="material-symbols-outlined text-4xl text-slate-300 mb-2">meeting_room</span>
            <p class="text-sm font-semibold">Hiện tại tất cả các phòng đều đang có khách hoặc đang bảo trì.</p>
        </div>
    }
</div>

<!-- THAO TÁC NHANH VÀ BOOKING GẦN ĐÂY -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Thao tác nhanh -->
    <div class="lg:col-span-4 flex flex-col gap-4">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
            <h2 class="text-sm font-bold text-on-surface uppercase tracking-wider text-slate-500 mb-4">Thao tác nghiệp vụ</h2>
            <div class="flex flex-col gap-2">
                <a asp-controller="Bookings" asp-action="CreateForCustomer"
                   class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 border border-slate-100 transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-amber-50 text-amber-700 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[18px]">add_circle</span>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-on-surface group-hover:text-secondary transition-colors">Tạo Đặt Phòng Khách Lãng Vãng</div>
                            <div class="text-[11px] text-slate-500">Đặt trực tiếp tại quầy lễ tân</div>
                        </div>
                    </div>
                    <span class="material-symbols-outlined text-[16px] text-slate-400 group-hover:text-secondary">chevron_right</span>
                </a>

                <a asp-controller="ServiceBookings" asp-action="Index"
                   class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 border border-slate-100 transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-blue-50 text-blue-700 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[18px]">room_service</span>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-on-surface group-hover:text-secondary transition-colors">Yêu Cầu Dịch Vụ</div>
                            <div class="text-[11px] text-slate-500">Xử lý Spa, Ẩm thực & Tour</div>
                        </div>
                    </div>
                    <span class="material-symbols-outlined text-[16px] text-slate-400 group-hover:text-secondary">chevron_right</span>
                </a>

                <a asp-controller="Invoices" asp-action="Index"
                   class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 border border-slate-100 transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-purple-50 text-purple-700 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[18px]">receipt</span>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-on-surface group-hover:text-secondary transition-colors">Hóa Đơn & Thanh Toán</div>
                            <div class="text-[11px] text-slate-500">Quyết toán và xuất hóa đơn VAT</div>
                        </div>
                    </div>
                    <span class="material-symbols-outlined text-[16px] text-slate-400 group-hover:text-secondary">chevron_right</span>
                </a>

                <a asp-controller="ReceptionistActivities" asp-action="Index"
                   class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 border border-slate-100 transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[18px]">history</span>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-on-surface group-hover:text-secondary transition-colors">Nhật Ký Ca Lễ Tân</div>
                            <div class="text-[11px] text-slate-500">Lịch sử bàn giao ca và lưu vết</div>
                        </div>
                    </div>
                    <span class="material-symbols-outlined text-[16px] text-slate-400 group-hover:text-secondary">chevron_right</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Booking gần đây -->
    <div class="lg:col-span-8">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <span class="text-xs font-bold text-secondary uppercase tracking-wider">Lịch sử đặt phòng</span>
                    <h2 class="text-base font-bold text-on-surface">Booking Gần Đây</h2>
                </div>
                <a asp-controller="Bookings" asp-action="Index"
                   class="text-xs font-semibold text-secondary hover:underline flex items-center gap-1">
                    <span>Xem tất cả</span>
                    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 text-slate-500 font-semibold uppercase text-[10px] tracking-wider border-b border-slate-200/60">
                        <tr>
                            <th class="py-3 px-4">Mã Đặt Phòng</th>
                            <th class="py-3 px-4">Khách Hàng</th>
                            <th class="py-3 px-4">Phòng</th>
                            <th class="py-3 px-4">Ngày Nhận</th>
                            <th class="py-3 px-4">Trạng Thái</th>
                            <th class="py-3 px-4 text-right">Chi Tiết</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                        @if (Model.RecentBookings != null && Model.RecentBookings.Any())
                        {
                            foreach (var booking in Model.RecentBookings)
                            {
                                string customerName = booking.Customer?.FullName ?? "Khách lẻ";
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="py-3.5 px-4 font-bold text-on-surface">
                                        <div>@booking.BookingCode</div>
                                        <div class="text-[10px] text-slate-400 font-normal">@booking.BookingDate.ToString("dd/MM/yyyy HH:mm")</div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="flex items-center gap-2">
                                            <div class="w-7 h-7 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center font-bold text-xs">
                                                @Initial(customerName)
                                            </div>
                                            <div>
                                                <div class="font-semibold text-on-surface">@customerName</div>
                                                <div class="text-[10px] text-slate-400">@(booking.Customer?.Phone ?? "—")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="px-2 py-0.5 rounded-lg bg-slate-100 text-slate-700 font-semibold">
                                            @RoomNumbers(booking)
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        @booking.CheckInDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold border @StatusBadge(booking.Status)">
                                            @StatusText(booking.Status)
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-right">
                                        <a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id"
                                           class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 hover:bg-secondary hover:text-white text-slate-600 transition-all"
                                           title="Xem chi tiết">
                                            <span class="material-symbols-outlined text-[16px]">arrow_outward</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-8 text-slate-400">
                                    <span class="material-symbols-outlined text-3xl mb-1 text-slate-300">inbox</span>
                                    <div>Chưa có Booking nào trong hệ thống</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>