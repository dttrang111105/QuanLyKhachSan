@using System.Text.Json
@using QuanLyKhachSan.Enums
@model QuanLyKhachSan.ViewModels.Dashboard.DashboardViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Bảng điều khiển quản trị";
    double occupancyRate = Model.TotalRooms > 0 ? (double)Model.OccupiedRooms / Model.TotalRooms * 100 : 0;
    string adminName = Model.FullName ?? User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Quản trị viên";
}

<div class="space-y-6">
    <!-- GREETING & CONTROLS RIBBON -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-surface-container-lowest p-6 rounded-2xl border border-outline-variant shadow-sm">
        <div class="space-y-1">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-secondary-fixed text-on-secondary-fixed">Live Operations</span>
                <span class="text-xs text-on-surface-variant flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    Hệ thống đang hoạt động ổn định
                </span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-on-surface tracking-tight m-0">
                Chào mừng trở lại, @adminName 👋
            </h1>
            <p class="text-xs sm:text-sm text-on-surface-variant font-light m-0">
                Công suất phòng hiện đạt <strong class="text-secondary font-bold">@occupancyRate.ToString("0.0")%</strong> với @Model.OccupiedRooms/@Model.TotalRooms phòng đang lưu trú.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <a asp-controller="Bookings" asp-action="CreateForCustomer" class="px-4 py-2.5 bg-secondary hover:bg-secondary/90 text-white text-xs font-bold rounded-xl shadow-sm transition-all flex items-center gap-1.5 no-underline">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span>+ Đặt phòng tại quầy</span>
            </a>
            <a asp-controller="Reports" asp-action="Index" class="px-4 py-2.5 bg-surface-container-low hover:bg-surface-container border border-outline-variant text-on-surface text-xs font-bold rounded-xl shadow-sm transition-all flex items-center gap-1.5 no-underline">
                <span class="material-symbols-outlined text-[18px]">analytics</span>
                <span>Báo cáo chi tiết</span>
            </a>
        </div>
    </div>

    <!-- 4 KEY KPI METRIC CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <!-- Metric 1: Total Rooms -->
        <div class="bg-surface-container-lowest p-5 sm:p-6 rounded-2xl border border-outline-variant shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-on-surface-variant">Tổng số phòng</span>
                    <h3 class="text-3xl font-extrabold text-on-surface mt-1 m-0">@Model.TotalRooms</h3>
                </div>
                <div class="w-11 h-11 rounded-xl bg-surface-container-low text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">meeting_room</span>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-outline-variant/60 flex items-center justify-between text-xs text-on-surface-variant">
                <span>@Model.TotalCustomers khách hàng</span>
                <span class="font-bold text-secondary">@Model.TotalBookings bookings</span>
            </div>
        </div>

        <!-- Metric 2: Available Rooms -->
        <div class="bg-surface-container-lowest p-5 sm:p-6 rounded-2xl border border-outline-variant shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-on-surface-variant">Phòng trống</span>
                    <h3 class="text-3xl font-extrabold text-emerald-600 mt-1 m-0">@Model.AvailableRooms</h3>
                </div>
                <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">door_front</span>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-outline-variant/60 flex items-center justify-between text-xs">
                <span class="text-on-surface-variant">Sẵn sàng đón tiếp</span>
                <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold text-[10px]">Sẵn sàng</span>
            </div>
        </div>

        <!-- Metric 3: Occupied Rooms -->
        <div class="bg-surface-container-lowest p-5 sm:p-6 rounded-2xl border border-outline-variant shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-on-surface-variant">Đang lưu trú</span>
                    <h3 class="text-3xl font-extrabold text-secondary mt-1 m-0">@Model.OccupiedRooms</h3>
                </div>
                <div class="w-11 h-11 rounded-xl bg-secondary-container/40 text-secondary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">key</span>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-outline-variant/60 flex items-center justify-between text-xs">
                <span class="text-on-surface-variant">Check-in hôm nay: <strong>@Model.CheckInsToday</strong></span>
                <span class="text-on-surface-variant">Check-out: <strong>@Model.CheckOutsToday</strong></span>
            </div>
        </div>

        <!-- Metric 4: Revenue Today / Month -->
        <div class="bg-surface-container-lowest p-5 sm:p-6 rounded-2xl border border-outline-variant shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-on-surface-variant">Doanh thu tháng này</span>
                    <h3 class="text-2xl font-extrabold text-on-surface mt-1 m-0">@Model.RevenueThisMonth.ToString("N0") <small class="text-xs font-normal">VNĐ</small></h3>
                </div>
                <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">payments</span>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-outline-variant/60 flex items-center justify-between text-xs text-on-surface-variant">
                <span>Hôm nay: <strong class="text-emerald-600">@Model.RevenueToday.ToString("N0") đ</strong></span>
                <span>Tuần: <strong class="text-secondary">@Model.RevenueThisWeek.ToString("N0") đ</strong></span>
            </div>
        </div>
    </div>

    <!-- REVENUE CHART & QUICK STATS -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Revenue Chart Box (8 cols) -->
        <div class="lg:col-span-8 bg-surface-container-lowest p-6 rounded-2xl border border-outline-variant shadow-sm space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                    <h3 class="text-base font-bold text-on-surface m-0 flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary text-[20px]">show_chart</span>
                        <span>Biểu đồ doanh thu kinh doanh</span>
                    </h3>
                    <p class="text-xs text-on-surface-variant m-0 mt-0.5" id="chartRangeText">@Model.SelectedWeekRange</p>
                </div>

                <!-- Tab Selectors & Week Navigation -->
                <div class="flex items-center gap-2">
                    <div class="inline-flex rounded-xl bg-surface-container-low p-1 border border-outline-variant/60 text-xs font-bold">
                        <button type="button" id="btnTabWeek" class="px-3 py-1.5 rounded-lg bg-surface-container-lowest text-on-surface shadow-sm" onclick="switchChartTab('week')">Theo tuần</button>
                        <button type="button" id="btnTabMonth" class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface" onclick="switchChartTab('month')">Tháng này</button>
                        <button type="button" id="btnTabQuarter" class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface" onclick="switchChartTab('quarter')">Quý này</button>
                    </div>

                    <div class="flex items-center gap-1" id="weekNavControls">
                        <button type="button" class="w-8 h-8 rounded-lg bg-surface-container-low hover:bg-surface-container flex items-center justify-center text-on-surface border border-outline-variant" onclick="changeWeekOffset(-1)" title="Tuần trước">
                            <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                        </button>
                        <button type="button" id="btnNextWeek" class="w-8 h-8 rounded-lg bg-surface-container-low hover:bg-surface-container flex items-center justify-center text-on-surface border border-outline-variant disabled:opacity-40" onclick="changeWeekOffset(1)" title="Tuần sau" @(Model.CanGoToNextWeek ? "" : "disabled")>
                            <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Canvas Container -->
            <div class="relative h-72 sm:h-80 w-full">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- Operational Summary (4 cols) -->
        <div class="lg:col-span-4 bg-surface-container-lowest p-6 rounded-2xl border border-outline-variant shadow-sm space-y-6 flex flex-col justify-between">
            <div>
                <h3 class="text-base font-bold text-on-surface m-0 flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary text-[20px]">hotel_class</span>
                    <span>Tình trạng phòng &amp; Booking</span>
                </h3>
                <p class="text-xs text-on-surface-variant m-0 mt-0.5">Tổng quan tình hình phòng thực tế</p>

                <!-- Status Bars -->
                <div class="space-y-3 mt-5">
                    <div>
                        <div class="flex justify-between text-xs font-semibold mb-1">
                            <span class="text-emerald-700">Phòng trống sẵn sàng (@Model.AvailableRooms)</span>
                            <span>@(((double)Model.AvailableRooms / (Model.TotalRooms > 0 ? Model.TotalRooms : 1) * 100).ToString("0.0"))%</span>
                        </div>
                        <div class="w-full bg-surface-container-low h-2.5 rounded-full overflow-hidden">
                            <div class="bg-emerald-500 h-full rounded-full" style="width: @(((double)Model.AvailableRooms / (Model.TotalRooms > 0 ? Model.TotalRooms : 1) * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                    </div>

                    <div>
                        <div class="flex justify-between text-xs font-semibold mb-1">
                            <span class="text-secondary">Đang có khách lưu trú (@Model.OccupiedRooms)</span>
                            <span>@occupancyRate.ToString("0.0")%</span>
                        </div>
                        <div class="w-full bg-surface-container-low h-2.5 rounded-full overflow-hidden">
                            <div class="bg-secondary h-full rounded-full" style="width: @occupancyRate.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </div>

                    <div>
                        <div class="flex justify-between text-xs font-semibold mb-1">
                            <span class="text-amber-700">Phòng đang bảo trì (@Model.MaintenanceRooms)</span>
                            <span>@(((double)Model.MaintenanceRooms / (Model.TotalRooms > 0 ? Model.TotalRooms : 1) * 100).ToString("0.0"))%</span>
                        </div>
                        <div class="w-full bg-surface-container-low h-2.5 rounded-full overflow-hidden">
                            <div class="bg-amber-500 h-full rounded-full" style="width: @(((double)Model.MaintenanceRooms / (Model.TotalRooms > 0 ? Model.TotalRooms : 1) * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                    </div>
                </div>

                <!-- Booking Pending alert -->
                <div class="mt-6 p-4 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-amber-600 text-[24px]">pending_actions</span>
                        <div>
                            <p class="text-xs font-bold text-amber-900 m-0">@Model.PendingBookings booking đang chờ duyệt</p>
                            <p class="text-[11px] text-amber-700 m-0">Khách đặt trực tuyến cần xác nhận</p>
                        </div>
                    </div>
                    <a asp-controller="Bookings" asp-action="Index" asp-route-filter="pending" class="px-3 py-1.5 rounded-lg bg-amber-600 text-white text-xs font-bold hover:bg-amber-700 transition-colors no-underline">
                        Xử lý
                    </a>
                </div>
            </div>

            <div class="pt-4 border-t border-outline-variant/60 flex items-center justify-between text-xs">
                <span class="text-on-surface-variant">Doanh thu dịch vụ tháng:</span>
                <strong class="text-secondary font-bold">@Model.ServiceRevenueThisMonth.ToString("N0") VNĐ</strong>
            </div>
        </div>
    </div>

    <!-- TABLES: RECENT BOOKINGS & QUICK ROOMS -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Recent Bookings Table (7 cols) -->
        <div class="lg:col-span-7 bg-surface-container-lowest p-6 rounded-2xl border border-outline-variant shadow-sm space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="text-base font-bold text-on-surface m-0 flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary text-[20px]">receipt</span>
                    <span>Đặt phòng gần đây</span>
                </h3>
                <a asp-controller="Bookings" asp-action="Index" class="text-xs font-bold text-secondary hover:text-on-surface transition-colors no-underline">
                    Xem tất cả &rarr;
                </a>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-surface-container-low text-on-surface-variant uppercase text-[10px] font-bold border-b border-outline-variant">
                        <tr>
                            <th class="p-3">Mã Booking</th>
                            <th class="p-3">Khách hàng</th>
                            <th class="p-3">Lưu trú</th>
                            <th class="p-3">Tổng tiền</th>
                            <th class="p-3">Trạng thái</th>
                            <th class="p-3 text-right">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/60">
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr class="hover:bg-surface-container-low/50 transition-colors">
                                <td class="p-3 font-bold text-on-surface">@b.BookingCode</td>
                                <td class="p-3">
                                    <span class="font-semibold text-on-surface block">@(b.Customer?.FullName ?? "Khách vãng lai")</span>
                                    <span class="text-[10px] text-on-surface-variant">@(b.Customer?.Phone ?? "")</span>
                                </td>
                                <td class="p-3 text-[11px]">
                                    <span>@b.CheckInDate.ToString("dd/MM") - @b.CheckOutDate.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td class="p-3 font-bold text-secondary">@b.TotalAmount.ToString("N0") đ</td>
                                <td class="p-3">
                                    @if (b.Status == BookingStatus.Pending)
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[10px] font-bold">Chờ duyệt</span>
                                    }
                                    else if (b.Status == BookingStatus.Confirmed)
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 text-[10px] font-bold">Đã xác nhận</span>
                                    }
                                    else if (b.Status == BookingStatus.CheckedIn)
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">Đang ở</span>
                                    }
                                    else if (b.Status == BookingStatus.CheckedOut)
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-800 text-[10px] font-bold">Đã trả phòng</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 text-[10px] font-bold">Đã hủy</span>
                                    }
                                </td>
                                <td class="p-3 text-right">
                                    <a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id" class="p-1.5 rounded-lg border border-outline-variant text-on-surface hover:bg-surface-container transition-colors inline-block no-underline">
                                        <span class="material-symbols-outlined text-[16px]">visibility</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Available Rooms Quick Allocation (5 cols) -->
        <div class="lg:col-span-5 bg-surface-container-lowest p-6 rounded-2xl border border-outline-variant shadow-sm space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="text-base font-bold text-on-surface m-0 flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary text-[20px]">meeting_room</span>
                    <span>Phòng trống sẵn sàng</span>
                </h3>
                <a asp-controller="Rooms" asp-action="Index" class="text-xs font-bold text-secondary hover:text-on-surface transition-colors no-underline">
                    Xem tất cả &rarr;
                </a>
            </div>

            <div class="grid grid-cols-2 gap-3">
                @foreach (var room in Model.AvailableRoomList)
                {
                    <div class="p-3.5 rounded-xl bg-surface-container-low border border-outline-variant flex flex-col justify-between space-y-2 hover:border-secondary transition-all">
                        <div class="flex items-start justify-between">
                            <div>
                                <span class="text-base font-extrabold text-on-surface">P.@room.RoomNumber</span>
                                <span class="text-[10px] text-on-surface-variant block">@(room.RoomType?.Name ?? "Standard") • Tầng @room.Floor</span>
                            </div>
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        </div>
                        <div class="flex items-center justify-between pt-1">
                            <span class="text-xs font-bold text-secondary">@room.PriceDay.ToString("N0") đ</span>
                            <a asp-controller="Bookings" asp-action="CreateForCustomer" asp-route-roomId="@room.Id" class="px-2 py-1 bg-primary hover:bg-on-background text-white text-[10px] font-bold rounded-lg no-underline shadow-sm">
                                Đặt phòng
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentWeekOffset = @Model.WeekOffset;
        let chartInstance = null;

        const weekLabels = @Html.Raw(JsonSerializer.Serialize(Model.RevenueWeekLabels));
        const weekValues = @Html.Raw(JsonSerializer.Serialize(Model.RevenueWeekValues));
        const monthLabels = @Html.Raw(JsonSerializer.Serialize(Model.RevenueMonthLabels));
        const monthValues = @Html.Raw(JsonSerializer.Serialize(Model.RevenueMonthValues));
        const quarterLabels = @Html.Raw(JsonSerializer.Serialize(Model.RevenueQuarterLabels));
        const quarterValues = @Html.Raw(JsonSerializer.Serialize(Model.RevenueQuarterValues));

        document.addEventListener("DOMContentLoaded", function () {
            renderChart(weekLabels, weekValues, "Doanh thu theo tuần (VNĐ)");
        });

        function renderChart(labels, values, datasetLabel) {
            const ctx = document.getElementById('revenueChart').getContext('2d');
            if (chartInstance) {
                chartInstance.destroy();
            }

            chartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: datasetLabel,
                        data: values,
                        backgroundColor: '#C5A880',
                        hoverBackgroundColor: '#725B38',
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return Number(context.raw).toLocaleString('vi-VN') + ' VNĐ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) {
                                    return (value / 1000000).toLocaleString() + 'M';
                                },
                                font: { family: 'Plus Jakarta Sans', size: 11 }
                            },
                            grid: { color: '#EFF4FF' }
                        },
                        x: {
                            ticks: { font: { family: 'Plus Jakarta Sans', size: 11 } },
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        function switchChartTab(tab) {
            document.getElementById('btnTabWeek').className = "px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface";
            document.getElementById('btnTabMonth').className = "px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface";
            document.getElementById('btnTabQuarter').className = "px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface";
            const navControls = document.getElementById('weekNavControls');

            if (tab === 'week') {
                document.getElementById('btnTabWeek').className = "px-3 py-1.5 rounded-lg bg-surface-container-lowest text-on-surface shadow-sm font-bold";
                navControls.style.display = 'flex';
                document.getElementById('chartRangeText').innerText = "@Model.SelectedWeekRange";
                renderChart(weekLabels, weekValues, "Doanh thu tuần (VNĐ)");
            } else if (tab === 'month') {
                document.getElementById('btnTabMonth').className = "px-3 py-1.5 rounded-lg bg-surface-container-lowest text-on-surface shadow-sm font-bold";
                navControls.style.display = 'none';
                document.getElementById('chartRangeText').innerText = "Tháng @DateTime.Today.Month / @DateTime.Today.Year";
                renderChart(monthLabels, monthValues, "Doanh thu từng ngày trong tháng (VNĐ)");
            } else if (tab === 'quarter') {
                document.getElementById('btnTabQuarter').className = "px-3 py-1.5 rounded-lg bg-surface-container-lowest text-on-surface shadow-sm font-bold";
                navControls.style.display = 'none';
                document.getElementById('chartRangeText').innerText = "Quý @(((DateTime.Today.Month - 1) / 3) + 1) / @DateTime.Today.Year";
                renderChart(quarterLabels, quarterValues, "Doanh thu theo quý (VNĐ)");
            }
        }

        function changeWeekOffset(delta) {
            currentWeekOffset += delta;
            fetch(`/Home/GetWeeklyRevenue?weekOffset=${currentWeekOffset}`)
                .then(res => res.json())
                .then(data => {
                    document.getElementById('chartRangeText').innerText = data.selectedWeekRange;
                    document.getElementById('btnNextWeek').disabled = !data.canGoToNextWeek;
                    renderChart(data.labels, data.values, "Doanh thu tuần (VNĐ)");
                });
        }
    </script>
}
