@using QuanLyKhachSan.Enums
@model IEnumerable<QuanLyKhachSan.Models.Room>
@{
    ViewData["Title"] = "Trang chủ - Aura Grand Resort & Spa";
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isCustomer = isAuthenticated && User.IsInRole("Customer");
    DateTime today = DateTime.Today;
    DateTime tomorrow = today.AddDays(1);

    var rooms = Model?.ToList() ?? new List<QuanLyKhachSan.Models.Room>();
    var featuredRooms = rooms.Take(6).ToList();
}

<div id="top" class="w-full">
    <!-- HERO SECTION WITH EDITORIAL OVERLAYS -->
    <section class="relative w-full min-h-[92vh] flex flex-col justify-end overflow-hidden -mt-20 pt-20">
        <!-- Hero Background -->
        <div class="absolute inset-0 bg-cover bg-center transition-transform duration-1000 scale-105" 
             style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDUFBMgAGF5i1KRJ-GsMhQBGrXeru07D1pCvzNQprmGsV3y_zJCC_Jm15JMnsUU4GmaT4QIPec9DjL1Xp8VxnYztXUtb0qs3tBwnYJRPzfj1Y1lz4eOGd8yNq3B75BdYmzAveWdZfcIhMl1ZAq4wxG_gRG8dL9-SF4CHrV-yF2Qv2-yYzHK1xRghkMzNDiJw0XOF0wyew4oh-FTh7PVB3JdcsWGMCoR3Y-_-CVwkQ')">
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-primary-container via-primary-container/50 to-primary-container/20 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-primary-container/80 via-transparent to-transparent"></div>

        <!-- Floating Badge -->
        <div class="absolute top-28 left-6 sm:left-12 hidden md:flex items-center gap-3 z-10">
            <span class="px-3.5 py-1 bg-white/15 backdrop-blur-md rounded-full text-white text-[11px] font-semibold uppercase tracking-[0.25em]">
                Son Tra Peninsula • Da Nang
            </span>
            <div class="flex items-center gap-1.5 text-secondary-fixed">
                <span class="material-symbols-outlined text-[18px]">star</span>
                <span class="text-xs uppercase tracking-wider text-white font-medium">Forbes 5-Star Heritage</span>
            </div>
        </div>

        <!-- Hero Content -->
        <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
            <div class="flex items-center gap-2 text-secondary-fixed mb-3">
                <span class="w-8 h-[2px] bg-secondary-fixed"></span>
                <span class="text-xs uppercase tracking-[0.3em] font-semibold">Tuyệt tác Nghỉ dưỡng Bán đảo Sơn Trà</span>
            </div>
            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight max-w-4xl leading-tight">
                Nơi Kỳ Nghỉ Đẳng Cấp Hòa Quyện Cùng <span class="italic font-light text-secondary-fixed font-serif">Thiên Nhiên Sơn Trà</span>
            </h1>
            <p class="text-sm sm:text-base lg:text-lg text-white/85 max-w-2xl mt-4 leading-relaxed font-light">
                Trải nghiệm không gian biệt lập thanh bình giữa rừng nguyên sinh và biển ngọc bích. Dịch vụ quản gia cá nhân hóa 24/7, ẩm thực thượng lưu và liệu trình phục hồi tâm thức chuyên sâu.
            </p>
            <div class="flex flex-wrap items-center gap-4 mt-8">
                <a href="#booking-console" class="px-6 py-3.5 bg-secondary text-white text-sm font-semibold rounded-xl shadow-lg hover:bg-secondary/90 transition-all flex items-center gap-2 no-underline">
                    <span>Khám phá kỳ nghỉ</span>
                    <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                </a>
                <a asp-controller="Rooms" asp-action="Search" class="px-6 py-3.5 bg-white/15 backdrop-blur-md text-white text-sm font-semibold rounded-xl hover:bg-white/25 transition-all flex items-center gap-2 no-underline">
                    <span class="material-symbols-outlined text-[20px] text-secondary-fixed">calendar_today</span>
                    <span>Tìm phòng trống</span>
                </a>
            </div>
        </div>
    </section>

    <!-- FLOATING QUICK BOOKING BAR -->
    <section class="relative z-30 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 sm:-mt-12" id="booking-console">
        <div class="w-full bg-surface-container-lowest shadow-2xl rounded-2xl p-4 sm:p-6 border border-outline-variant/60">
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-outline-variant/40">
                <div class="flex items-center gap-3">
                    <span class="text-xs text-secondary uppercase tracking-[0.2em] font-bold">Đặt phòng trực tiếp • Đảm bảo giá tốt nhất</span>
                    <span class="hidden sm:inline-block px-2.5 py-0.5 bg-surface-container-low text-secondary text-[11px] font-semibold rounded-full">Tặng 500k Spa Credit</span>
                </div>
                <div class="hidden sm:flex items-center gap-1 text-on-surface-variant text-xs">
                    <span class="material-symbols-outlined text-secondary text-[16px]">verified_user</span>
                    <span>Hủy linh hoạt 48h trước ngày nhận</span>
                </div>
            </div>

            <!-- Booking Form redirecting to Rooms/Search -->
            <form asp-controller="Rooms" asp-action="Search" method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-end">
                <!-- Check-in -->
                <div class="flex flex-col gap-1 bg-surface-container-low/70 p-3 rounded-xl border border-outline-variant/40">
                    <label class="text-[11px] text-on-surface-variant uppercase tracking-wider font-bold flex items-center gap-1.5 m-0">
                        <span class="material-symbols-outlined text-[16px] text-secondary">calendar_today</span>
                        <span>Nhận phòng</span>
                    </label>
                    <input name="CheckInDate" type="date" value="@today.ToString("yyyy-MM-dd")" min="@today.ToString("yyyy-MM-dd")" class="bg-transparent text-sm text-on-surface font-semibold focus:outline-none cursor-pointer py-1 border-0" />
                </div>

                <!-- Check-out -->
                <div class="flex flex-col gap-1 bg-surface-container-low/70 p-3 rounded-xl border border-outline-variant/40">
                    <label class="text-[11px] text-on-surface-variant uppercase tracking-wider font-bold flex items-center gap-1.5 m-0">
                        <span class="material-symbols-outlined text-[16px] text-secondary">event</span>
                        <span>Trả phòng</span>
                    </label>
                    <input name="CheckOutDate" type="date" value="@tomorrow.ToString("yyyy-MM-dd")" min="@tomorrow.ToString("yyyy-MM-dd")" class="bg-transparent text-sm text-on-surface font-semibold focus:outline-none cursor-pointer py-1 border-0" />
                </div>

                <!-- Adults -->
                <div class="flex flex-col gap-1 bg-surface-container-low/70 p-3 rounded-xl border border-outline-variant/40">
                    <label class="text-[11px] text-on-surface-variant uppercase tracking-wider font-bold flex items-center gap-1.5 m-0">
                        <span class="material-symbols-outlined text-[16px] text-secondary">person</span>
                        <span>Người lớn</span>
                    </label>
                    <select name="Adult" class="bg-transparent text-sm text-on-surface font-semibold focus:outline-none cursor-pointer py-1 border-0">
                        <option value="1">1 Người lớn</option>
                        <option value="2" selected>2 Người lớn</option>
                        <option value="3">3 Người lớn</option>
                        <option value="4">4 Người lớn</option>
                        <option value="5">5+ Người lớn</option>
                    </select>
                </div>

                <!-- Children -->
                <div class="flex flex-col gap-1 bg-surface-container-low/70 p-3 rounded-xl border border-outline-variant/40">
                    <label class="text-[11px] text-on-surface-variant uppercase tracking-wider font-bold flex items-center gap-1.5 m-0">
                        <span class="material-symbols-outlined text-[16px] text-secondary">child_care</span>
                        <span>Trẻ em</span>
                    </label>
                    <select name="Children" class="bg-transparent text-sm text-on-surface font-semibold focus:outline-none cursor-pointer py-1 border-0">
                        <option value="0" selected>0 Trẻ em</option>
                        <option value="1">1 Trẻ em</option>
                        <option value="2">2 Trẻ em</option>
                        <option value="3">3 Trẻ em</option>
                    </select>
                </div>

                <!-- Search Button -->
                <div>
                    <button type="submit" class="w-full h-[58px] bg-primary hover:bg-on-background text-white font-bold text-sm rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-[20px]">search</span>
                        <span>Tìm phòng</span>
                    </button>
                </div>
            </form>
        </div>
    </section>

    <!-- ROOMS & SUITES SHOWCASE -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-12" id="rooms">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
            <div>
                <div class="flex items-center gap-2 text-secondary mb-2">
                    <span class="w-6 h-[2px] bg-secondary"></span>
                    <span class="text-xs uppercase tracking-[0.25em] font-bold">Không gian nghỉ dưỡng</span>
                </div>
                <h2 class="text-2xl sm:text-4xl font-extrabold text-on-surface tracking-tight">
                    Hạng Phòng &amp; Biệt Thự Thượng Lưu
                </h2>
            </div>
            <a asp-controller="Rooms" asp-action="Search" class="inline-flex items-center gap-2 text-sm font-bold text-secondary hover:text-on-surface transition-colors no-underline">
                <span>Xem tất cả @rooms.Count phòng</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
        </div>

        <!-- Room Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var room in featuredRooms)
            {
                var mainImg = room.RoomImages.FirstOrDefault(i => i.IsMain)?.ImageUrl 
                    ?? room.RoomImages.FirstOrDefault()?.ImageUrl 
                    ?? "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80";

                <article class="bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm hover:shadow-xl border border-outline-variant/60 transition-all duration-300 flex flex-col group">
                    <!-- Image Container -->
                    <div class="relative h-64 overflow-hidden">
                        <img src="@mainImg" alt="Phòng @room.RoomNumber" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                        <div class="absolute top-4 left-4">
                            <span class="px-3 py-1 rounded-full bg-primary-container/80 backdrop-blur-md text-white text-[11px] font-bold tracking-wider uppercase shadow-sm">
                                @(room.RoomType?.Name ?? "Standard")
                            </span>
                        </div>
                        <div class="absolute top-4 right-4">
                            @if (room.Status == RoomStatus.Available)
                            {
                                <span class="px-2.5 py-1 rounded-full bg-emerald-500/90 text-white text-[11px] font-bold tracking-wider shadow-sm flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                    Phòng @room.RoomNumber
                                </span>
                            }
                            else if (room.Status == RoomStatus.Occupied)
                            {
                                <span class="px-2.5 py-1 rounded-full bg-rose-500/90 text-white text-[11px] font-bold tracking-wider shadow-sm">
                                    Đang phục vụ
                                </span>
                            }
                            else
                            {
                                <span class="px-2.5 py-1 rounded-full bg-amber-500/90 text-white text-[11px] font-bold tracking-wider shadow-sm">
                                    Bảo trì
                                </span>
                            }
                        </div>
                        <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-white text-xs backdrop-blur-md bg-black/40 px-3 py-2 rounded-xl">
                            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">aspect_ratio</span>@room.RoomSize m²</span>
                            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">group</span>Tối đa @room.MaxOccupancy khách</span>
                            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">layers</span>Tầng @room.Floor</span>
                        </div>
                    </div>

                    <!-- Room Content -->
                    <div class="p-6 flex flex-col justify-between flex-grow space-y-4">
                        <div>
                            <h3 class="text-xl font-bold text-on-surface group-hover:text-secondary transition-colors">
                                Phòng @room.RoomNumber - @(room.RoomType?.Name ?? "Phòng Nghỉ Cao Cấp")
                            </h3>
                            <p class="text-sm text-on-surface-variant font-light line-clamp-2 mt-2">
                                @(string.IsNullOrWhiteSpace(room.Description) ? "Phòng nghỉ hiện đại với tầm nhìn tuyệt đẹp, trang bị tiện nghi 5 sao và dịch vụ phòng 24/7." : room.Description)
                            </p>
                        </div>

                        <div class="pt-4 border-t border-outline-variant/50 flex items-center justify-between">
                            <div>
                                <span class="text-[11px] text-on-surface-variant block uppercase font-medium">Giá mỗi đêm từ</span>
                                <span class="text-xl font-bold text-secondary">@room.PriceDay.ToString("N0") VNĐ</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id" class="p-2.5 rounded-xl border border-outline-variant text-on-surface hover:bg-surface-container-low transition-colors no-underline" title="Xem chi tiết">
                                    <span class="material-symbols-outlined text-[20px]">visibility</span>
                                </a>
                                @if (isCustomer)
                                {
                                    <a asp-controller="Bookings" asp-action="Create" asp-route-roomId="@room.Id" class="px-4 py-2.5 rounded-xl bg-primary hover:bg-on-background text-white text-xs font-bold shadow-sm transition-all no-underline">
                                        Đặt ngay
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id" class="px-4 py-2.5 rounded-xl bg-primary hover:bg-on-background text-white text-xs font-bold shadow-sm transition-all no-underline">
                                        Chi tiết
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>

    <!-- DINING & SPA HIGHLIGHTS -->
    <section class="w-full bg-surface-container-low/60 py-20 border-y border-outline-variant/60" id="services">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-xs uppercase tracking-[0.3em] font-bold text-secondary block mb-2">Trải nghiệm thượng lưu</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-on-surface tracking-tight">Dịch Vụ Độc Quyền &amp; Tiện Ích 5 Sao</h2>
                <p class="text-sm text-on-surface-variant font-light mt-3">Hòa mình vào hành trình tái tạo năng lượng với ẩm thực tinh hoa và trị liệu chuyên sâu.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Service 1 -->
                <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/60 flex flex-col justify-between hover:shadow-lg transition-all">
                    <div class="w-12 h-12 rounded-2xl bg-secondary-container/50 text-secondary flex items-center justify-center mb-6">
                        <span class="material-symbols-outlined text-[26px]">spa</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-on-surface mb-2">Aura Lotus Spa</h3>
                        <p class="text-sm text-on-surface-variant font-light leading-relaxed">
                            Liệu trình thảo mộc bản địa kết hợp phương pháp trị liệu Thụy Điển giúp phục hồi thể chất và xoa dịu tâm trí.
                        </p>
                    </div>
                    <div class="pt-6 border-t border-outline-variant/40 mt-4 flex items-center justify-between text-xs text-secondary font-bold">
                        <span>Mở cửa 08:00 - 22:00</span>
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </div>
                </div>

                <!-- Service 2 -->
                <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/60 flex flex-col justify-between hover:shadow-lg transition-all">
                    <div class="w-12 h-12 rounded-2xl bg-secondary-container/50 text-secondary flex items-center justify-center mb-6">
                        <span class="material-symbols-outlined text-[26px]">restaurant</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-on-surface mb-2">Nhà Hàng Ocean Breeze</h3>
                        <p class="text-sm text-on-surface-variant font-light leading-relaxed">
                            Ẩm thực hải sản cao cấp và món Âu tinh tế dưới bàn tay tài hoa của bếp trưởng đạt giải thưởng quốc tế.
                        </p>
                    </div>
                    <div class="pt-6 border-t border-outline-variant/40 mt-4 flex items-center justify-between text-xs text-secondary font-bold">
                        <span>Buffet &amp; Fine Dining</span>
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </div>
                </div>

                <!-- Service 3 -->
                <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/60 flex flex-col justify-between hover:shadow-lg transition-all">
                    <div class="w-12 h-12 rounded-2xl bg-secondary-container/50 text-secondary flex items-center justify-center mb-6">
                        <span class="material-symbols-outlined text-[26px]">directions_car</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-on-surface mb-2">Đưa Đón Hạng Thương Gia</h3>
                        <p class="text-sm text-on-surface-variant font-light leading-relaxed">
                            Dàn xe Limousine và chuyên cơ đón tiễn sân bay quốc tế Đà Nẵng chu đáo, riêng tư tuyệt đối cho khách quý.
                        </p>
                    </div>
                    <div class="pt-6 border-t border-outline-variant/40 mt-4 flex items-center justify-between text-xs text-secondary font-bold">
                        <span>Phục vụ 24/7</span>
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SPECIAL PROMOTIONS / VIP CLUB -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20" id="promotion">
        <div class="bg-primary-container rounded-3xl p-8 sm:p-12 lg:p-16 text-white relative overflow-hidden shadow-2xl">
            <div class="absolute -right-20 -bottom-20 w-96 h-96 rounded-full bg-secondary/20 blur-3xl pointer-events-none"></div>
            <div class="relative z-10 max-w-2xl space-y-6">
                <span class="px-3.5 py-1 rounded-full bg-secondary-container/20 text-secondary-fixed text-xs font-bold uppercase tracking-widest backdrop-blur-md">
                    Aura Club Membership
                </span>
                <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight">
                    Đăng Ký Hội Viên VIP Để Nhận Ưu Đãi 20%
                </h2>
                <p class="text-sm sm:text-base text-surface-variant/90 font-light leading-relaxed">
                    Trở thành hội viên để tích điểm thưởng không giới hạn, miễn phí nâng hạng phòng Suite và nhận ưu đãi ẩm thực độc quyền tại toàn bộ hệ sinh thái khách sạn.
                </p>
                <div class="flex flex-wrap items-center gap-4 pt-2">
                    <a asp-controller="Auth" asp-action="Register" class="px-6 py-3.5 bg-secondary text-white text-sm font-bold rounded-xl shadow-lg hover:bg-secondary/90 transition-all no-underline">
                        Đăng ký hội viên miễn phí
                    </a>
                    <a asp-controller="Rooms" asp-action="Search" class="px-6 py-3.5 bg-white/10 text-white text-sm font-bold rounded-xl hover:bg-white/20 transition-all no-underline">
                        Khám phá ưu đãi
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACT / LOCATION -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16" id="contact">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="bg-surface-container-lowest rounded-2xl p-8 border border-outline-variant/60 shadow-sm space-y-4">
                <div class="w-10 h-10 rounded-xl bg-surface-container-low text-secondary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">location_on</span>
                </div>
                <h3 class="text-lg font-bold text-on-surface">Vị Trí Khu Nghỉ Dưỡng</h3>
                <p class="text-sm text-on-surface-variant font-light">Bán đảo Sơn Trà, TP. Đà Nẵng, Việt Nam. Cách sân bay quốc tế Đà Nẵng 25 phút lái xe.</p>
            </div>
            <div class="bg-surface-container-lowest rounded-2xl p-8 border border-outline-variant/60 shadow-sm space-y-4">
                <div class="w-10 h-10 rounded-xl bg-surface-container-low text-secondary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">call</span>
                </div>
                <h3 class="text-lg font-bold text-on-surface">Hotline Hỗ Trợ 24/7</h3>
                <p class="text-sm text-on-surface-variant font-light">Tổng đài đặt phòng: <strong class="text-on-surface font-semibold">0123 456 789</strong>. Hỗ trợ qua Zalo, WhatsApp, Viber.</p>
            </div>
            <div class="bg-surface-container-lowest rounded-2xl p-8 border border-outline-variant/60 shadow-sm space-y-4">
                <div class="w-10 h-10 rounded-xl bg-surface-container-low text-secondary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">mail</span>
                </div>
                <h3 class="text-lg font-bold text-on-surface">Thư Điện Tử</h3>
                <p class="text-sm text-on-surface-variant font-light">Bộ phận quan hệ khách hàng: <strong class="text-on-surface font-semibold">concierge@auragrand.vn</strong>. Phản hồi trong vòng 30 phút.</p>
            </div>
        </div>
    </section>
</div>
