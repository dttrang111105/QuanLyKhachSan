@model QuanLyKhachSan.Models.Room
@using QuanLyKhachSan.Enums
@{
    ViewData["Title"] = "Thêm phòng mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-4xl mx-auto py-4">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold text-secondary uppercase tracking-wider mb-1">
                <span>Quản Lý Hệ Thống</span>
                <span class="text-slate-400">/</span>
                <a asp-action="Index" class="text-slate-600 hover:text-secondary">Buồng Phòng</a>
                <span class="text-slate-400">/</span>
                <span class="text-on-surface">Thêm mới</span>
            </div>
            <h1 class="text-2xl font-bold font-serif text-on-surface">Thêm Phòng Mới</h1>
            <p class="text-xs text-slate-500 mt-0.5">Khởi tạo dữ liệu buồng phòng vào hệ thống quản lý PMS</p>
        </div>
        <a asp-action="Index"
           class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold shadow-sm transition-all">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>Quay lại</span>
        </a>
    </div>

    <!-- Form Container -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center gap-3 bg-slate-50/50">
            <div class="w-10 h-10 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-[20px]">meeting_room</span>
            </div>
            <div>
                <h2 class="text-sm font-bold text-on-surface">Thông Tin Buồng Phòng</h2>
                <p class="text-xs text-slate-500">Thiết lập thông số kỹ thuật và biểu phí phòng</p>
            </div>
        </div>

        <form asp-action="Create" method="post" class="p-6 sm:p-8 space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-rose-600 text-xs font-semibold"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="RoomNumber" class="block text-xs font-bold text-slate-700 mb-1.5">Số phòng / Mã phòng</label>
                    <input asp-for="RoomNumber" placeholder="VD: 101, P.202, VIP-301"
                           class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all font-semibold" />
                    <span asp-validation-for="RoomNumber" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="RoomTypeId" class="block text-xs font-bold text-slate-700 mb-1.5">Loại phòng</label>
                    <select asp-for="RoomTypeId" asp-items="ViewBag.RoomTypeId"
                            class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all">
                        <option value="">-- Chọn loại phòng --</option>
                    </select>
                    <span asp-validation-for="RoomTypeId" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Floor" class="block text-xs font-bold text-slate-700 mb-1.5">Tầng</label>
                    <input asp-for="Floor" type="number" min="1" placeholder="VD: 1"
                           class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                    <span asp-validation-for="Floor" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="MaxOccupancy" class="block text-xs font-bold text-slate-700 mb-1.5">Sức chứa tối đa (người)</label>
                    <input asp-for="MaxOccupancy" type="number" min="1" placeholder="VD: 2"
                           class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                    <span asp-validation-for="MaxOccupancy" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="RoomSize" class="block text-xs font-bold text-slate-700 mb-1.5">Diện tích (m²)</label>
                    <input asp-for="RoomSize" type="number" min="1" step="0.1" placeholder="VD: 35.5"
                           class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                    <span asp-validation-for="RoomSize" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Status" class="block text-xs font-bold text-slate-700 mb-1.5">Trạng thái phòng</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<RoomStatus>()"
                            class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all">
                    </select>
                    <span asp-validation-for="Status" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="PriceDay" class="block text-xs font-bold text-slate-700 mb-1.5">Giá theo ngày (VNĐ/đêm)</label>
                    <input asp-for="PriceDay" type="number" min="0" step="10000" placeholder="VD: 1200000"
                           class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all font-semibold" />
                    <span asp-validation-for="PriceDay" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="PriceWeek" class="block text-xs font-bold text-slate-700 mb-1.5">Giá theo tuần (VNĐ)</label>
                    <input asp-for="PriceWeek" type="number" min="0" step="10000" placeholder="VD: 7000000"
                           class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                    <span asp-validation-for="PriceWeek" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Description" class="block text-xs font-bold text-slate-700 mb-1.5">Mô tả chi tiết phòng</label>
                    <textarea asp-for="Description" rows="4" placeholder="Mô tả hướng nhìn, tiện nghi, ban công..."
                              class="w-full p-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all"></textarea>
                    <span asp-validation-for="Description" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
                <a asp-action="Index"
                   class="px-5 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all">
                    Hủy bỏ
                </a>
                <button type="submit"
                        class="px-6 py-2.5 rounded-xl bg-primary-container hover:bg-slate-800 text-white text-xs font-bold shadow-md transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px] text-secondary-fixed">save</span>
                    <span>Lưu Buồng Phòng</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
