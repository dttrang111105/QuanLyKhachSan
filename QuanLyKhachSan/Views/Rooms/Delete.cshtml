@model QuanLyKhachSan.Models.Room
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa phòng";
}

<div class="max-w-2xl mx-auto py-6">
    <div class="bg-white rounded-3xl border border-rose-200 shadow-lg overflow-hidden">
        <div class="p-6 bg-rose-50/70 border-b border-rose-100 flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-700 flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-[24px]">warning</span>
            </div>
            <div>
                <h1 class="text-lg font-bold font-serif text-rose-900">Xác Nhận Xóa Buồng Phòng</h1>
                <p class="text-xs text-rose-700 mt-0.5">Bạn có chắc chắn muốn xóa phòng này khỏi danh sách quản lý?</p>
            </div>
        </div>

        <div class="p-6 sm:p-8 space-y-4">
            <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 space-y-2 text-xs">
                <div class="flex justify-between py-1 border-b border-slate-200/60">
                    <span class="text-slate-500 font-medium">Số phòng:</span>
                    <span class="font-bold text-on-surface">Phòng @Model.RoomNumber</span>
                </div>
                <div class="flex justify-between py-1 border-b border-slate-200/60">
                    <span class="text-slate-500 font-medium">Loại phòng:</span>
                    <span class="font-semibold text-slate-800">@(Model.RoomType?.Name ?? "Chưa phân loại")</span>
                </div>
                <div class="flex justify-between py-1 border-b border-slate-200/60">
                    <span class="text-slate-500 font-medium">Tầng / Diện tích:</span>
                    <span class="font-semibold text-slate-800">Tầng @Model.Floor • @Model.RoomSize m²</span>
                </div>
                <div class="flex justify-between py-1 border-b border-slate-200/60">
                    <span class="text-slate-500 font-medium">Giá theo ngày:</span>
                    <span class="font-bold text-secondary">@Model.PriceDay.ToString("N0") VNĐ</span>
                </div>
                <div class="flex justify-between py-1">
                    <span class="text-slate-500 font-medium">Trạng thái:</span>
                    <span class="font-semibold text-slate-800">@Model.Status</span>
                </div>
            </div>

            <p class="text-xs text-slate-500">
                <strong class="text-rose-600">Lưu ý:</strong> Hành động này sẽ đánh dấu phòng là đã xóa trong cơ sở dữ liệu.
            </p>

            <form asp-action="Delete" method="post" class="pt-4 flex items-center justify-end gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index"
                   class="px-5 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all">
                    Hủy bỏ
                </a>
                <button type="submit"
                        class="px-6 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold shadow-md transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">delete_forever</span>
                    <span>Xác Nhận Xóa</span>
                </button>
            </form>
        </div>
    </div>
</div>
