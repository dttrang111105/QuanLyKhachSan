@using QuanLyKhachSan.Enums
@model QuanLyKhachSan.Models.Invoice
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Chi tiết hóa đơn - " + Model.InvoiceCode;

    var roomDetails = Model.InvoiceDetails
        .Where(x => !x.IsDeleted && x.DetailType == "Room")
        .ToList();
    var serviceDetails = Model.InvoiceDetails
        .Where(x => !x.IsDeleted && x.DetailType == "Service")
        .ToList();
    var miniBarDetails = Model.InvoiceDetails
        .Where(x => !x.IsDeleted && x.DetailType == "MiniBar")
        .ToList();
    var compensationDetails = Model.InvoiceDetails
        .Where(x => !x.IsDeleted && x.DetailType == "Compensation")
        .ToList();

    decimal miniBarAmount = miniBarDetails.Sum(x => x.Amount);
    decimal compensationAmount = compensationDetails.Sum(x => x.Amount);
    decimal deposit = Model.Booking?.Deposit ?? 0;
    decimal amountAfterDeposit = Math.Max(0, Model.TotalAmount - deposit);
    decimal paidAmount = Model.Payments?
        .Where(p => !p.IsDeleted && p.PaymentStatus == PaymentStatus.Paid)
        .Sum(p => p.Amount) ?? 0;
    decimal remainingAmount = Math.Max(0, amountAfterDeposit - paidAmount);
    bool isPaid = amountAfterDeposit == 0 || remainingAmount == 0;
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 space-y-6">
    <!-- Header Actions -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
                <span class="material-symbols-outlined text-[16px]">receipt</span>
                <span>Hóa đơn điện tử</span>
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-on-surface mt-1 flex items-center gap-3">
                <span>Hóa Đơn: @Model.InvoiceCode</span>
                @if (isPaid)
                {
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Đã thanh toán
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Chờ thanh toán
                    </span>
                }
            </h1>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="MyInvoices" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface hover:bg-surface-container-low text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                <span>Danh sách</span>
            </a>
            <a asp-action="MyExportPdf" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface hover:bg-surface-container-low text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[16px]">picture_as_pdf</span>
                <span>Tải PDF</span>
            </a>
            @if (!isPaid)
            {
                <a asp-controller="Payments" asp-action="PaymentQr" asp-route-invoiceId="@Model.Id" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-secondary text-white hover:bg-secondary/90 text-xs font-bold shadow-md transition-all no-underline">
                    <span class="material-symbols-outlined text-[16px]">qr_code_2</span>
                    <span>Thanh toán QR</span>
                </a>
            }
        </div>
    </div>

    <!-- Folio Card Container -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-lg overflow-hidden">
        <!-- Top Editorial Banner -->
        <div class="p-6 sm:p-8 bg-primary-container text-white flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <span class="text-[11px] font-bold tracking-widest text-secondary-fixed uppercase block">Aura Grand Resort &amp; Spa</span>
                <h2 class="font-serif text-xl sm:text-2xl font-bold mt-1 text-white">Phiếu Quyết Toán Dịch Vụ</h2>
                <p class="text-xs text-on-primary-container mt-1">Ngày lập: @Model.InvoiceDate.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="text-left sm:text-right">
                <span class="text-xs text-on-primary-container block font-mono">MÃ BOOKING: @Model.Booking?.BookingCode</span>
                <div class="text-2xl font-bold font-serif text-secondary-fixed mt-1">@Model.TotalAmount.ToString("N0") <small class="text-xs font-normal">VNĐ</small></div>
            </div>
        </div>

        <div class="p-6 sm:p-8 space-y-6">
            <!-- Customer & Booking Info -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-4 rounded-xl bg-surface-container-low border border-outline-variant/40 text-xs">
                <div class="space-y-1">
                    <span class="text-[10px] font-bold text-outline uppercase tracking-wider block">Khách hàng</span>
                    <div class="font-bold text-on-surface text-sm">@Model.Booking?.Customer?.FullName</div>
                    <div class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">mail</span> @Model.Booking?.Customer?.Email</div>
                    <div class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">call</span> @Model.Booking?.Customer?.Phone</div>
                </div>
                <div class="space-y-1">
                    <span class="text-[10px] font-bold text-outline uppercase tracking-wider block">Thời gian lưu trú</span>
                    <div class="text-on-surface font-semibold">Nhận phòng: @Model.Booking?.CheckInDate.ToString("dd/MM/yyyy")</div>
                    <div class="text-on-surface font-semibold">Trả phòng: @Model.Booking?.CheckOutDate.ToString("dd/MM/yyyy")</div>
                    <div class="text-on-surface-variant mt-1">Thời gian: @((Model.Booking?.CheckOutDate - Model.Booking?.CheckInDate)?.Days ?? 1) đêm</div>
                </div>
            </div>

            <!-- Items Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-surface-container-low text-on-surface-variant font-semibold uppercase text-[10px] tracking-wider border-b border-outline-variant/40">
                        <tr>
                            <th class="py-2.5 px-3">Khoản Mục</th>
                            <th class="py-2.5 px-3 text-center">SL</th>
                            <th class="py-2.5 px-3 text-right">Đơn Giá</th>
                            <th class="py-2.5 px-3 text-right">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/20 text-on-surface">
                        @if (roomDetails.Any())
                        {
                            foreach (var item in roomDetails)
                            {
                                <tr>
                                    <td class="py-3 px-3">
                                        <div class="font-semibold text-on-surface">@item.ItemName</div>
                                        <div class="text-[10px] text-outline">Tiền phòng lưu trú</div>
                                    </td>
                                    <td class="py-3 px-3 text-center">@item.Quantity</td>
                                    <td class="py-3 px-3 text-right">@item.UnitPrice.ToString("N0") đ</td>
                                    <td class="py-3 px-3 text-right font-semibold">@item.Amount.ToString("N0") đ</td>
                                </tr>
                            }
                        }
                        @if (serviceDetails.Any())
                        {
                            foreach (var item in serviceDetails)
                            {
                                <tr>
                                    <td class="py-3 px-3">
                                        <div class="font-semibold text-on-surface">@item.ItemName</div>
                                        <div class="text-[10px] text-secondary">Dịch vụ &amp; Spa</div>
                                    </td>
                                    <td class="py-3 px-3 text-center">@item.Quantity</td>
                                    <td class="py-3 px-3 text-right">@item.UnitPrice.ToString("N0") đ</td>
                                    <td class="py-3 px-3 text-right font-semibold">@item.Amount.ToString("N0") đ</td>
                                </tr>
                            }
                        }
                        @if (miniBarDetails.Any())
                        {
                            foreach (var item in miniBarDetails)
                            {
                                <tr>
                                    <td class="py-3 px-3">
                                        <div class="font-semibold text-on-surface">@item.ItemName</div>
                                        <div class="text-[10px] text-outline">Minibar</div>
                                    </td>
                                    <td class="py-3 px-3 text-center">@item.Quantity</td>
                                    <td class="py-3 px-3 text-right">@item.UnitPrice.ToString("N0") đ</td>
                                    <td class="py-3 px-3 text-right font-semibold">@item.Amount.ToString("N0") đ</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Financial Summary -->
            <div class="flex justify-end pt-4 border-t border-outline-variant/40">
                <div class="w-full sm:w-80 space-y-2 text-xs">
                    <div class="flex justify-between text-on-surface-variant">
                        <span>Tiền phòng:</span>
                        <span class="font-semibold text-on-surface">@Model.RoomAmount.ToString("N0") đ</span>
                    </div>
                    <div class="flex justify-between text-on-surface-variant">
                        <span>Dịch vụ &amp; Spa:</span>
                        <span class="font-semibold text-on-surface">@Model.ServiceAmount.ToString("N0") đ</span>
                    </div>
                    @if (miniBarAmount > 0)
                    {
                        <div class="flex justify-between text-on-surface-variant">
                            <span>Minibar:</span>
                            <span class="font-semibold text-on-surface">@miniBarAmount.ToString("N0") đ</span>
                        </div>
                    }
                    @if (compensationAmount > 0)
                    {
                        <div class="flex justify-between text-on-surface-variant">
                            <span>Phí bồi hoàn:</span>
                            <span class="font-semibold text-on-surface">@compensationAmount.ToString("N0") đ</span>
                        </div>
                    }
                    @if (Model.DiscountPercent > 0)
                    {
                        <div class="flex justify-between text-emerald-600">
                            <span>Giảm giá (@Model.DiscountPercent%):</span>
                            <span>-@((Model.TotalAmount * Model.DiscountPercent / 100).ToString("N0")) đ</span>
                        </div>
                    }
                    @if (deposit > 0)
                    {
                        <div class="flex justify-between text-amber-700">
                            <span>Đã trừ cọc:</span>
                            <span>-@deposit.ToString("N0") đ</span>
                        </div>
                    }
                    <div class="pt-2 border-t border-outline-variant/40 flex justify-between text-sm font-bold text-on-surface">
                        <span>Tổng thanh toán:</span>
                        <span class="text-secondary font-serif text-base">@Model.TotalAmount.ToString("N0") VNĐ</span>
                    </div>
                    <div class="flex justify-between text-xs font-semibold text-emerald-700">
                        <span>Đã thu:</span>
                        <span>@((paidAmount + deposit).ToString("N0")) VNĐ</span>
                    </div>
                    <div class="flex justify-between text-xs font-bold @(remainingAmount > 0 ? "text-rose-600" : "text-emerald-600")">
                        <span>Còn lại:</span>
                        <span>@remainingAmount.ToString("N0") VNĐ</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
