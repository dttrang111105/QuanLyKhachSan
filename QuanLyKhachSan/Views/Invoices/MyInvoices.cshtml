@using QuanLyKhachSan.Enums
@model IEnumerable<QuanLyKhachSan.Models.Invoice>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Hóa đơn của tôi - Aura Grand Resort";
    var invoiceList = Model?.ToList() ?? new List<QuanLyKhachSan.Models.Invoice>();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
                <span class="material-symbols-outlined text-[16px]">receipt_long</span>
                <span>Cổng thông tin hội viên</span>
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-on-surface mt-1">Lịch Sử Hóa Đơn</h1>
            <p class="text-xs text-on-surface-variant mt-1">
                Theo dõi chi tiết giá trị dịch vụ nghỉ dưỡng, tiền phòng và trạng thái quyết toán điện tử.
            </p>
        </div>
        <a asp-controller="Bookings" asp-action="MyBookings"
           class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface hover:bg-surface-container-low text-xs font-bold shadow-sm transition-all no-underline">
            <span class="material-symbols-outlined text-[18px] text-secondary">hotel</span>
            <span>Xem Booking của tôi</span>
        </a>
    </div>

    @if (invoiceList.Any())
    {
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm overflow-hidden">
            <div class="p-4 sm:p-5 border-b border-outline-variant/40 flex items-center justify-between">
                <div>
                    <span class="text-xs font-bold text-secondary uppercase tracking-wider">Hồ sơ thanh toán</span>
                    <h2 class="text-base font-bold text-on-surface">Danh sách (@invoiceList.Count hóa đơn)</h2>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-surface-container-low text-on-surface-variant font-semibold uppercase text-[10px] tracking-wider border-b border-outline-variant/40">
                        <tr>
                            <th class="py-3.5 px-4">Mã Hóa Đơn</th>
                            <th class="py-3.5 px-4">Mã Booking</th>
                            <th class="py-3.5 px-4">Phòng</th>
                            <th class="py-3.5 px-4">Ngày Lập</th>
                            <th class="py-3.5 px-4 text-right">Tổng Tiền</th>
                            <th class="py-3.5 px-4 text-right">Đã Thu/Cọc</th>
                            <th class="py-3.5 px-4 text-right">Còn Lại</th>
                            <th class="py-3.5 px-4 text-center">Trạng Thái</th>
                            <th class="py-3.5 px-4 text-right">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/30 text-on-surface font-medium">
                        @foreach (var item in invoiceList)
                        {
                            decimal deposit = item.Booking?.Deposit ?? 0;
                            decimal amountAfterDeposit = Math.Max(0, item.TotalAmount - deposit);
                            decimal paidAmount = item.Payments?
                                .Where(p => !p.IsDeleted && p.PaymentStatus == PaymentStatus.Paid)
                                .Sum(p => p.Amount) ?? 0;
                            decimal remainingAmount = Math.Max(0, amountAfterDeposit - paidAmount);
                            bool isPaid = amountAfterDeposit == 0 || remainingAmount == 0;

                            string rooms = item.Booking?.BookingDetails != null && item.Booking.BookingDetails.Any()
                                ? string.Join(", ", item.Booking.BookingDetails.Where(d => !d.IsDeleted && d.Room != null).Select(d => d.Room!.RoomNumber))
                                : "Chưa xếp";

                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3.5 px-4 font-bold text-on-surface">
                                    <div class="flex items-center gap-2">
                                        <div class="w-7 h-7 rounded-lg bg-surface-container text-secondary flex items-center justify-center font-bold">
                                            <span class="material-symbols-outlined text-[16px]">receipt</span>
                                        </div>
                                        <span>@item.InvoiceCode</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 font-semibold text-secondary">
                                    @item.Booking?.BookingCode
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="px-2 py-0.5 rounded bg-surface-container text-on-surface font-semibold text-[11px]">
                                        @rooms
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-on-surface-variant">
                                    @item.InvoiceDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="py-3.5 px-4 text-right font-bold text-on-surface">
                                    @item.TotalAmount.ToString("N0") <span class="text-[10px] text-outline font-normal">đ</span>
                                </td>
                                <td class="py-3.5 px-4 text-right font-semibold text-emerald-700">
                                    @((paidAmount + deposit).ToString("N0")) <span class="text-[10px] text-outline font-normal">đ</span>
                                </td>
                                <td class="py-3.5 px-4 text-right font-bold @(remainingAmount > 0 ? "text-rose-600" : "text-emerald-600")">
                                    @remainingAmount.ToString("N0") <span class="text-[10px] text-outline font-normal">đ</span>
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    @if (isPaid)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Đã thanh toán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Chờ quyết toán
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <div class="inline-flex items-center gap-2">
                                        <a asp-action="MyDetails" asp-route-id="@item.Id"
                                           class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-outline-variant text-on-surface hover:bg-surface-container-low transition-colors no-underline font-semibold text-[11px]">
                                            <span class="material-symbols-outlined text-[15px]">visibility</span>
                                            <span>Chi tiết</span>
                                        </a>
                                        @if (!isPaid)
                                        {
                                            <a asp-controller="Payments" asp-action="PaymentQr" asp-route-invoiceId="@item.Id"
                                               class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-secondary text-white hover:bg-secondary/90 transition-all no-underline font-semibold text-[11px] shadow-sm">
                                                <span class="material-symbols-outlined text-[15px]">qr_code_2</span>
                                                <span>Thanh toán</span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 p-12 text-center text-on-surface-variant shadow-sm">
            <span class="material-symbols-outlined text-5xl text-outline mb-3">receipt_long</span>
            <h3 class="font-serif text-lg font-bold text-on-surface">Chưa Có Hóa Đơn Nào</h3>
            <p class="text-xs text-on-surface-variant max-w-md mx-auto mt-1 mb-6">
                Quý khách chưa có giao dịch hóa đơn nào được phát hành tại resort. Hãy đặt phòng hoặc dịch vụ để trải nghiệm kỳ nghỉ tuyệt vời.
            </p>
            <a asp-controller="Rooms" asp-action="Search"
               class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-white text-xs font-bold shadow-md hover:bg-on-background transition no-underline">
                <span class="material-symbols-outlined text-[18px]">search</span>
                <span>Tìm &amp; Đặt Phòng Ngay</span>
            </a>
        </div>
    }
</div>
