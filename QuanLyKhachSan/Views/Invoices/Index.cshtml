@model IEnumerable<QuanLyKhachSan.Models.Invoice>
@using QuanLyKhachSan.Enums
@using QuanLyKhachSan.Models

@{
    bool isReceptionist = User.IsInRole("Receptionist");
    Layout = isReceptionist
        ? "~/Views/Shared/_ReceptionistLayout.cshtml"
        : "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Quản lý hóa đơn & Quyết toán";
    List<Invoice> invoices = Model?.ToList() ?? new List<Invoice>();

    decimal PaidAmount(Invoice invoice)
    {
        return invoice.Payments?
            .Where(payment => !payment.IsDeleted && payment.PaymentStatus == PaymentStatus.Paid)
            .Sum(payment => payment.Amount) ?? 0;
    }
    decimal DepositAmount(Invoice invoice)
    {
        return invoice.Booking?.Deposit ?? 0;
    }
    decimal NeedToPay(Invoice invoice)
    {
        return Math.Max(0m, invoice.TotalAmount - DepositAmount(invoice));
    }
    decimal RemainingAmount(Invoice invoice)
    {
        return Math.Max(0m, NeedToPay(invoice) - PaidAmount(invoice));
    }
    string InvoiceStatus(Invoice invoice)
    {
        decimal paid = PaidAmount(invoice);
        decimal remaining = RemainingAmount(invoice);
        if (remaining <= 0) return "paid";
        if (paid > 0) return "partial";
        return "unpaid";
    }
    string InvoiceStatusText(Invoice invoice)
    {
        return InvoiceStatus(invoice) switch
        {
            "paid" => "Đã thanh toán",
            "partial" => "Thanh toán một phần",
            _ => "Chưa thanh toán"
        };
    }

    decimal totalInvoiceAmount = invoices.Sum(invoice => invoice.TotalAmount);
    decimal totalPaidAmount = invoices.Sum(invoice => PaidAmount(invoice));
    decimal totalRemaining = invoices.Sum(invoice => RemainingAmount(invoice));
    int paidInvoiceCount = invoices.Count(invoice => RemainingAmount(invoice) <= 0);
    int unpaidInvoiceCount = invoices.Count(invoice => RemainingAmount(invoice) > 0);
}

<div class="space-y-6">
    <!-- Header: Title & Actions -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
                <span class="material-symbols-outlined text-[16px]">receipt_long</span>
                <span>Tài chính &amp; Kế toán</span>
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-on-surface mt-1">Quản Lý Hóa Đơn &amp; Quyết Toán</h1>
            <p class="text-xs text-on-surface-variant mt-1">
                Theo dõi tiền phòng, dịch vụ, tiền cọc và luồng thanh toán thời gian thực của resort.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="Payments" asp-action="Index"
               class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface hover:bg-surface-container-low text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[18px] text-secondary">payments</span>
                <span>Lịch Sử Giao Dịch</span>
            </a>
            <a asp-controller="Invoices" asp-action="Create"
               class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-primary text-white hover:bg-on-background text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span>+ Lập Hóa Đơn Mới</span>
            </a>
        </div>
    </header>

    <!-- KPI Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: Tổng số hóa đơn -->
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tổng hóa đơn</span>
                <div class="text-2xl font-bold text-on-surface mt-1">@invoices.Count</div>
                <span class="text-[11px] text-on-surface-variant font-medium">Toàn bộ hồ sơ phát hành</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">receipt</span>
            </div>
        </div>

        <!-- Card 2: Tổng giá trị -->
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tổng giá trị</span>
                <div class="text-xl font-bold text-secondary mt-1">@totalInvoiceAmount.ToString("N0") <small class="text-xs text-on-surface-variant font-normal">đ</small></div>
                <span class="text-[11px] text-on-surface-variant font-medium">Gồm tiền phòng &amp; dịch vụ</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-secondary-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">account_balance_wallet</span>
            </div>
        </div>

        <!-- Card 3: Đã thu -->
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Đã quyết toán</span>
                <div class="text-xl font-bold text-emerald-600 mt-1">@totalPaidAmount.ToString("N0") <small class="text-xs text-on-surface-variant font-normal">đ</small></div>
                <span class="text-[11px] text-emerald-700 font-semibold">@paidInvoiceCount hóa đơn hoàn tất</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">check_circle</span>
            </div>
        </div>

        <!-- Card 4: Còn lại -->
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Còn phải thu</span>
                <div class="text-xl font-bold text-rose-600 mt-1">@totalRemaining.ToString("N0") <small class="text-xs text-on-surface-variant font-normal">đ</small></div>
                <span class="text-[11px] text-rose-700 font-semibold">@unpaidInvoiceCount hóa đơn chưa thu</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">pending</span>
            </div>
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm overflow-hidden">
        <!-- Table Toolbar -->
        <div class="p-4 sm:p-5 border-b border-outline-variant/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <span class="text-xs font-bold text-secondary uppercase tracking-wider">Dữ liệu chứng từ</span>
                <h2 class="text-base font-bold text-on-surface">Danh Sách Hóa Đơn (@invoices.Count)</h2>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <div class="relative">
                    <input type="text" id="invoiceSearch" placeholder="Tìm mã hóa đơn, booking, khách..."
                           class="h-9 pl-8 pr-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary w-56 sm:w-64 transition-all" />
                    <span class="material-symbols-outlined text-[16px] text-outline absolute left-2.5 top-1/2 -translate-y-1/2">search</span>
                </div>
                <select id="invoiceStatusFilter"
                        class="h-9 px-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary transition-all">
                    <option value="">Tất cả trạng thái</option>
                    <option value="paid">Đã thanh toán</option>
                    <option value="partial">Thanh toán một phần</option>
                    <option value="unpaid">Chưa thanh toán</option>
                </select>
            </div>
        </div>

        @if (invoices.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-surface-container-low text-on-surface-variant font-semibold uppercase text-[10px] tracking-wider border-b border-outline-variant/40">
                        <tr>
                            <th class="py-3 px-4">Mã Hóa Đơn</th>
                            <th class="py-3 px-4">Booking / Khách</th>
                            <th class="py-3 px-4">Ngày Lập</th>
                            <th class="py-3 px-4 text-right">Tiền Phòng</th>
                            <th class="py-3 px-4 text-right">Dịch Vụ</th>
                            <th class="py-3 px-4 text-right">Cọc</th>
                            <th class="py-3 px-4 text-right">Tổng Tiền</th>
                            <th class="py-3 px-4 text-right">Đã Thu</th>
                            <th class="py-3 px-4 text-right">Còn Lại</th>
                            <th class="py-3 px-4 text-center">Trạng Thái</th>
                            <th class="py-3 px-4 text-right">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/30 text-on-surface font-medium">
                        @foreach (Invoice invoice in invoices)
                        {
                            decimal paidAmount = PaidAmount(invoice);
                            decimal deposit = DepositAmount(invoice);
                            decimal remaining = RemainingAmount(invoice);
                            string customerName = invoice.Booking?.Customer?.FullName ?? "Chưa xác định";
                            string bookingCode = invoice.Booking?.BookingCode ?? "Chưa xác định";
                            string status = InvoiceStatus(invoice);
                            string searchData = $"{invoice.InvoiceCode} {bookingCode} {customerName}".ToLower();

                            <tr class="hover:bg-surface-container-low/60 transition-colors invoice-row"
                                data-status="@status" data-search="@searchData">
                                <!-- Mã hóa đơn -->
                                <td class="py-3 px-4 font-bold text-on-surface">
                                    <div class="flex items-center gap-2">
                                        <div class="w-7 h-7 rounded-lg bg-surface-container text-secondary flex items-center justify-center font-bold">
                                            <span class="material-symbols-outlined text-[16px]">receipt</span>
                                        </div>
                                        <div>
                                            <div class="font-bold text-on-surface">@invoice.InvoiceCode</div>
                                            <div class="text-[10px] text-outline font-normal">#@invoice.Id</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Booking & Khách -->
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">@bookingCode</div>
                                    <div class="text-[10px] text-on-surface-variant flex items-center gap-1 font-normal">
                                        <span class="material-symbols-outlined text-[12px]">person</span>
                                        <span>@customerName</span>
                                    </div>
                                </td>

                                <!-- Ngày lập -->
                                <td class="py-3 px-4">
                                    <div>@invoice.InvoiceDate.ToString("dd/MM/yyyy")</div>
                                    <div class="text-[10px] text-outline font-normal">@invoice.InvoiceDate.ToString("HH:mm")</div>
                                </td>

                                <!-- Tiền phòng -->
                                <td class="py-3 px-4 text-right">
                                    <span>@invoice.RoomAmount.ToString("N0")</span>
                                    <span class="text-[10px] text-outline">đ</span>
                                </td>

                                <!-- Dịch vụ -->
                                <td class="py-3 px-4 text-right">
                                    <span>@invoice.ServiceAmount.ToString("N0")</span>
                                    <span class="text-[10px] text-outline">đ</span>
                                </td>

                                <!-- Cọc -->
                                <td class="py-3 px-4 text-right text-amber-700">
                                    <span>@deposit.ToString("N0")</span>
                                    <span class="text-[10px] text-outline">đ</span>
                                </td>

                                <!-- Tổng tiền -->
                                <td class="py-3 px-4 text-right font-bold text-on-surface">
                                    <div>@invoice.TotalAmount.ToString("N0") <span class="text-[10px] text-outline font-normal">đ</span></div>
                                    <div class="text-[9px] text-outline font-normal">VAT @invoice.TaxPercent% • Giảm @invoice.DiscountPercent%</div>
                                </td>

                                <!-- Đã thu -->
                                <td class="py-3 px-4 text-right font-semibold text-emerald-700">
                                    <span>@paidAmount.ToString("N0")</span>
                                    <span class="text-[10px] text-outline">đ</span>
                                </td>

                                <!-- Còn lại -->
                                <td class="py-3 px-4 text-right font-bold @(remaining > 0 ? "text-rose-600" : "text-emerald-600")">
                                    <span>@remaining.ToString("N0")</span>
                                    <span class="text-[10px] text-outline">đ</span>
                                </td>

                                <!-- Trạng thái -->
                                <td class="py-3 px-4 text-center">
                                    @if (status == "paid")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Đã thanh toán
                                        </span>
                                    }
                                    else if (status == "partial")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Thu một phần
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Chưa thanh toán
                                        </span>
                                    }
                                </td>

                                <!-- Thao tác -->
                                <td class="py-3 px-4 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@invoice.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-secondary hover:bg-surface-container transition-colors"
                                           title="Xem chi tiết">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </a>
                                        <a asp-action="ExportPdf" asp-route-id="@invoice.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-blue-600 hover:bg-blue-50 transition-colors"
                                           title="In / Tải PDF">
                                            <span class="material-symbols-outlined text-[18px]">picture_as_pdf</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@invoice.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-amber-600 hover:bg-amber-50 transition-colors"
                                           title="Chỉnh sửa">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </a>
                                        @if (remaining > 0)
                                        {
                                            <a asp-controller="Payments" asp-action="Create" asp-route-invoiceId="@invoice.Id"
                                               class="p-1.5 rounded-lg text-emerald-600 hover:bg-emerald-50 transition-colors"
                                               title="Thu tiền">
                                                <span class="material-symbols-outlined text-[18px]">credit_card</span>
                                            </a>
                                        }
                                        @if (isReceptionist)
                                        {
                                            <a asp-action="Delete" asp-route-id="@invoice.Id"
                                               class="p-1.5 rounded-lg text-on-surface-variant hover:text-rose-600 hover:bg-rose-50 transition-colors"
                                               title="Xóa hóa đơn">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-12 text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-4xl text-outline mb-2">receipt_long</span>
                <p class="text-sm font-semibold">Chưa có hóa đơn nào được tạo trong hệ thống</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('invoiceSearch');
            const statusFilter = document.getElementById('invoiceStatusFilter');
            const rows = document.querySelectorAll('.invoice-row');

            function filterTable() {
                const query = (searchInput?.value || '').toLowerCase().trim();
                const selectedStatus = (statusFilter?.value || '').toLowerCase().trim();

                rows.forEach(row => {
                    const rowSearch = (row.getAttribute('data-search') || '').toLowerCase();
                    const rowStatus = (row.getAttribute('data-status') || '').toLowerCase();

                    const matchesQuery = !query || rowSearch.includes(query);
                    const matchesStatus = !selectedStatus || rowStatus === selectedStatus;

                    row.style.display = (matchesQuery && matchesStatus) ? '' : 'none';
                });
            }

            if (searchInput) searchInput.addEventListener('input', filterTable);
            if (statusFilter) statusFilter.addEventListener('change', filterTable);
        });
    </script>
}