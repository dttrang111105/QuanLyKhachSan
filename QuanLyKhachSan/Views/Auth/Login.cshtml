@model QuanLyKhachSan.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_CustomerLayout";
}

<div class="w-full max-w-6xl mx-auto my-6 lg:my-10 bg-white rounded-3xl shadow-xl border border-slate-100 overflow-hidden grid grid-cols-1 lg:grid-cols-12 min-h-[640px]">
    <!-- LEFT COLUMN: Editorial Showcase & Brand Privileges -->
    <div class="lg:col-span-5 relative flex flex-col justify-between p-8 lg:p-10 text-white overflow-hidden min-h-[420px] lg:min-h-full">
        <!-- Background Image with Gradient Overlay -->
        <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBwoeBHQA56DJG842wJy0k5BFwCFZT0j5IyfvVaOPgBwm9_Ys6g2NAzhW9_kGkpEMLzW9aW8X42lmE_VBaNCQVJQfSZQ_ZFQG1ngyukdywHb0FNTpQsKyxB90tKoVjMiSYN1i69iv5yhU4kIimqr8CXXlyAhWUkTw8QFXbspF4T1yx0k4LcGUYbPaiUVlzvVIwdQcXf9FpRLnUU4eWG5kEwyRGUVYKnBnoNudl0Ug')"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0b1c30] via-[#0b1c30]/80 to-transparent"></div>

        <!-- Top Emblem -->
        <div class="relative z-10 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-md flex items-center justify-center text-[#fedeb2] border border-white/20">
                    <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' 1;">hotel_class</span>
                </div>
                <div>
                    <span class="block text-[11px] uppercase tracking-wider text-[#fedeb2] font-semibold">GrandStay Luxury</span>
                    <span class="text-sm font-bold tracking-tight text-white">VIP Portal</span>
                </div>
            </div>
            <span class="px-3 py-1 rounded-full bg-[#fedeb2]/20 text-[#fedeb2] text-[10px] font-bold uppercase tracking-widest backdrop-blur-sm border border-[#fedeb2]/30">
                Aura Club
            </span>
        </div>

        <!-- Middle Content & Privilege Tiles -->
        <div class="relative z-10 my-auto py-6">
            <p class="text-xs uppercase tracking-widest text-[#fedeb2] mb-2 flex items-center gap-1.5 font-bold">
                <span class="w-1.5 h-1.5 rounded-full bg-[#fedeb2]"></span>
                Đặc Quyền Thượng Khách
            </p>
            <h2 class="text-2xl lg:text-3xl font-bold font-serif text-white tracking-tight leading-snug mb-3">
                Khởi Đầu Kỳ Nghỉ Đẳng Cấp
            </h2>
            <p class="text-xs text-slate-300 mb-6 max-w-sm font-light leading-relaxed">
                Đăng nhập để quản lý đặt phòng, tận hưởng ưu đãi phòng nghỉ và trải nghiệm dịch vụ cá nhân hóa chuẩn 5 sao.
            </p>

            <!-- Privileges Grid -->
            <div class="grid grid-cols-2 gap-2.5 max-w-sm">
                <div class="bg-white/10 backdrop-blur-md p-3 rounded-xl border border-white/10 flex flex-col justify-between">
                    <div class="w-7 h-7 rounded-lg bg-[#fedeb2]/20 flex items-center justify-center text-[#fedeb2] mb-1.5">
                        <span class="material-symbols-outlined text-[16px]">verified_user</span>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-white">Giá Tốt Nhất</p>
                        <p class="text-[10px] text-slate-300">Đặc quyền hội viên</p>
                    </div>
                </div>
                <div class="bg-white/10 backdrop-blur-md p-3 rounded-xl border border-white/10 flex flex-col justify-between">
                    <div class="w-7 h-7 rounded-lg bg-[#fedeb2]/20 flex items-center justify-center text-[#fedeb2] mb-1.5">
                        <span class="material-symbols-outlined text-[16px]">room_service</span>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-white">Dịch Vụ 24/7</p>
                        <p class="text-[10px] text-slate-300">Phục vụ tận phòng</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Security Note -->
        <div class="relative z-10 flex items-center justify-between pt-3 border-t border-white/15 text-xs text-slate-300">
            <div class="flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[#fedeb2] text-[16px]">lock</span>
                <span class="text-[11px]">Bảo mật mã hóa 256-bit SSL</span>
            </div>
            <span class="text-[10px] text-slate-400 font-medium">GRANDSTAY GROUP</span>
        </div>
    </div>

    <!-- RIGHT COLUMN: Authentication Form -->
    <div class="lg:col-span-7 p-6 sm:p-10 lg:p-12 flex flex-col justify-between bg-white">
        <div>
            <!-- Top Status Bar & Heading -->
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h1 class="text-2xl font-bold font-serif text-on-surface">Đăng Nhập Tài Khoản</h1>
                    <p class="text-xs text-slate-500 mt-1">Chào mừng bạn quay trở lại với GrandStay Hotel & Resort</p>
                </div>
                <div class="hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 text-secondary text-xs font-bold">
                    <span class="w-2 h-2 rounded-full bg-secondary"></span>
                    <span>HỘI VIÊN VIP</span>
                </div>
            </div>

            <!-- Tab Switcher -->
            <div class="p-1 rounded-2xl bg-slate-100 flex relative mb-6">
                <a asp-controller="Auth" asp-action="Login"
                   class="flex-1 py-2 px-3 rounded-xl text-xs font-bold transition-all text-white bg-primary-container shadow-sm flex items-center justify-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px] text-secondary-fixed">lock_open</span>
                    <span>Đăng Nhập</span>
                </a>
                <a asp-controller="Auth" asp-action="Register"
                   class="flex-1 py-2 px-3 rounded-xl text-xs font-bold transition-all text-slate-600 hover:text-slate-900 flex items-center justify-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px]">card_membership</span>
                    <span>Đăng Ký Hội Viên</span>
                </a>
            </div>

            @if (TempData["AuthError"] != null)
            {
                <div class="p-3.5 mb-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">error</span>
                    <span>@TempData["AuthError"]</span>
                </div>
            }
            @if (TempData["AuthSuccess"] != null)
            {
                <div class="p-3.5 mb-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    <span>@TempData["AuthSuccess"]</span>
                </div>
            }

            <form asp-controller="Auth" asp-action="Login" method="post" novalidate class="space-y-4">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div asp-validation-summary="ModelOnly" class="text-rose-600 text-xs font-semibold" role="alert"></div>

                <div>
                    <label asp-for="Username" class="block text-xs font-bold text-slate-700 mb-1.5">Tên đăng nhập / Tài khoản</label>
                    <div class="relative flex items-center">
                        <span class="absolute left-3.5 text-slate-400 material-symbols-outlined text-[18px]">person</span>
                        <input asp-for="Username"
                               class="w-full h-11 pl-11 pr-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all placeholder:text-slate-400"
                               placeholder="Nhập tên đăng nhập" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Username" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label asp-for="Password" class="text-xs font-bold text-slate-700">Mật khẩu</label>
                    </div>
                    <div class="relative flex items-center">
                        <span class="absolute left-3.5 text-slate-400 material-symbols-outlined text-[18px]">lock</span>
                        <input asp-for="Password" type="password" id="loginPassword"
                               class="w-full h-11 pl-11 pr-11 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all placeholder:text-slate-400"
                               placeholder="Nhập mật khẩu" autocomplete="current-password" />
                        <button type="button" class="absolute right-3 text-slate-400 hover:text-slate-700 p-1 auth-password-toggle"
                                data-target="loginPassword" aria-label="Hiện hoặc ẩn mật khẩu">
                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <button type="submit"
                        class="w-full h-12 bg-primary-container hover:bg-slate-800 text-white text-xs font-bold rounded-xl shadow-md transition-all flex items-center justify-center gap-2 mt-2">
                    <span>Đăng Nhập Vào Hệ Thống</span>
                    <span class="material-symbols-outlined text-[18px] text-secondary-fixed">arrow_forward</span>
                </button>

                <!-- Social Quick Access -->
                <div class="relative py-2 text-center my-2">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full bg-slate-200 h-[1px]"></div>
                    </div>
                    <span class="relative px-3 bg-white text-[11px] uppercase font-bold text-slate-400 tracking-wider">
                        Hoặc tiếp tục với
                    </span>
                </div>

                <a asp-controller="Auth" asp-action="GoogleLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]"
                   class="w-full h-11 border border-slate-200 hover:bg-slate-50 text-slate-700 font-bold text-xs rounded-xl flex items-center justify-center gap-2 transition-all">
                    <svg class="w-4 h-4" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Đăng nhập qua Google</span>
                </a>
            </form>
        </div>

        <div class="pt-6 border-t border-slate-100 text-center text-xs text-slate-500">
            Chưa có tài khoản?
            <a asp-controller="Auth" asp-action="Register" class="text-secondary font-bold hover:underline ml-1">Đăng ký hội viên ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll(".auth-password-toggle").forEach(function (button) {
            button.addEventListener("click", function () {
                const input = document.getElementById(button.dataset.target);
                if (!input) return;
                const isPassword = input.type === "password";
                input.type = isPassword ? "text" : "password";
                const icon = button.querySelector("span");
                if (icon) {
                    icon.textContent = isPassword ? "visibility_off" : "visibility";
                }
            });
        });
    </script>
}