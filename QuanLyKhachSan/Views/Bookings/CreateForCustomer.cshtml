@model QuanLyKhachSan.ViewModels.BookingCreateViewModel
@{
    bool isAdmin = User.IsInRole("Admin");
    Layout = isAdmin ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_ReceptionistLayout.cshtml";
    ViewData["Title"] = "Đặt phòng cho khách";
}

<div class="max-w-5xl mx-auto py-4">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold text-secondary uppercase tracking-wider mb-1">
                <span>Nghiệp Vụ Lễ Tân</span>
                <span class="text-slate-400">/</span>
                <span class="text-on-surface">Đặt Phòng Walk-in</span>
            </div>
            <h1 class="text-2xl font-bold font-serif text-on-surface">Tạo Phiếu Đặt Phòng Cho Khách</h1>
            <p class="text-xs text-slate-500 mt-0.5">Chọn hồ sơ khách hàng có sẵn hoặc tạo hồ sơ nhanh cho khách trực tiếp đến quầy</p>
        </div>
        <a asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.RoomId"
           class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold shadow-sm transition-all">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>Quay lại</span>
        </a>
    </div>

    <form asp-controller="Bookings" asp-action="CreateForCustomer" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="RoomId" type="hidden" />
        <input asp-for="RoomNumber" type="hidden" />
        <input asp-for="RoomTypeName" type="hidden" />
        <input asp-for="PricePerNight" type="hidden" />
        <input asp-for="MaxOccupancy" type="hidden" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="p-4 mb-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold"></div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <!-- Cột Trái: Tóm tắt buồng phòng -->
            <div class="lg:col-span-4 bg-white rounded-3xl border border-slate-200 shadow-sm p-6">
                <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold uppercase tracking-wider mb-3 inline-block">
                    Buồng phòng đã chọn
                </span>
                <h2 class="text-2xl font-bold font-serif text-on-surface mb-1">Phòng @Model.RoomNumber</h2>
                <p class="text-xs text-slate-500 mb-4">@(string.IsNullOrWhiteSpace(Model.RoomTypeName) ? "Hạng phòng cao cấp" : Model.RoomTypeName)</p>

                <div class="space-y-2.5 text-xs text-slate-600 bg-slate-50 p-4 rounded-2xl border border-slate-100 mb-4">
                    <div class="flex justify-between">
                        <span class="text-slate-500">Đơn giá đêm:</span>
                        <span class="font-bold text-secondary">@Model.PricePerNight.ToString("N0") VNĐ</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">Sức chứa tối đa:</span>
                        <span class="font-bold text-on-surface">@Model.MaxOccupancy người</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">Số đêm lưu trú:</span>
                        <span class="font-bold text-on-surface" id="numberOfNights">@Model.NumberOfNights</span>
                    </div>
                </div>

                <div class="pt-3 border-t border-slate-100 flex items-baseline justify-between">
                    <span class="text-xs font-bold text-slate-700">Tạm tính:</span>
                    <span id="estimatedTotal" class="text-xl font-bold font-serif text-secondary">@Model.EstimatedTotal.ToString("N0") VNĐ</span>
                </div>
            </div>

            <!-- Cột Phải: Thông tin khách & lưu trú -->
            <div class="lg:col-span-8 bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8 space-y-6">
                <!-- Chọn loại khách -->
                <div>
                    <h2 class="text-sm font-bold text-on-surface uppercase tracking-wider mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary text-[18px]">person</span>
                        <span>Thông Tin Khách Hàng</span>
                    </h2>

                    <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 mb-4 flex items-center gap-3">
                        <input asp-for="CreateNewCustomer" class="w-4 h-4 rounded text-secondary focus:ring-0 cursor-pointer accent-secondary" id="CreateNewCustomer" />
                        <label for="CreateNewCustomer" class="text-xs font-bold text-slate-700 cursor-pointer">
                            Khách trực tiếp đến quầy (tạo hồ sơ nhanh)
                        </label>
                    </div>

                    <!-- Khách có sẵn -->
                    <div id="existingCustomerSection">
                        <label asp-for="CustomerId" class="block text-xs font-bold text-slate-700 mb-1.5">Chọn tài khoản khách hàng</label>
                        <select asp-for="CustomerId" asp-items="ViewBag.Customers"
                                class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all">
                            <option value="">-- Chọn khách hàng đã có tài khoản --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-rose-600 text-[11px] mt-1 block"></span>
                    </div>

                    <!-- Khách mới -->
                    <div id="newCustomerSection" class="hidden space-y-4 pt-2">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label asp-for="GuestFullName" class="block text-xs font-bold text-slate-700 mb-1.5">Họ và tên khách</label>
                                <input asp-for="GuestFullName" placeholder="Nguyễn Văn A"
                                       class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all font-semibold" />
                                <span asp-validation-for="GuestFullName" class="text-rose-600 text-[11px] mt-1 block"></span>
                            </div>

                            <div>
                                <label asp-for="GuestPhone" class="block text-xs font-bold text-slate-700 mb-1.5">Số điện thoại</label>
                                <input asp-for="GuestPhone" placeholder="0901234567"
                                       class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                                <span asp-validation-for="GuestPhone" class="text-rose-600 text-[11px] mt-1 block"></span>
                            </div>

                            <div>
                                <label asp-for="GuestCitizenId" class="block text-xs font-bold text-slate-700 mb-1.5">Số CCCD / Hộ chiếu</label>
                                <input asp-for="GuestCitizenId" placeholder="12 chữ số CCCD"
                                       class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                                <span asp-validation-for="GuestCitizenId" class="text-rose-600 text-[11px] mt-1 block"></span>
                            </div>

                            <div>
                                <label asp-for="GuestEmail" class="block text-xs font-bold text-slate-700 mb-1.5">Email liên hệ</label>
                                <input asp-for="GuestEmail" placeholder="guest@example.com"
                                       class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                                <span asp-validation-for="GuestEmail" class="text-rose-600 text-[11px] mt-1 block"></span>
                            </div>

                            <div>
                                <label asp-for="GuestGender" class="block text-xs font-bold text-slate-700 mb-1.5">Giới tính</label>
                                <select asp-for="GuestGender"
                                        class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all">
                                    <option value="">-- Chọn giới tính --</option>
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>

                            <div>
                                <label asp-for="GuestDateOfBirth" class="block text-xs font-bold text-slate-700 mb-1.5">Ngày sinh</label>
                                <input asp-for="GuestDateOfBirth" type="date"
                                       class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                            </div>

                            <div class="md:col-span-2">
                                <label asp-for="GuestAddress" class="block text-xs font-bold text-slate-700 mb-1.5">Địa chỉ</label>
                                <input asp-for="GuestAddress" placeholder="Địa chỉ thường trú / lưu trú"
                                       class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="border-slate-100" />

                <!-- Thông tin lưu trú -->
                <div>
                    <h2 class="text-sm font-bold text-on-surface uppercase tracking-wider mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary text-[18px]">calendar_today</span>
                        <span>Thông Tin Lưu Trú</span>
                    </h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="CheckInDate" class="block text-xs font-bold text-slate-700 mb-1.5">Ngày nhận phòng</label>
                            <input asp-for="CheckInDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" id="CheckInDate"
                                   class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all font-semibold" />
                            <span asp-validation-for="CheckInDate" class="text-rose-600 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="CheckOutDate" class="block text-xs font-bold text-slate-700 mb-1.5">Ngày trả phòng</label>
                            <input asp-for="CheckOutDate" type="date" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" id="CheckOutDate"
                                   class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all font-semibold" />
                            <span asp-validation-for="CheckOutDate" class="text-rose-600 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Adult" class="block text-xs font-bold text-slate-700 mb-1.5">Người lớn</label>
                            <input asp-for="Adult" type="number" min="1" max="@Model.MaxOccupancy"
                                   class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                            <span asp-validation-for="Adult" class="text-rose-600 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Children" class="block text-xs font-bold text-slate-700 mb-1.5">Trẻ em</label>
                            <input asp-for="Children" type="number" min="0" max="@Model.MaxOccupancy"
                                   class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all" />
                            <span asp-validation-for="Children" class="text-rose-600 text-[11px] mt-1 block"></span>
                        </div>

                        <div class="md:col-span-2">
                            <label asp-for="Deposit" class="block text-xs font-bold text-slate-700 mb-1.5">Tiền đặt cọc (VNĐ)</label>
                            <input asp-for="Deposit" type="number" min="0" step="10000"
                                   class="w-full h-11 px-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all font-semibold" />
                            <span asp-validation-for="Deposit" class="text-rose-600 text-[11px] mt-1 block"></span>
                        </div>

                        <div class="md:col-span-2">
                            <label asp-for="Note" class="block text-xs font-bold text-slate-700 mb-1.5">Ghi chú yêu cầu đặc biệt</label>
                            <textarea asp-for="Note" rows="3" placeholder="Yêu cầu giường phụ, giờ nhận sớm..."
                                      class="w-full p-4 bg-slate-50 border border-slate-200 text-on-surface text-sm rounded-xl focus:outline-none focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all"></textarea>
                            <span asp-validation-for="Note" class="text-rose-600 text-[11px] mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                    <a asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.RoomId"
                       class="px-5 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all">
                        Hủy
                    </a>
                    <button type="submit"
                            class="px-6 py-2.5 rounded-xl bg-primary-container hover:bg-slate-800 text-white text-xs font-bold shadow-md transition-all flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px] text-secondary-fixed">calendar_check</span>
                        <span>Xác Nhận Đặt Phòng</span>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const createNewCustomer = document.getElementById("CreateNewCustomer");
            const existingSection = document.getElementById("existingCustomerSection");
            const newSection = document.getElementById("newCustomerSection");
            const customerSelect = document.getElementById("CustomerId");
            const checkIn = document.getElementById("CheckInDate");
            const checkOut = document.getElementById("CheckOutDate");
            const nightsElement = document.getElementById("numberOfNights");
            const totalElement = document.getElementById("estimatedTotal");
            const price = @Model.PricePerNight.ToString(System.Globalization.CultureInfo.InvariantCulture);

            function updateCustomerMode() {
                const isNew = createNewCustomer.checked;
                if (existingSection) existingSection.classList.toggle("hidden", isNew);
                if (newSection) newSection.classList.toggle("hidden", !isNew);
                if (isNew && customerSelect) customerSelect.value = "";
            }

            function updateTotal() {
                if (!checkIn.value || !checkOut.value) return;
                const start = new Date(checkIn.value + "T00:00:00");
                const end = new Date(checkOut.value + "T00:00:00");
                const nights = Math.max(0, Math.round((end - start) / 86400000));
                if (nightsElement) nightsElement.textContent = nights;
                if (totalElement) totalElement.textContent = new Intl.NumberFormat("vi-VN").format(nights * price) + " VNĐ";
                if (checkIn.value) {
                    const minimum = new Date(checkIn.value + "T00:00:00");
                    minimum.setDate(minimum.getDate() + 1);
                    checkOut.min = minimum.getFullYear() + "-" +
                        String(minimum.getMonth() + 1).padStart(2, "0") + "-" +
                        String(minimum.getDate()).padStart(2, "0");
                }
            }

            createNewCustomer?.addEventListener("change", updateCustomerMode);
            checkIn?.addEventListener("change", updateTotal);
            checkOut?.addEventListener("change", updateTotal);
            updateCustomerMode();
            updateTotal();
        });
    </script>
}