@model IEnumerable<QuanLyKhachSan.Models.Booking>
@using QuanLyKhachSan.Enums
@using QuanLyKhachSan.Models
@{
    bool isAdmin = User.IsInRole("Admin");
    bool isReceptionist = User.IsInRole("Receptionist");
    bool isCustomer = User.IsInRole("Customer");
    if (isAdmin)
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
        ViewData["Title"] = "Quản lý Booking";
    }
    else if (isReceptionist)
    {
        Layout = "~/Views/Shared/_ReceptionistLayout.cshtml";
        ViewData["Title"] = "Danh sách Booking";
    }
    else if (isCustomer)
    {
        Layout = "~/Views/Shared/_CustomerLayout.cshtml";
        ViewData["Title"] = "Booking của tôi";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
        ViewData["Title"] = "Danh sách Booking";
    }

    var bookings = Model?.ToList() ?? new List<Booking>();
    var reviewByRoom = ViewBag.ReviewByRoom as IDictionary<int, int> ?? new Dictionary<int, int>();
    int pendingCount = bookings.Count(x => x.Status == BookingStatus.Pending);
    int confirmedCount = bookings.Count(x => x.Status == BookingStatus.Confirmed);
    int checkedInCount = bookings.Count(x => x.Status == BookingStatus.CheckedIn);
    int checkedOutCount = bookings.Count(x => x.Status == BookingStatus.CheckedOut);
    int cancelledCount = bookings.Count(x => x.Status == BookingStatus.Cancelled);
    decimal totalBookingAmount = bookings.Where(x => x.Status != BookingStatus.Cancelled).Sum(x => x.TotalAmount);

    string StatusText(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending => "Chờ xác nhận",
            BookingStatus.Confirmed => "Đã xác nhận",
            BookingStatus.CheckedIn => "Đang lưu trú",
            BookingStatus.CheckedOut => "Đã trả phòng",
            BookingStatus.Cancelled => "Đã hủy",
            _ => status.ToString()
        };
    }

    string StatusBadge(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending => "bg-amber-100 text-amber-800 border-amber-200",
            BookingStatus.Confirmed => "bg-blue-100 text-blue-800 border-blue-200",
            BookingStatus.CheckedIn => "bg-emerald-100 text-emerald-800 border-emerald-200",
            BookingStatus.CheckedOut => "bg-slate-100 text-slate-700 border-slate-200",
            BookingStatus.Cancelled => "bg-rose-100 text-rose-800 border-rose-200",
            _ => "bg-slate-100 text-slate-800 border-slate-200"
        };
    }

    string RoomNumbers(Booking booking)
    {
        if (booking.BookingDetails == null) return "Chưa xếp phòng";
        var roomNumbers = booking.BookingDetails
            .Where(x => !x.IsDeleted && x.Room != null)
            .Select(x => x.Room!.RoomNumber)
            .Distinct()
            .ToList();
        return roomNumbers.Any() ? string.Join(", ", roomNumbers) : "Chưa xếp phòng";
    }

    string CustomerInitial(string? fullName)
    {
        return string.IsNullOrWhiteSpace(fullName) ? "K" : fullName.Trim().Substring(0, 1).ToUpper();
    }
}

<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-2 text-xs font-bold text-secondary uppercase tracking-wider mb-1">
            <span>@(isCustomer ? "Cổng Khách Hàng VIP" : "Quản Lý Vận Hành")</span>
            <span class="text-slate-400">/</span>
            <span class="text-on-surface">Lịch Sử Đặt Phòng</span>
        </div>
        <h1 class="text-2xl lg:text-3xl font-bold text-on-surface font-serif tracking-tight">@(isCustomer ? "Booking Của Tôi" : "Quản Lý Phiếu Đặt Phòng")</h1>
        <p class="text-xs text-slate-500 mt-1">
            @(isCustomer ? "Theo dõi lịch trình nghỉ dưỡng, chi tiết phòng lưu trú và xuất hóa đơn điện tử." : "Giám sát quy trình tiếp đón, xác nhận giữ chỗ và quyết toán buồng phòng.")
        </p>
    </div>
    <div class="flex items-center gap-2">
        @if (isCustomer)
        {
            <a asp-controller="Rooms" asp-action="Search"
               class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-secondary text-white hover:bg-secondary/90 text-xs font-bold shadow-sm transition-all">
                <span class="material-symbols-outlined text-[18px]">search</span>
                <span>Tìm Phòng Trống Mới</span>
            </a>
        }
        else
        {
            <a asp-controller="Bookings" asp-action="CreateForCustomer"
               class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-primary-container text-white text-xs font-bold shadow-sm hover:opacity-90 transition-all">
                <span class="material-symbols-outlined text-[18px] text-secondary-fixed">person_add</span>
                <span>+ Walk-in Đặt Phòng</span>
            </a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="p-3.5 mb-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs flex items-center gap-2">
        <span class="material-symbols-outlined text-[18px]">check_circle</span>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="p-3.5 mb-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center gap-2">
        <span class="material-symbols-outlined text-[18px]">error</span>
        <span>@TempData["Error"]</span>
    </div>
}

<!-- 4 Thẻ Thống Kê Booking -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-[11px] font-bold text-slate-500 uppercase">Tổng Booking</span>
            <div class="text-2xl font-bold text-on-surface mt-1">@bookings.Count</div>
            <span class="text-[10px] text-slate-400">Tất cả hồ sơ lưu trữ</span>
        </div>
        <span class="material-symbols-outlined text-2xl text-blue-500">calendar_month</span>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-[11px] font-bold text-slate-500 uppercase">Chờ Xác Nhận</span>
            <div class="text-2xl font-bold text-amber-600 mt-1">@pendingCount</div>
            <span class="text-[10px] text-slate-400">@confirmedCount đã xác nhận</span>
        </div>
        <span class="material-symbols-outlined text-2xl text-amber-500">hourglass_top</span>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-[11px] font-bold text-slate-500 uppercase">Đang Lưu Trú</span>
            <div class="text-2xl font-bold text-emerald-600 mt-1">@checkedInCount</div>
            <span class="text-[10px] text-slate-400">@checkedOutCount đã trả phòng</span>
        </div>
        <span class="material-symbols-outlined text-2xl text-emerald-500">hotel_class</span>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-[11px] font-bold text-slate-500 uppercase">Tổng Doanh Thu</span>
            <div class="text-xl font-bold text-secondary mt-1">@totalBookingAmount.ToString("N0") <small class="text-xs text-slate-400">đ</small></div>
            <span class="text-[10px] text-slate-400">Hợp lệ (@(bookings.Count - cancelledCount) đơn)</span>
        </div>
        <span class="material-symbols-outlined text-2xl text-purple-500">account_balance_wallet</span>
    </div>
</div>

<!-- Bảng Booking -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div>
            <span class="text-xs font-bold text-secondary uppercase tracking-wider">Hồ sơ đặt phòng</span>
            <h2 class="text-base font-bold text-on-surface">Danh Sách Booking (@bookings.Count)</h2>
        </div>
        <div class="flex items-center gap-2">
            <div class="relative">
                <input type="text" id="bookingSearch" placeholder="Tìm mã booking, phòng, tên khách..."
                       class="h-9 pl-8 pr-3 bg-slate-50 border border-slate-200 text-xs rounded-xl focus:outline-none focus:bg-white focus:border-secondary w-60 transition-all" />
                <span class="material-symbols-outlined text-[16px] text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2">search</span>
            </div>
            <select id="bookingStatusFilter"
                    class="h-9 px-3 bg-slate-50 border border-slate-200 text-xs rounded-xl focus:outline-none focus:bg-white focus:border-secondary transition-all">
                <option value="">Tất cả trạng thái</option>
                <option value="Pending">Chờ xác nhận</option>
                <option value="Confirmed">Đã xác nhận</option>
                <option value="CheckedIn">Đang lưu trú</option>
                <option value="CheckedOut">Đã trả phòng</option>
                <option value="Cancelled">Đã hủy</option>
            </select>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 font-semibold uppercase text-[10px] tracking-wider border-b border-slate-200/60">
                <tr>
                    <th class="py-3 px-4">Mã Booking</th>
                    @if (!isCustomer)
                    {
                        <th class="py-3 px-4">Khách Hàng</th>
                    }
                    <th class="py-3 px-4">Phòng</th>
                    <th class="py-3 px-4">Ngày Đặt</th>
                    <th class="py-3 px-4">Nhận Phòng</th>
                    <th class="py-3 px-4">Trả Phòng</th>
                    <th class="py-3 px-4 text-right">Tiền Cọc</th>
                    <th class="py-3 px-4 text-right">Tổng Tiền</th>
                    <th class="py-3 px-4 text-center">Trạng Thái</th>
                    <th class="py-3 px-4 text-right">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                @if (bookings.Any())
                {
                    foreach (var booking in bookings)
                    {
                        string rooms = RoomNumbers(booking);
                        string customerName = booking.Customer?.FullName ?? "Khách lẻ";
                        string customerPhone = booking.Customer?.Phone ?? "—";
                        string searchData = $"{booking.BookingCode} {rooms} {customerName}".ToLower();

                        <tr class="hover:bg-slate-50/80 transition-colors booking-row"
                            data-status="@booking.Status" data-search="@searchData">
                            <!-- Mã Booking -->
                            <td class="py-3.5 px-4 font-bold text-on-surface">
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-lg bg-amber-50 text-secondary flex items-center justify-center font-bold">
                                        <span class="material-symbols-outlined text-[16px]">receipt</span>
                                    </div>
                                    <div>
                                        <div>@booking.BookingCode</div>
                                        <div class="text-[10px] text-slate-400 font-normal">#@booking.Id</div>
                                    </div>
                                </div>
                            </td>

                            <!-- Khách Hàng -->
                            @if (!isCustomer)
                            {
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2">
                                        <div class="w-6 h-6 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center font-bold text-[10px]">
                                            @CustomerInitial(customerName)
                                        </div>
                                        <div>
                                            <div class="font-semibold text-slate-900">@customerName</div>
                                            <div class="text-[10px] text-slate-400 font-normal">@customerPhone</div>
                                        </div>
                                    </div>
                                </td>
                            }

                            <!-- Phòng -->
                            <td class="py-3.5 px-4">
                                <span class="px-2 py-0.5 rounded-lg bg-slate-100 text-slate-700 font-semibold">
                                    @rooms
                                </span>
                            </td>

                            <!-- Ngày Đặt -->
                            <td class="py-3.5 px-4 text-slate-600">
                                <div>@booking.BookingDate.ToString("dd/MM/yyyy")</div>
                                <div class="text-[10px] text-slate-400">@booking.BookingDate.ToString("HH:mm")</div>
                            </td>

                            <!-- Nhận Phòng -->
                            <td class="py-3.5 px-4 font-semibold text-slate-800">
                                @booking.CheckInDate.ToString("dd/MM/yyyy")
                            </td>

                            <!-- Trả Phòng -->
                            <td class="py-3.5 px-4 font-semibold text-slate-800">
                                @booking.CheckOutDate.ToString("dd/MM/yyyy")
                            </td>

                            <!-- Tiền Cọc -->
                            <td class="py-3.5 px-4 text-right text-slate-600">
                                @booking.Deposit.ToString("N0") <small class="text-slate-400">đ</small>
                            </td>

                            <!-- Tổng Tiền -->
                            <td class="py-3.5 px-4 text-right font-bold text-secondary">
                                @booking.TotalAmount.ToString("N0") <small class="text-slate-400 font-normal">đ</small>
                            </td>

                            <!-- Trạng Thái -->
                            <td class="py-3.5 px-4 text-center">
                                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold border @StatusBadge(booking.Status)">
                                    @StatusText(booking.Status)
                                </span>
                            </td>

                            <!-- Thao Tác -->
                            <td class="py-3.5 px-4 text-right">
                                <div class="flex items-center justify-end gap-1.5 flex-wrap">
                                    <a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id"
                                       class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 transition-colors" title="Xem chi tiết">
                                        <span class="material-symbols-outlined text-[16px]">visibility</span>
                                    </a>

                                    @if (isCustomer && booking.Status == BookingStatus.Pending)
                                    {
                                        <a asp-controller="Bookings" asp-action="Cancel" asp-route-id="@booking.Id"
                                           class="px-2 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 text-[11px] font-bold transition-colors"
                                           onclick="return confirm('Bạn có chắc muốn hủy Booking này?');">
                                            Hủy
                                        </a>
                                    }

                                    @if (isCustomer && booking.Status == BookingStatus.CheckedOut && booking.BookingDetails != null)
                                    {
                                        foreach (var detail in booking.BookingDetails.Where(x => !x.IsDeleted && x.Room != null))
                                        {
                                            if (reviewByRoom.TryGetValue(detail.RoomId, out int reviewId))
                                            {
                                                <a asp-controller="Reviews" asp-action="Edit" asp-route-id="@reviewId"
                                                   class="px-2 py-1 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 text-[11px] font-bold transition-colors">
                                                    Sửa review P.@detail.Room!.RoomNumber
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-controller="Reviews" asp-action="Create" asp-route-bookingId="@booking.Id" asp-route-roomId="@detail.RoomId"
                                                   class="px-2 py-1 rounded-lg bg-secondary/10 hover:bg-secondary/20 text-secondary text-[11px] font-bold transition-colors">
                                                    Đánh giá P.@detail.Room!.RoomNumber
                                                </a>
                                            }
                                        }
                                    }

                                    @if (isAdmin || isReceptionist)
                                    {
                                        <a asp-controller="Bookings" asp-action="Edit" asp-route-id="@booking.Id"
                                           class="p-1.5 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 transition-colors" title="Sửa">
                                            <span class="material-symbols-outlined text-[16px]">edit</span>
                                        </a>

                                        @if (booking.Status == BookingStatus.Pending || booking.Status == BookingStatus.Confirmed)
                                        {
                                            <a asp-controller="Bookings" asp-action="CheckIn" asp-route-id="@booking.Id"
                                               class="px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-bold shadow-xs transition-colors flex items-center gap-1"
                                               onclick="return confirm('Xác nhận Check In Booking này?');">
                                                <span class="material-symbols-outlined text-[14px]">key</span>
                                                <span>Check In</span>
                                            </a>
                                        }

                                        @if (booking.Status == BookingStatus.CheckedIn)
                                        {
                                            <a asp-controller="Bookings" asp-action="CheckOut" asp-route-id="@booking.Id"
                                               class="px-2.5 py-1 rounded-lg bg-primary-container hover:bg-slate-800 text-white text-[11px] font-bold shadow-xs transition-colors flex items-center gap-1">
                                                <span class="material-symbols-outlined text-[14px]">receipt_long</span>
                                                <span>Check Out</span>
                                            </a>
                                        }

                                        @if (isAdmin)
                                        {
                                            <a asp-controller="Bookings" asp-action="Delete" asp-route-id="@booking.Id"
                                               class="p-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 transition-colors" title="Xóa">
                                                <span class="material-symbols-outlined text-[16px]">delete</span>
                                            </a>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(isCustomer ? 9 : 10)" class="text-center py-10 text-slate-400">
                            <span class="material-symbols-outlined text-4xl mb-1 text-slate-300">calendar_month</span>
                            <div>Chưa có Booking nào trong hệ thống</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("bookingSearch");
        const statusFilter = document.getElementById("bookingStatusFilter");
        const rows = document.querySelectorAll(".booking-row");

        function filterRows() {
            const query = (searchInput?.value || "").trim().toLowerCase();
            const status = (statusFilter?.value || "").trim();

            rows.forEach(row => {
                const searchData = row.getAttribute("data-search") || "";
                const statusData = row.getAttribute("data-status") || "";
                const matchesSearch = !query || searchData.includes(query);
                const matchesStatus = !status || statusData === status;

                row.style.display = (matchesSearch && matchesStatus) ? "" : "none";
            });
        }

        searchInput?.addEventListener("input", filterRows);
        statusFilter?.addEventListener("change", filterRows);
    });
</script>