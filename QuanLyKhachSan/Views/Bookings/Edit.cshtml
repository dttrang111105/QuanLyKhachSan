@model QuanLyKhachSan.Models.Booking
@using QuanLyKhachSan.Enums
@{
    bool isAdmin = User.IsInRole("Admin");
    bool isReceptionist = User.IsInRole("Receptionist");
    if (isAdmin)
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (isReceptionist)
    {
        Layout = "~/Views/Shared/_ReceptionistLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    ViewData["Title"] = "Chỉnh sửa Booking - " + Model.BookingCode;
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
                <span class="material-symbols-outlined text-sm">edit_calendar</span>
                <span>Quản lý Đặt phòng</span>
            </div>
            <h1 class="font-serif text-2xl md:text-3xl font-bold text-[#0b1c30] mt-1">
                Chỉnh sửa Booking: @Model.BookingCode
            </h1>
        </div>
        <a asp-controller="Bookings" asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 text-xs font-bold hover:bg-slate-50 transition shadow-sm">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            <span>Danh sách</span>
        </a>
    </div>

    <!-- Edit Form Card -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="p-6 bg-[#0b1c30] text-white flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#c5a880]/20 border border-[#c5a880]/40 flex items-center justify-center text-[#c5a880]">
                    <span class="material-symbols-outlined">edit_document</span>
                </div>
                <div>
                    <h3 class="font-serif font-bold text-lg text-white">Cập nhật thông tin lưu trú</h3>
                    <p class="text-xs text-slate-300">Khách hàng: @(Model.Customer?.FullName ?? "Khách lẻ")</p>
                </div>
            </div>
            <span class="text-xs px-3 py-1 rounded-full bg-white/10 font-mono text-slate-200 border border-white/10">ID: #@Model.Id</span>
        </div>

        <form asp-controller="Bookings" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="p-6 md:p-8 space-y-6">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Mã Booking</label>
                    <input value="@Model.BookingCode" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-500 font-mono text-sm cursor-not-allowed" disabled />
                </div>

                <div>
                    <label asp-for="Status" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Trạng thái xử lý</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<BookingStatus>()" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-800 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-[#725b38]/20 focus:border-[#725b38]"></select>
                    <span asp-validation-for="Status" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="CheckInDate" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Ngày nhận phòng</label>
                    <input asp-for="CheckInDate" type="date" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#725b38]/20 focus:border-[#725b38]" />
                    <span asp-validation-for="CheckInDate" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="CheckOutDate" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Ngày trả phòng</label>
                    <input asp-for="CheckOutDate" type="date" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#725b38]/20 focus:border-[#725b38]" />
                    <span asp-validation-for="CheckOutDate" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Adult" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Số người lớn</label>
                    <input asp-for="Adult" type="number" min="1" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#725b38]/20 focus:border-[#725b38]" />
                    <span asp-validation-for="Adult" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Children" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Số trẻ em</label>
                    <input asp-for="Children" type="number" min="0" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#725b38]/20 focus:border-[#725b38]" />
                    <span asp-validation-for="Children" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Deposit" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Tiền cọc (VNĐ)</label>
                    <input asp-for="Deposit" type="number" min="0" step="1000" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-800 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-[#725b38]/20 focus:border-[#725b38]" />
                    <span asp-validation-for="Deposit" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Tổng tiền dự kiến</label>
                    <div class="w-full px-4 py-3 rounded-xl border border-[#725b38]/30 bg-[#725b38]/5 text-[#0b1c30] font-bold font-serif text-base">
                        @Model.TotalAmount.ToString("N0") VNĐ
                    </div>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Note" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Ghi chú yêu cầu của khách</label>
                    <textarea asp-for="Note" rows="3" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#725b38]/20 focus:border-[#725b38]" placeholder="Nhập ghi chú đặc biệt cho booking..."></textarea>
                    <span asp-validation-for="Note" class="text-red-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-100">
                <a asp-controller="Bookings" asp-action="Index" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-xs font-bold hover:bg-slate-50 transition">
                    Hủy bỏ
                </a>
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-gradient-to-r from-[#c5a880] to-[#725b38] text-white text-xs font-bold shadow-md hover:shadow-lg transition">
                    <span class="material-symbols-outlined text-sm">save</span>
                    <span>Lưu thay đổi</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
