@model IEnumerable<QuanLyKhachSan.Models.Account>
@using QuanLyKhachSan.Models
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý tài khoản hệ thống";

    List<Account> accounts = Model?.ToList() ?? new List<Account>();
    int totalAccounts = accounts.Count;
    int activeAccounts = accounts.Count(a => a.IsActive);
    int inactiveAccounts = accounts.Count(a => !a.IsActive);
    int adminAccounts = accounts.Count(a => string.Equals(Convert.ToString(a.Role), "Admin", StringComparison.OrdinalIgnoreCase));
    int receptionistAccounts = accounts.Count(a => string.Equals(Convert.ToString(a.Role), "Receptionist", StringComparison.OrdinalIgnoreCase));
    int customerAccounts = accounts.Count(a => string.Equals(Convert.ToString(a.Role), "Customer", StringComparison.OrdinalIgnoreCase));

    string RoleText(object? role)
    {
        string value = Convert.ToString(role)?.Trim() ?? string.Empty;
        return value.ToLowerInvariant() switch
        {
            "admin" => "Quản trị viên",
            "receptionist" => "Lễ tân",
            "customer" => "Khách hàng",
            _ => string.IsNullOrWhiteSpace(value) ? "Chưa xác định" : value
        };
    }

    string RoleBadge(object? role)
    {
        string value = Convert.ToString(role)?.Trim().ToLowerInvariant() ?? string.Empty;
        return value switch
        {
            "admin" => "bg-rose-50 text-rose-700 border-rose-200",
            "receptionist" => "bg-amber-50 text-amber-800 border-amber-200",
            "customer" => "bg-blue-50 text-blue-700 border-blue-200",
            _ => "bg-surface-container text-on-surface border-outline-variant"
        };
    }

    string AccountInitial(string? username) => string.IsNullOrWhiteSpace(username) ? "A" : username.Trim().Substring(0, 1).ToUpperInvariant();

    string ProfileName(Account account)
    {
        if (account.Employee != null && !string.IsNullOrWhiteSpace(account.Employee.FullName)) return account.Employee.FullName;
        if (account.Customer != null && !string.IsNullOrWhiteSpace(account.Customer.FullName)) return account.Customer.FullName;
        return "Chưa liên kết";
    }
}

<div class="space-y-6">
    <!-- Header -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-[#725b38] uppercase">
                <span class="material-symbols-outlined text-[16px]">manage_accounts</span>
                <span>Bảo mật &amp; Phân quyền</span>
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-on-surface mt-1">Tài Khoản Hệ Thống</h1>
            <p class="text-xs text-on-surface-variant mt-1">
                Cấp phát tài khoản người dùng, phân quyền truy cập và kiểm soát an toàn bảo mật website.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-action="Create"
               class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-primary text-white hover:bg-on-background text-xs font-bold shadow-sm transition-all no-underline">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                <span>+ Thêm Tài Khoản</span>
            </a>
        </div>
    </header>

    <!-- 4 KPI Metrics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Tổng tài khoản</span>
                <div class="text-2xl font-bold text-on-surface mt-1">@totalAccounts</div>
                <span class="text-[11px] text-on-surface-variant font-medium">Toàn bộ tài khoản cấp phát</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">manage_accounts</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Đang hoạt động</span>
                <div class="text-2xl font-bold text-emerald-600 mt-1">@activeAccounts</div>
                <span class="text-[11px] text-emerald-700 font-semibold">@inactiveAccounts tài khoản bị khóa</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">check_circle</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Lễ tân &amp; Admin</span>
                <div class="text-2xl font-bold text-secondary mt-1">@(adminAccounts + receptionistAccounts)</div>
                <span class="text-[11px] text-on-surface-variant font-medium">@adminAccounts Admin • @receptionistAccounts Lễ tân</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-secondary-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">shield_person</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-outline-variant/60 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-outline uppercase tracking-wider">Khách hàng VIP</span>
                <div class="text-2xl font-bold text-blue-600 mt-1">@customerAccounts</div>
                <span class="text-[11px] text-on-surface-variant font-medium">Tài khoản hội viên portal</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-surface-container text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">group</span>
            </div>
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm overflow-hidden">
        <!-- Table Toolbar -->
        <div class="p-4 sm:p-5 border-b border-outline-variant/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <span class="text-xs font-bold text-secondary uppercase tracking-wider">Cơ sở dữ liệu người dùng</span>
                <h2 class="text-base font-bold text-on-surface">Danh Sách Tài Khoản (@totalAccounts)</h2>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <div class="relative">
                    <input type="text" id="accSearch" placeholder="Tìm tên đăng nhập, email, chủ tài khoản..."
                           class="h-9 pl-8 pr-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary w-56 sm:w-64 transition-all" />
                    <span class="material-symbols-outlined text-[16px] text-outline absolute left-2.5 top-1/2 -translate-y-1/2">search</span>
                </div>
                <select id="roleFilter"
                        class="h-9 px-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary transition-all">
                    <option value="">Tất cả vai trò</option>
                    <option value="admin">Quản trị viên (Admin)</option>
                    <option value="receptionist">Lễ tân (Receptionist)</option>
                    <option value="customer">Khách hàng (Customer)</option>
                </select>
                <select id="activeFilter"
                        class="h-9 px-3 bg-surface-container-low border border-outline-variant text-xs rounded-xl focus:outline-none focus:bg-surface-container-lowest focus:border-secondary transition-all">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active">Đang hoạt động</option>
                    <option value="inactive">Đã vô hiệu hóa</option>
                </select>
            </div>
        </div>

        @if (accounts.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-surface-container-low text-on-surface-variant font-semibold uppercase text-[10px] tracking-wider border-b border-outline-variant/40">
                        <tr>
                            <th class="py-3 px-4">Tài Khoản</th>
                            <th class="py-3 px-4">Chủ Hồ Sơ</th>
                            <th class="py-3 px-4">Email</th>
                            <th class="py-3 px-4 text-center">Vai Trò</th>
                            <th class="py-3 px-4 text-center">Trạng Thái</th>
                            <th class="py-3 px-4 text-right">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/30 text-on-surface font-medium">
                        @foreach (var acc in accounts)
                        {
                            string roleKey = Convert.ToString(acc.Role)?.Trim().ToLowerInvariant() ?? "";
                            string statusKey = acc.IsActive ? "active" : "inactive";
                            string profileName = ProfileName(acc);
                            string searchStr = $"{acc.Username} {acc.Email} {profileName} {roleKey}".ToLower();

                            <tr class="hover:bg-surface-container-low/60 transition-colors acc-row"
                                data-role="@roleKey" data-status="@statusKey" data-search="@searchStr">
                                <td class="py-3.5 px-4 font-bold text-on-surface">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-surface-container text-secondary flex items-center justify-center font-bold text-xs shrink-0">
                                            @AccountInitial(acc.Username)
                                        </div>
                                        <div>
                                            <div class="font-bold text-on-surface text-sm">@acc.Username</div>
                                            <div class="text-[10px] text-outline font-normal">Mã #@acc.Id</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="py-3.5 px-4 font-semibold text-on-surface">
                                    @profileName
                                </td>

                                <td class="py-3.5 px-4 text-on-surface-variant">
                                    @(string.IsNullOrWhiteSpace(acc.Email) ? "—" : acc.Email)
                                </td>

                                <td class="py-3.5 px-4 text-center">
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold border @RoleBadge(acc.Role)">
                                        @RoleText(acc.Role)
                                    </span>
                                </td>

                                <td class="py-3.5 px-4 text-center">
                                    @if (acc.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Bị khóa
                                        </span>
                                    }
                                </td>

                                <td class="py-3.5 px-4 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@acc.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-secondary hover:bg-surface-container transition-colors"
                                           title="Xem chi tiết">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@acc.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-amber-600 hover:bg-amber-50 transition-colors"
                                           title="Chỉnh sửa">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@acc.Id"
                                           class="p-1.5 rounded-lg text-on-surface-variant hover:text-rose-600 hover:bg-rose-50 transition-colors"
                                           title="Xóa tài khoản">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-12 text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-4xl text-outline mb-2">manage_accounts</span>
                <p class="text-sm font-semibold">Chưa có tài khoản nào trong hệ thống</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('accSearch');
            const roleFilter = document.getElementById('roleFilter');
            const activeFilter = document.getElementById('activeFilter');
            const rows = document.querySelectorAll('.acc-row');

            function filterTable() {
                const query = (searchInput?.value || '').toLowerCase().trim();
                const selectedRole = (roleFilter?.value || '').toLowerCase().trim();
                const selectedActive = (activeFilter?.value || '').toLowerCase().trim();

                rows.forEach(row => {
                    const rowSearch = (row.getAttribute('data-search') || '').toLowerCase();
                    const rowRole = (row.getAttribute('data-role') || '').toLowerCase();
                    const rowStat = (row.getAttribute('data-status') || '').toLowerCase();

                    const matchesQuery = !query || rowSearch.includes(query);
                    const matchesRole = !selectedRole || rowRole === selectedRole;
                    const matchesStat = !selectedActive || rowStat === selectedActive;

                    row.style.display = (matchesQuery && matchesRole && matchesStat) ? '' : 'none';
                });
            }

            if (searchInput) searchInput.addEventListener('input', filterTable);
            if (roleFilter) roleFilter.addEventListener('change', filterTable);
            if (activeFilter) activeFilter.addEventListener('change', filterTable);
        });
    </script>
}