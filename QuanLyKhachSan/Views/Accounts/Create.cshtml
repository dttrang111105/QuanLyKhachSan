@model QuanLyKhachSan.Models.Account
@using QuanLyKhachSan.Enums
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm tài khoản";
}

<div class="max-w-3xl mx-auto space-y-6">
    <!-- Top Action / Breadcrumb -->
    <div class="flex items-center justify-between">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-[#0b1c30] transition-colors">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            Quay lại danh sách tài khoản
        </a>
    </div>

    <!-- Main Card -->
    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden">
        <!-- Header -->
        <div class="bg-gradient-to-r from-[#0b1c30] to-[#1e293b] p-8 text-white relative overflow-hidden">
            <div class="absolute -right-8 -bottom-8 opacity-10">
                <span class="material-symbols-outlined text-[160px]">person_add</span>
            </div>
            <div class="relative z-10">
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-[#c5a880]/20 text-[#c5a880] border border-[#c5a880]/30 uppercase tracking-widest inline-block mb-3">
                    Tài khoản người dùng
                </span>
                <h1 class="font-serif text-2xl lg:text-3xl font-bold tracking-tight">Thêm Tài Khoản Mới</h1>
                <p class="text-slate-300 text-sm mt-1">Khởi tạo thông tin đăng nhập và phân quyền hệ thống</p>
            </div>
        </div>

        <!-- Form Body -->
        <div class="p-8 lg:p-10">
            <form asp-controller="Accounts" asp-action="Create" method="post" class="space-y-6">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm"></div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <!-- Username -->
                    <div>
                        <label asp-for="Username" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Tên đăng nhập <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <input asp-for="Username" placeholder="Ví dụ: recep02, letan01" autocomplete="off" class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">person</span>
                        </div>
                        <span asp-validation-for="Username" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Password -->
                    <div>
                        <label asp-for="PasswordHash" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Mật khẩu <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <input asp-for="PasswordHash" type="password" id="passwordInput" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" class="w-full pl-11 pr-12 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">lock</span>
                            <button type="button" class="password-toggle absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1" data-target="passwordInput" aria-label="Hiện hoặc ẩn mật khẩu">
                                <span class="material-symbols-outlined text-lg">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="PasswordHash" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Email -->
                    <div>
                        <label asp-for="Email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Email <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <input asp-for="Email" type="email" placeholder="example@grandstay.com" autocomplete="off" class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">mail</span>
                        </div>
                        <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Phone -->
                    <div>
                        <label asp-for="PhoneNumber" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Số điện thoại</label>
                        <div class="relative">
                            <input asp-for="PhoneNumber" placeholder="09xxxxxxxx" autocomplete="off" class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">call</span>
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Role -->
                    <div class="sm:col-span-2">
                        <label asp-for="Role" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Vai trò hệ thống <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRole>()" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium appearance-none">
                                <option value="">-- Chọn vai trò --</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">expand_more</span>
                        </div>
                        <span asp-validation-for="Role" class="text-xs text-rose-500 mt-1 block"></span>

                        <!-- Role Help Descriptions -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-3">
                            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 text-xs">
                                <span class="font-bold text-rose-600 block mb-1">Admin</span>
                                <p class="text-slate-500 text-[11px]">Toàn quyền quản trị nhân sự, giá phòng, báo cáo và hệ thống.</p>
                            </div>
                            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 text-xs">
                                <span class="font-bold text-amber-700 block mb-1">Receptionist</span>
                                <p class="text-slate-500 text-[11px]">Quản lý Booking, Check-in/out, minibar, dịch vụ và hóa đơn.</p>
                            </div>
                            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 text-xs">
                                <span class="font-bold text-blue-600 block mb-1">Customer</span>
                                <p class="text-slate-500 text-[11px]">Khách hàng đặt phòng trực tuyến, theo dõi hóa đơn và đánh giá.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action buttons -->
                <div class="pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
                    <a asp-action="Index" class="px-6 py-3 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                        Hủy
                    </a>
                    <button type="submit" class="px-7 py-3 rounded-xl bg-gradient-to-r from-[#c5a880] to-[#725b38] hover:from-[#b9986b] hover:to-[#634e2f] text-white text-sm font-semibold shadow-lg shadow-[#c5a880]/20 transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg">check_circle</span>
                        Tạo tài khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".password-toggle").forEach(function (button) {
                button.addEventListener("click", function () {
                    const input = document.getElementById(button.dataset.target);
                    if (!input) return;
                    const showPassword = input.type === "password";
                    input.type = showPassword ? "text" : "password";
                    const icon = button.querySelector("span");
                    if (icon) {
                        icon.textContent = showPassword ? "visibility_off" : "visibility";
                    }
                });
            });
        });
    </script>
}