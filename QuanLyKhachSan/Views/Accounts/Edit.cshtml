@model QuanLyKhachSan.Models.Account
@using QuanLyKhachSan.Enums
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa tài khoản";
}

<div class="max-w-5xl mx-auto space-y-6">
    <!-- Top Action / Breadcrumb -->
    <div class="flex items-center justify-between">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-[#0b1c30] transition-colors">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            Quay lại danh sách tài khoản
        </a>
        <a asp-action="Details" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-semibold transition-colors">
            <span class="material-symbols-outlined text-base">visibility</span>
            Xem chi tiết
        </a>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left: Edit Form (8 cols) -->
        <div class="lg:col-span-8">
            <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden">
                <!-- Header -->
                <div class="bg-gradient-to-r from-[#0b1c30] to-[#1e293b] p-8 text-white relative overflow-hidden">
                    <div class="absolute -right-8 -bottom-8 opacity-10">
                        <span class="material-symbols-outlined text-[160px]">manage_accounts</span>
                    </div>
                    <div class="relative z-10">
                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-[#c5a880]/20 text-[#c5a880] border border-[#c5a880]/30 uppercase tracking-widest inline-block mb-3">
                            Tài khoản #@Model.Id
                        </span>
                        <h1 class="font-serif text-2xl lg:text-3xl font-bold tracking-tight">Chỉnh Sửa Tài Khoản</h1>
                        <p class="text-slate-300 text-sm mt-1">@Model.Username • Để trống mật khẩu mới nếu không muốn thay đổi</p>
                    </div>
                </div>

                <!-- Form Body -->
                <div class="p-8 lg:p-10">
                    <form asp-controller="Accounts" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-6">
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm"></div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <!-- Username -->
                            <div>
                                <label asp-for="Username" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Tên đăng nhập <span class="text-rose-500">*</span></label>
                                <div class="relative">
                                    <input asp-for="Username" autocomplete="off" class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">person</span>
                                </div>
                                <span asp-validation-for="Username" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>

                            <!-- New Password -->
                            <div>
                                <label for="PasswordHash" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Mật khẩu mới</label>
                                <div class="relative">
                                    <input type="password" id="PasswordHash" name="PasswordHash" placeholder="Để trống nếu giữ nguyên" autocomplete="new-password" class="w-full pl-11 pr-12 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">lock</span>
                                    <button type="button" class="password-toggle absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1" data-target="PasswordHash" aria-label="Hiện hoặc ẩn mật khẩu">
                                        <span class="material-symbols-outlined text-lg">visibility</span>
                                    </button>
                                </div>
                                <span asp-validation-for="PasswordHash" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>

                            <!-- Email -->
                            <div>
                                <label asp-for="Email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Email <span class="text-rose-500">*</span></label>
                                <div class="relative">
                                    <input asp-for="Email" type="email" autocomplete="off" class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">mail</span>
                                </div>
                                <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>

                            <!-- Phone -->
                            <div>
                                <label asp-for="PhoneNumber" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Số điện thoại</label>
                                <div class="relative">
                                    <input asp-for="PhoneNumber" autocomplete="off" class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium" />
                                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">call</span>
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>

                            <!-- Role -->
                            <div>
                                <label asp-for="Role" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Vai trò <span class="text-rose-500">*</span></label>
                                <div class="relative">
                                    <select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRole>()" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#c5a880] text-sm text-slate-800 bg-slate-50/50 transition-all font-medium appearance-none"></select>
                                    <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">expand_more</span>
                                </div>
                                <span asp-validation-for="Role" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>

                            <!-- Status Switch -->
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Trạng thái tài khoản</label>
                                <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 bg-slate-50/50 cursor-pointer">
                                    <input asp-for="IsActive" type="checkbox" class="w-4 h-4 rounded text-[#725b38] focus:ring-[#c5a880]" />
                                    <div>
                                        <span class="text-sm font-semibold text-slate-800 block">Kích hoạt tài khoản</span>
                                        <span class="text-[11px] text-slate-400">Tắt tùy chọn này để tạm khóa đăng nhập</span>
                                    </div>
                                </label>
                                <span asp-validation-for="IsActive" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>
                        </div>

                        <!-- Action buttons -->
                        <div class="pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
                            <a asp-action="Index" class="px-6 py-3 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                                Hủy
                            </a>
                            <button type="submit" class="px-7 py-3 rounded-xl bg-gradient-to-r from-[#c5a880] to-[#725b38] hover:from-[#b9986b] hover:to-[#634e2f] text-white text-sm font-semibold shadow-lg shadow-[#c5a880]/20 transition-all flex items-center gap-2">
                                <span class="material-symbols-outlined text-lg">save</span>
                                Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right: Meta Information Card (4 cols) -->
        <div class="lg:col-span-4 space-y-6">
            <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm space-y-4">
                <h3 class="font-serif text-base font-bold text-slate-900 flex items-center gap-2">
                    <span class="material-symbols-outlined text-amber-600 text-xl">info</span>
                    Thông tin hệ thống
                </h3>

                <div class="space-y-3 divide-y divide-slate-100 text-xs">
                    <div class="pt-2 flex justify-between">
                        <span class="text-slate-400">Mã định danh:</span>
                        <strong class="text-slate-800">#@Model.Id</strong>
                    </div>
                    <div class="pt-3 flex justify-between">
                        <span class="text-slate-400">Ngày tạo:</span>
                        <strong class="text-slate-800">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                    <div class="pt-3 flex justify-between">
                        <span class="text-slate-400">Cập nhật:</span>
                        <strong class="text-slate-800">@(Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")</strong>
                    </div>
                    <div class="pt-3 flex justify-between">
                        <span class="text-slate-400">Đăng nhập cuối:</span>
                        <strong class="text-slate-800">@(Model.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")</strong>
                    </div>
                </div>

                <div class="p-4 rounded-2xl bg-amber-50/60 border border-amber-200/60 text-[11px] text-amber-900 flex items-start gap-2.5">
                    <span class="material-symbols-outlined text-amber-600 text-base shrink-0 mt-0.5">security</span>
                    <p class="leading-relaxed">
                        Mật khẩu được mã hóa an toàn bằng thuật toán băm (BCrypt/PBKDF2). Hệ thống không lưu trữ mật khẩu ở dạng văn bản thuần.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".password-toggle").forEach(function (button) {
                button.addEventListener("click", function () {
                    const input = document.getElementById(button.dataset.target);
                    if (!input) return;
                    const showPassword = input.type === "password";
                    input.type = showPassword ? "text" : "password";
                    const icon = button.querySelector("span");
                    if (icon) {
                        icon.textContent = showPassword ? "visibility_off" : "visibility";
                    }
                });
            });
        });
    </script>
}