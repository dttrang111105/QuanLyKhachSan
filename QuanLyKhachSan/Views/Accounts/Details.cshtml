@model QuanLyKhachSan.Models.Account
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết tài khoản";
    string ownerName = Model.Employee?.FullName ?? Model.Customer?.FullName ?? "Chưa liên kết hồ sơ";
    string ownerType = Model.Employee != null ? "Nhân viên" : Model.Customer != null ? "Khách hàng" : "Chưa liên kết";
}

<div class="space-y-6">
    <!-- Top Action / Breadcrumb -->
    <div class="flex items-center justify-between">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-[#0b1c30] transition-colors">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            Quay lại danh sách tài khoản
        </a>
        <div class="flex items-center gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-amber-50 text-amber-700 hover:bg-amber-100 font-semibold text-sm transition-colors">
                <span class="material-symbols-outlined text-base">edit</span>
                Chỉnh sửa
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-rose-50 text-rose-600 hover:bg-rose-100 font-semibold text-sm transition-colors">
                <span class="material-symbols-outlined text-base">delete</span>
                Xóa tài khoản
            </a>
        </div>
    </div>

    <!-- Main Profile Card -->
    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden">
        <!-- Banner Header -->
        <div class="bg-gradient-to-r from-[#0b1c30] via-[#131b2e] to-[#20293a] p-8 lg:p-10 text-white relative overflow-hidden">
            <div class="absolute -right-10 -bottom-10 opacity-10">
                <span class="material-symbols-outlined text-[200px]">manage_accounts</span>
            </div>
            <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="flex items-center gap-6">
                    <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-[#c5a880] to-[#725b38] text-white flex items-center justify-center font-serif text-3xl font-bold border-2 border-white/20 shadow-lg">
                        @Model.Username.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <div class="flex items-center gap-3">
                            <h1 class="font-serif text-2xl lg:text-3xl font-bold tracking-tight text-white">@Model.Username</h1>
                            @if (Model.IsActive)
                            {
                                <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 uppercase tracking-wider">
                                    Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="px-3 py-1 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30 uppercase tracking-wider">
                                    Đã khóa
                                </span>
                            }
                        </div>
                        <p class="text-slate-400 text-sm mt-1">
                            Mã tài khoản: #@Model.Id • Chủ sở hữu: <strong class="text-slate-200">@ownerName</strong> (@ownerType)
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Information Detail Grid -->
        <div class="p-8 lg:p-10">
            <h2 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-6 flex items-center gap-2">
                <span class="material-symbols-outlined text-base">info</span>
                Chi tiết xác thực & bảo mật
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Role -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">shield_person</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Vai trò</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@Model.Role</span>
                    </div>
                </div>

                <!-- Email -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">mail</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Email</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block truncate max-w-[200px]" title="@Model.Email">@(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa cập nhật" : Model.Email)</span>
                    </div>
                </div>

                <!-- Phone -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">call</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Số điện thoại</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</span>
                    </div>
                </div>

                <!-- Last Login -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">login</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Đăng nhập cuối</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@(Model.LastLogin.HasValue ? Model.LastLogin.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa đăng nhập")</span>
                    </div>
                </div>

                <!-- Created At -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-slate-200/70 text-slate-700 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">history</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Ngày tạo</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>

                <!-- Updated At -->
                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-100 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-slate-200/70 text-slate-700 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">update</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Lần cập nhật</span>
                        <span class="text-sm font-bold text-slate-900 mt-0.5 block">@(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa cập nhật")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
